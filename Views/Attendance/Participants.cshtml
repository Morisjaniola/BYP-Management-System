@model List<BYPManagementSystem.ViewModels.ParticipantAttendanceRowViewModel>

@using BYPManagementSystem.Services

@{
    ViewData["Title"] = "View Participants";

    var program = ViewBag.Program as BYPManagementSystem.Models.YouthProgram;

    var rows = Model ?? new List<BYPManagementSystem.ViewModels.ParticipantAttendanceRowViewModel>();

    var search = ViewBag.Search as string;

    var statusFilter = ViewBag.StatusFilter as string ?? "All";

    var statusOptions =
        ViewBag.StatusOptions as List<(string Value, string Label, int Count)>
        ?? new List<(string Value, string Label, int Count)>();

    var attendanceDate = (DateTime)(ViewBag.AttendanceDate ?? AttendanceSchedule.NowApp().Date);

    var dateStr = attendanceDate.ToString("yyyy-MM-dd");

    var page = (int)(ViewBag.Page ?? 1);

    var totalPages = (int)(ViewBag.TotalPages ?? 1);

    var totalCount = (int)(ViewBag.TotalCount ?? rows.Count);


    // Renders one attendance-action cell: an approved time, a
    // Pending Review badge, a Rejected badge, or a dash.

    Func<BYPManagementSystem.ViewModels.AttendanceActionCellViewModel, Microsoft.AspNetCore.Html.IHtmlContent> renderCell = cell =>
    {
        switch (cell.Kind)
        {
            case "Approved":
                return Html.Raw($"<span class=\"cell-time\">{cell.TimeDisplay}</span>");

            case "Pending":
                return Html.Raw("<span class=\"cell-badge pending\"><i class=\"bi bi-hourglass-split\"></i>Pending Review</span>");

            case "Rejected":
                return Html.Raw("<span class=\"cell-badge rejected\"><i class=\"bi bi-x-circle\"></i>Rejected</span>");

            default:
                return Html.Raw("<span class=\"cell-dash\">&mdash;</span>");
        }
    };
}


<div class="attendance-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <section class="form-header">

        <div class="form-header-icon">
            <i class="bi bi-people-fill"></i>
        </div>

        <div class="form-header-content">

            <span class="form-header-kicker">
                ATTENDANCE MONITORING
            </span>

            <h1>
                @(program?.Name ?? "Program Participants")
            </h1>

            <p>
                Review Morning and Afternoon attendance for every
                approved participant of this program.
            </p>

        </div>

    </section>


    <!-- =========================================================
         PROGRAM BANNER
         ========================================================= -->

    <div class="program-banner">

        <div class="program-banner-icon">
            <i class="bi bi-calendar-check"></i>
        </div>

        <div class="program-banner-main">

            <span class="banner-eyebrow">
                SELECTED PROGRAM
            </span>

            <h2>
                @(program?.Name ?? "Unknown Program")
            </h2>

            <div class="program-meta">

                <span>
                    <i class="bi bi-calendar-day"></i>
                    @attendanceDate.ToString("MMM dd, yyyy")
                </span>

                @if (program != null)
                {
                    <span>
                        <i class="bi bi-alarm"></i>
                        @AttendanceSchedule.WindowsText(program)
                    </span>
                }

                <span>
                    <i class="bi bi-geo-alt"></i>
                    @(program?.Barangay ?? "No barangay")
                </span>

                <span>
                    <i class="bi bi-people"></i>
                    Capacity: @(program?.Capacity ?? 0)
                </span>

            </div>

        </div>

        <div class="program-status">
            @if (program?.Status == "Active")
            {
                <span class="status-badge active">
                    <span class="status-dot"></span>
                    Active
                </span>
            }
            else
            {
                <span class="status-badge inactive">
                    <span class="status-dot"></span>
                    @(program?.Status ?? "Unknown")
                </span>
            }
        </div>

    </div>


    <!-- =========================================================
         INFO
         ========================================================= -->

    <div class="info-box">

        <div class="info-box-icon">
            <i class="bi bi-info-circle"></i>
        </div>

        <div class="info-box-content">

            <strong>
                Every approved participant is listed, including
                participants without an attendance photo.
            </strong>

            <p>
                A time appears only after a photo is approved.
                Submitted photos show Pending Review and are never
                counted as Absent while waiting for staff review.
            </p>

        </div>

    </div>


    <!-- =========================================================
         FILTERS
         ========================================================= -->

    <section class="dashboard-panel">

        <form asp-action="Participants"
              method="get"
              class="filter-bar">

            <input type="hidden" name="id" value="@(program?.Id)" />

            <div class="filter-field">
                <label for="attendanceDate">Attendance Date</label>
                <input type="date"
                       id="attendanceDate"
                       name="attendanceDate"
                       value="@dateStr" />
            </div>

            <div class="filter-field grow">
                <label for="search">Search</label>
                <input type="text"
                       id="search"
                       name="search"
                       value="@search"
                       placeholder="Participant name or barangay" />
            </div>

            <div class="filter-field">
                <label for="status">Status</label>
                <select id="status" name="status">
                    <option value="All"
                            selected="@(statusFilter == "All" ? "selected" : null)">
                        All Statuses (@totalCount)
                    </option>
                    @foreach (var option in statusOptions)
                    {
                        <option value="@option.Value"
                                selected="@(statusFilter == option.Value ? "selected" : null)">
                            @option.Label (@option.Count)
                        </option>
                    }
                </select>
            </div>

            <div class="filter-actions">

                <button type="submit" class="filter-apply">
                    <i class="bi bi-funnel"></i>
                    Apply
                </button>

                <a asp-action="Participants"
                   asp-route-id="@(program?.Id)"
                   class="filter-reset">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Reset
                </a>

            </div>

        </form>

    </section>


    <!-- =========================================================
         MAIN TABLE
         #, PARTICIPANT NAME, MORNING IN, MORNING OUT,
         AFTERNOON IN, AFTERNOON OUT, STATUS, ACTION
         ========================================================= -->

    <section class="dashboard-panel">

        <div class="panel-header">

            <div>

                <span class="panel-eyebrow">
                    APPROVED PARTICIPANTS
                </span>

                <h2>
                    Participant Attendance
                </h2>

                <p>
                    Attendance status for @attendanceDate.ToString("MMMM dd, yyyy")
                    (@AttendanceSchedule.ZoneLabel).
                </p>

            </div>

            <div class="participant-count">
                <i class="bi bi-people"></i>
                @totalCount participant@(totalCount == 1 ? "" : "s")
            </div>

        </div>


        @if (rows.Any())
        {
            <div class="table-scroll">

                <table class="attendance-table">

                    <thead>

                        <tr>

                            <th class="col-num">#</th>

                            <th class="col-name">Participant Name</th>

                            <th>Morning Time In</th>

                            <th>Morning Time Out</th>

                            <th>Afternoon Time In</th>

                            <th>Afternoon Time Out</th>

                            <th>Status</th>

                            <th class="col-action">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var row in rows)
                        {
                            <tr>

                                <td class="col-num">
                                    @row.RowNumber
                                </td>

                                <td class="col-name">

                                    <span class="row-name">
                                        @row.FullName
                                    </span>

                                    <span class="row-sub">
                                        @(string.IsNullOrWhiteSpace(row.Barangay) ? "No barangay" : row.Barangay)
                                        &middot; Participant #@row.YouthParticipantId
                                    </span>

                                </td>

                                <td>@renderCell(row.MorningIn)</td>

                                <td>@renderCell(row.MorningOut)</td>

                                <td>@renderCell(row.AfternoonIn)</td>

                                <td>@renderCell(row.AfternoonOut)</td>

                                <td>

                                    <span class="st-badge @row.StatusCss">
                                        <span class="st-dot"></span>
                                        @row.StatusLabel
                                    </span>

                                </td>

                                <td class="col-action">

                                    <a class="row-view"
                                       asp-controller="Attendance"
                                       asp-action="Records"
                                       asp-route-programId="@(program?.Id)"
                                       asp-route-youthParticipantId="@row.YouthParticipantId"
                                       asp-route-attendanceDate="@dateStr"
                                       title="View attendance details">

                                        <i class="bi bi-eye"></i>
                                        View

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =========================================================
                 STATUS LEGEND (TEXT + COLOR, NEVER COLOR ALONE)
                 ========================================================= -->

            <div class="status-legend">

                <span class="legend-title">Status guide:</span>

                <span class="st-badge st-present"><span class="st-dot"></span>Present</span>

                <span class="st-badge st-pending"><span class="st-dot"></span>Pending Review</span>

                <span class="st-badge st-incomplete"><span class="st-dot"></span>Incomplete</span>

                <span class="st-badge st-rejected"><span class="st-dot"></span>Rejected</span>

                <span class="st-badge st-absent"><span class="st-dot"></span>Absent</span>

                <span class="st-badge st-notyetdue"><span class="st-dot"></span>Not Yet Due</span>

            </div>


            <!-- =========================================================
                 PAGINATION
                 ========================================================= -->

            @if (totalPages > 1)
            {
                <div class="pager">

                    @if (page > 1)
                    {
                        <a class="page-link"
                           href="@(Url.Action("Participants", "Attendance", new { id = program?.Id, search, status = statusFilter, attendanceDate = dateStr, page = page - 1 }))">
                            <i class="bi bi-chevron-left"></i>
                            Previous
                        </a>
                    }
                    else
                    {
                        <span class="page-link disabled">
                            <i class="bi bi-chevron-left"></i>
                            Previous
                        </span>
                    }

                    <span class="page-info">
                        @($"Page {page} of {totalPages}")
                    </span>

                    @if (page < totalPages)
                    {
                        <a class="page-link"
                           href="@(Url.Action("Participants", "Attendance", new { id = program?.Id, search, status = statusFilter, attendanceDate = dateStr, page = page + 1 }))">
                            Next
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="page-link disabled">
                            Next
                            <i class="bi bi-chevron-right"></i>
                        </span>
                    }

                </div>
            }
        }
        else
        {
            <div class="empty-state">

                <i class="bi bi-person-x"></i>

                <span>
                    @(totalCount == 0 && string.IsNullOrWhiteSpace(search) && statusFilter == "All"
                        ? "No approved participants."
                        : "No participants match the current filters.")
                </span>

                @if (!(string.IsNullOrWhiteSpace(search) && statusFilter == "All"))
                {
                    <a asp-action="Participants"
                       asp-route-id="@(program?.Id)"
                       class="empty-button">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        Clear Filters
                    </a>
                }
                else
                {
                    <a asp-controller="Attendance"
                       asp-action="Index"
                       class="empty-button">
                        <i class="bi bi-arrow-left"></i>
                        Back to Attendance
                    </a>
                }

            </div>
        }

    </section>


    <!-- =========================================================
         BOTTOM ACTIONS
         ========================================================= -->

    <div class="bottom-actions">

        <a asp-controller="Attendance" asp-action="Index" class="bottom-button secondary">
            <i class="bi bi-arrow-left"></i> Back to Attendance
        </a>

        <a asp-controller="Attendance" asp-action="PhotoReviews" class="bottom-button primary">
            <i class="bi bi-images"></i> Photo Review Queue
        </a>

    </div>

</div>


<style>

/* =========================================================
   COMPACT STAFF ATTENDANCE - Matches Admin Dashboard
   ========================================================= */

.attendance-page {
    width: 100%;
    padding: 12px 18px 18px;
    font-family: Arial, Helvetica, sans-serif;
    color: #FFFFFF;
    background:
        radial-gradient(circle at 85% 5%, rgba(12,144,150,.14), transparent 27%), #031716;
}


/* =========================================================
   HEADER
   ========================================================= */

.form-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    margin-bottom: 8px;
    border-radius: 13px;
    background:
        linear-gradient(110deg, rgba(12,144,150,.25), rgba(5,45,46,.82));
    border: 1px solid rgba(183,215,229,.16);
    box-shadow: 0 8px 20px rgba(0,0,0,.14);
    color: #FFFFFF;
}

.form-header-icon {
    width: 38px; height: 38px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    border-radius: 10px;
    background: rgba(255,255,255,.09); border: 1px solid rgba(255,255,255,.13);
    color: #69DDF2; font-size: 16px;
}

.form-header-content { flex: 1; min-width: 0; }

.form-header-kicker {
    display: block; margin-bottom: 4px;
    color: #A9D5DE; font-size: 12px; font-weight: 700; letter-spacing: 1px;
}

.form-header h1 { margin: 0; color: #FFFFFF; font-size: 24px; font-weight: 700; line-height: 1.1; }
.form-header p { margin: 3px 0 0; color: #C5DDE2; font-size: 13px; line-height: 1.4; }

/* =========================================================
   PROGRAM BANNER
   ========================================================= */

.program-banner {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 11px; margin-bottom: 8px;
    border: 1px solid rgba(105,199,232,.14);
    border-radius: 8px;
    background: rgba(105,199,232,.08);
}

.program-banner-icon {
    width: 30px; height: 30px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    border-radius: 6px; background: rgba(105,199,232,.10); color: #69DDF2; font-size: 14px;
}

.program-banner-main { flex: 1; min-width: 0; }
.banner-eyebrow { display: block; color: #69DDF2; font-size: 12px; font-weight: 700; letter-spacing: .8px; }
.program-banner-main h2 { margin: 2px 0 4px; color: #FFFFFF; font-size: 14px; font-weight: 700; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.program-meta { display: flex; flex-wrap: wrap; gap: 8px; }
.program-meta span { display: inline-flex; align-items: center; gap: 3px; color: #72969E; font-size: 12px; }
.program-meta i { color: #69DDF2; font-size: 12px; }

.program-status { align-self: flex-start; }
.status-badge {
    min-height: 18px; padding: 0 6px;
    display: inline-flex; align-items: center; gap: 3px;
    border-radius: 999px; font-size: 12px; font-weight: 700;
}
.status-badge.active { background: rgba(43,166,126,.12); color: #69F0AE; border: 1px solid rgba(105,240,174,.17); }
.status-badge.inactive { background: rgba(183,215,229,.07); color: #A9BAC0; border: 1px solid rgba(183,215,229,.12); }
.status-dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }


/* =========================================================
   INFO BOX
   ========================================================= */

.info-box {
    display: flex; align-items: flex-start; gap: 8px;
    padding: 8px 10px; margin-bottom: 8px;
    border: 1px solid rgba(105,199,232,.14);
    border-radius: 8px; background: rgba(105,199,232,.08);
}
.info-box-icon { color: #69DDF2; font-size: 14px; flex-shrink: 0; }
.info-box-content { min-width: 0; }
.info-box-content strong { display: block; color: #FFFFFF; font-size: 12px; margin-bottom: 2px; }
.info-box-content p { margin: 0; color: #769BA3; font-size: 12px; line-height: 1.4; }


/* =========================================================
   PANEL
   ========================================================= */

.dashboard-panel {
    padding: 10px; border-radius: 11px;
    background: linear-gradient(135deg, rgba(5,45,46,.82), rgba(3,23,22,.94));
    border: 1px solid rgba(183,215,229,.14);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
    margin-bottom: 8px;
}

.panel-header {
    min-height: 34px; display: flex; align-items: flex-start;
    justify-content: space-between; gap: 8px; margin-bottom: 8px;
}
.panel-eyebrow { display: block; color: #69DDF2; font-size: 12px; font-weight: 700; letter-spacing: .8px; }
.panel-header h2 { margin: 2px 0 1px; color: #FFFFFF; font-size: 14px; line-height: 1.1; }
.panel-header p { margin: 0; color: #769BA3; font-size: 12px; }
.participant-count {
    padding: 4px 7px; display: flex; align-items: center; gap: 4px;
    border-radius: 5px; white-space: nowrap;
    background: rgba(105,199,232,.08); border: 1px solid rgba(105,199,232,.14);
    color: #8DDCF2; font-size: 12px; font-weight: 700;
}


/* =========================================================
   FILTER BAR
   ========================================================= */

.filter-bar {
    display: flex; align-items: flex-end; gap: 8px; flex-wrap: wrap;
}

.filter-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.filter-field.grow { flex: 1; min-width: 160px; }

.filter-field label {
    color: #A9D5DE; font-size: 12px; font-weight: 700; letter-spacing: .5px;
}

.filter-field input,
.filter-field select {
    min-height: 30px; padding: 0 8px;
    border: 1px solid rgba(183,215,229,.16);
    border-radius: 7px;
    background: rgba(255,255,255,.055);
    color: #D8EEF2;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
}

.filter-field input:focus,
.filter-field select:focus {
    border-color: #69C7E8;
    box-shadow: 0 0 0 3px rgba(105,199,232,.15);
}

.filter-actions { display: flex; align-items: center; gap: 6px; }

.filter-apply, .filter-reset {
    min-height: 30px; padding: 0 10px;
    display: inline-flex; align-items: center; justify-content: center; gap: 4px;
    border-radius: 7px; font-size: 12px; font-weight: 700;
    text-decoration: none; cursor: pointer; transition: .15s ease;
}

.filter-apply {
    border: 1px solid #0C9096; background: #0C9096; color: #FFFFFF;
}
.filter-apply:hover { background: #0A7D82; border-color: #0A7D82; }

.filter-reset {
    border: 1px solid rgba(183,215,229,.16);
    background: rgba(255,255,255,.06); color: #C5DDE2;
}
.filter-reset:hover { background: rgba(255,255,255,.10); color: #FFFFFF; text-decoration: none; }


/* =========================================================
   MAIN TABLE
   ========================================================= */

.table-scroll { overflow-x: auto; }

.attendance-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
}

.attendance-table thead th {
    padding: 7px 8px;
    text-align: left;
    color: #A9D5DE;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .5px;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(183,215,229,.14);
    white-space: nowrap;
}

.attendance-table tbody td {
    padding: 8px;
    color: #D8EEF2;
    font-size: 14px;
    border-bottom: 1px solid rgba(183,215,229,.08);
    vertical-align: middle;
}

.attendance-table tbody tr:hover { background: rgba(255,255,255,.03); }

.attendance-table .col-num { width: 34px; color: #72969E; }

.attendance-table .col-name { min-width: 170px; }

.attendance-table .col-action { width: 74px; }

.row-name { display: block; color: #FFFFFF; font-weight: 700; }

.row-sub { display: block; margin-top: 2px; color: #72969E; font-size: 12px; }


/* Attendance-action cell contents */

.cell-time {
    color: #8DDCF2;
    font-weight: 700;
    white-space: nowrap;
}

.cell-dash { color: #668A92; }

.cell-badge {
    min-height: 17px; padding: 0 5px;
    display: inline-flex; align-items: center; gap: 3px;
    border-radius: 999px;
    font-size: 12px; font-weight: 700;
    white-space: nowrap;
}
.cell-badge.pending {
    background: rgba(241,163,61,.10); color: #F1A33C;
    border: 1px solid rgba(241,163,61,.18);
}
.cell-badge.rejected {
    background: rgba(241,91,103,.10); color: #F56D78;
    border: 1px solid rgba(241,91,103,.18);
}
.cell-badge i { font-size: 12px; }


/* Overall status badge - color + text, never color alone */

.st-badge {
    min-height: 18px; padding: 0 6px;
    display: inline-flex; align-items: center; gap: 3px;
    border-radius: 999px;
    font-size: 12px; font-weight: 700;
    white-space: nowrap;
}
.st-dot { width: 4px; height: 4px; border-radius: 50%; background: currentColor; flex-shrink: 0; }

.st-present { background: rgba(43,166,126,.12); color: #69F0AE; border: 1px solid rgba(105,240,174,.17); }
.st-pending { background: rgba(241,163,61,.10); color: #F1A33C; border: 1px solid rgba(241,163,61,.18); }
.st-incomplete { background: rgba(241,163,61,.10); color: #F1A33C; border: 1px solid rgba(241,163,61,.18); }
.st-rejected { background: rgba(241,91,103,.10); color: #F56D78; border: 1px solid rgba(241,91,103,.18); }
.st-absent { background: rgba(241,91,103,.10); color: #F56D78; border: 1px solid rgba(241,91,103,.18); }
.st-notyetdue { background: rgba(105,199,232,.10); color: #8DDCF2; border: 1px solid rgba(105,199,232,.16); }
.st-late { background: rgba(241,163,61,.10); color: #F1A33C; border: 1px solid rgba(241,163,61,.18); }
.st-excused { background: rgba(105,199,232,.10); color: #8DDCF2; border: 1px solid rgba(105,199,232,.16); }
.st-other { background: rgba(183,215,229,.07); color: #A9BAC0; border: 1px solid rgba(183,215,229,.12); }


/* Row action */

.row-view {
    min-height: 24px; padding: 0 7px;
    display: inline-flex; align-items: center; justify-content: center; gap: 3px;
    border-radius: 5px;
    border: 1px solid rgba(105,199,232,.20);
    background: rgba(105,199,232,.10);
    color: #69DDF2;
    font-size: 12px; font-weight: 700; text-decoration: none;
    transition: .14s ease;
}
.row-view:hover { background: rgba(105,199,232,.18); color: #FFFFFF; text-decoration: none; }


/* =========================================================
   STATUS LEGEND
   ========================================================= */

.status-legend {
    display: flex; align-items: center; flex-wrap: wrap; gap: 5px;
    margin-top: 8px;
}
.legend-title { color: #769BA3; font-size: 12px; font-weight: 700; }


/* =========================================================
   PAGINATION
   ========================================================= */

.pager {
    display: flex; align-items: center; justify-content: flex-end;
    gap: 8px; margin-top: 8px;
}

.page-link {
    min-height: 26px; padding: 0 8px;
    display: inline-flex; align-items: center; gap: 4px;
    border-radius: 6px;
    border: 1px solid rgba(183,215,229,.15);
    background: rgba(255,255,255,.05);
    color: #8DDCF2;
    font-size: 12px; font-weight: 700; text-decoration: none;
    transition: .14s ease;
}
.page-link:hover { background: rgba(105,199,232,.10); color: #FFFFFF; text-decoration: none; }

.page-link.disabled {
    opacity: .4; pointer-events: none;
}

.page-info { color: #769BA3; font-size: 12px; font-weight: 700; }


/* =========================================================
   EMPTY STATE
   ========================================================= */

.empty-state {
