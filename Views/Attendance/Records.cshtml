@model IEnumerable<BYPManagementSystem.Models.AttendanceRecord>

@{
    ViewData["Title"] = "Attendance Records";

    var program =
        ViewBag.Program as BYPManagementSystem.Models.YouthProgram;

    var youth =
        ViewBag.Youth as BYPManagementSystem.Models.YouthParticipant;

    var records =
        Model?.ToList()
        ?? new List<BYPManagementSystem.Models.AttendanceRecord>();

    var totalStudents =
        ViewBag.TotalStudents is int total
            ? total
            : 0;

    var presentCount =
        ViewBag.PresentCount is int present
            ? present
            : 0;

    var absentCount =
        ViewBag.AbsentCount is int absent
            ? absent
            : 0;

    var lateExcusedCount =
        ViewBag.LateExcusedCount is int lateExcused
            ? lateExcused
            : 0;

    var search =
        ViewBag.Search as string
        ?? "";

    var selectedStatus =
        ViewBag.Status as string
        ?? "";

    var selectedDate =
        ViewBag.AttendanceDate as string
        ?? "";
}


<div class="records-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="page-header">

        <div class="header-title-content">

            <a asp-controller="Attendance"
               asp-action="Participants"
               asp-route-id="@(program?.Id)"
               class="back-link">

                <i class="bi bi-arrow-left"></i>

                Back to Participants

            </a>

            <div class="header-title-row">

                <div class="header-icon">
                    <i class="bi bi-clipboard-data"></i>
                </div>

                <div>

                    <span class="page-eyebrow">
                        ATTENDANCE RECORDS
                    </span>

                    <h1>
                        @(youth?.FullName ?? "Youth Participant")
                    </h1>

                    <p>
                        View and manage attendance records for this youth
                        participant in the selected program.
                    </p>

                </div>

            </div>

        </div>


        <div class="header-actions">

            <a asp-controller="Attendance"
               asp-action="Participants"
               asp-route-id="@(program?.Id)"
               class="header-button secondary">

                <i class="bi bi-people"></i>

                Participants

            </a>


            @if (program != null && youth != null)
            {
                <a asp-controller="Attendance"
                   asp-action="Record"
                   asp-route-programId="@program.Id"
                   asp-route-youthParticipantId="@youth.Id"
                   class="header-button primary">

                    <i class="bi bi-plus-lg"></i>

                    Record Attendance

                </a>
            }

        </div>

    </div>


    <!-- =========================================================
         PARTICIPANT / PROGRAM INFORMATION
    ========================================================== -->

    <section class="context-card">

        <div class="context-person">

            <div class="participant-avatar">

                @{
                    var firstInitial =
                        !string.IsNullOrWhiteSpace(youth?.FirstName)
                            ? youth.FirstName.Substring(0, 1).ToUpper()
                            : "U";

                    var lastInitial =
                        !string.IsNullOrWhiteSpace(youth?.LastName)
                            ? youth.LastName.Substring(0, 1).ToUpper()
                            : "";
                }

                @firstInitial@lastInitial

            </div>


            <div class="person-information">

                <span class="context-eyebrow">
                    YOUTH PARTICIPANT
                </span>


                <h2>
                    @(youth?.FullName ?? "Unknown Participant")
                </h2>


                <div class="person-meta">

                    <span>

                        <i class="bi bi-geo-alt"></i>

                        @(youth?.Barangay ?? "No barangay")

                    </span>


                    <span>

                        <i class="bi bi-telephone"></i>

                        @(string.IsNullOrWhiteSpace(youth?.ContactNumber)
                            ? "No contact number"
                            : youth.ContactNumber)

                    </span>

                </div>

            </div>

        </div>


        <div class="context-divider"></div>


        <div class="context-program">

            <span class="context-eyebrow">
                PROGRAM
            </span>


            <h3>
                @(program?.Name ?? "Unknown Program")
            </h3>


            <div class="program-meta">

                <span>

                    <i class="bi bi-clock"></i>

                    @(program?.Schedule ?? "No schedule")

                </span>


                <span>

                    <i class="bi bi-geo-alt"></i>

                    @(program?.Barangay ?? "No barangay")

                </span>

            </div>

        </div>

    </section>




    <!-- =========================================================
         FILTERS
    ========================================================== -->

    <section class="filter-panel">

        <div class="filter-heading">

            <div>

                <span>
                    ATTENDANCE FILTERS
                </span>


                <h2>
                    Search and Filter Records
                </h2>

            </div>

        </div>


        <form asp-controller="Attendance"
              asp-action="Records"
              method="get">

            <input type="hidden"
                   name="programId"
                   value="@(program?.Id)" />


            <input type="hidden"
                   name="youthParticipantId"
                   value="@(youth?.Id)" />


            <div class="filter-grid">

                <!-- SEARCH -->

                <div class="filter-group search-group">

                    <label for="search">
                        Search
                    </label>


                    <div class="search-wrapper">

                        <i class="bi bi-search"></i>


                        <input type="text"
                               id="search"
                               name="search"
                               value="@search"
                               class="search-input"
                               placeholder="Search status or notes..." />

                    </div>

                </div>


                <!-- STATUS -->

                <div class="filter-group">

                    <label for="status">
                        Status
                    </label>


                    <select id="status"
                            name="status"
                            class="filter-input">

                        @if (string.IsNullOrEmpty(selectedStatus) ||
                             selectedStatus == "All")
                        {
                            <option value="All" selected>
                                All Status
                            </option>
                        }
                        else
                        {
                            <option value="All">
                                All Status
                            </option>
                        }


                        @if (selectedStatus == "Present")
                        {
                            <option value="Present" selected>
                                Present
                            </option>
                        }
                        else
                        {
                            <option value="Present">
                                Present
                            </option>
                        }


                        @if (selectedStatus == "Absent")
                        {
                            <option value="Absent" selected>
                                Absent
                            </option>
                        }
                        else
                        {
                            <option value="Absent">
                                Absent
                            </option>
                        }


                        @if (selectedStatus == "Late")
                        {
                            <option value="Late" selected>
                                Late
                            </option>
                        }
                        else
                        {
                            <option value="Late">
                                Late
                            </option>
                        }


                        @if (selectedStatus == "Excused")
                        {
                            <option value="Excused" selected>
                                Excused
                            </option>
                        }
                        else
                        {
                            <option value="Excused">
                                Excused
                            </option>
                        }

                    </select>

                </div>


                <!-- DATE -->

                <div class="filter-group">

                    <label for="attendanceDate">
                        Attendance Date
                    </label>


                    <input type="date"
                           id="attendanceDate"
                           name="attendanceDate"
                           value="@selectedDate"
                           class="filter-input" />

                </div>


                <!-- ACTION -->

                <div class="filter-actions">

                    <button type="submit"
                            class="filter-button">

                        <i class="bi bi-funnel"></i>

                        Apply

                    </button>


                    <a asp-controller="Attendance"
                       asp-action="Records"
                       asp-route-programId="@(program?.Id)"
                       asp-route-youthParticipantId="@(youth?.Id)"
                       class="clear-button">

                        <i class="bi bi-arrow-clockwise"></i>

                        Reset

                    </a>

                </div>

            </div>

        </form>

    </section>


    <!-- =========================================================
         RECORDS TABLE
    ========================================================== -->

    <section class="records-panel">

        <div class="panel-header">

            <div>

                <span class="panel-eyebrow">
                    ATTENDANCE HISTORY
                </span>


                <h2>
                    Attendance Records
                </h2>


                <p>
                    Attendance entries recorded for this participant.
                </p>

            </div>


            <div class="record-count">

                <i class="bi bi-list-check"></i>

                @records.Count
                record@(records.Count == 1 ? "" : "s")

            </div>

        </div>


        @if (records.Any())
        {
            <div class="table-wrapper attendance-list-container">

                <table class="attendance-table">

                    <thead>

                        <tr>

                            <th>
                                Date
                            </th>

                            <th>
                                Program
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Morning In
                            </th>

                            <th>
                                Morning Out
                            </th>

                            <th>
                                Afternoon In
                            </th>

                            <th>
                                Afternoon Out
                            </th>

                            <th>
                                Notes
                            </th>

                            <th>
                                Recorded
                            </th>

                            <th class="action-column">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var record in records)
                        {
                            <tr>

                                <!-- DATE -->

                                <td>

                                    <div class="date-cell">

                                        <div class="date-icon">

                                            <i class="bi bi-calendar3"></i>

                                        </div>


                                        <div>

                                            <strong>
                                                @(record.AttendanceDate.ToString("MMM dd, yyyy"))
                                            </strong>

                                            <span>
                                                Attendance date
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- PROGRAM -->

                                <td>

                                    <div class="program-cell">

                                        <i class="bi bi-calendar-event"></i>

                                        @(record.Registration?.Program?.Name
                                            ?? program?.Name
                                            ?? "Unknown Program")

                                    </div>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (string.Equals(
                                        record.Status,
                                        "Present",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge present">

                                            <i class="bi bi-check-circle-fill"></i>

                                            Present

                                        </span>
                                    }
                                    else if (string.Equals(
                                        record.Status,
                                        "Absent",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge absent">

                                            <i class="bi bi-x-circle-fill"></i>

                                            Absent

                                        </span>
                                    }
                                    else if (string.Equals(
                                        record.Status,
                                        "Late",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge late">

                                            <i class="bi bi-clock-fill"></i>

                                            Late

                                        </span>
                                    }
                                    else if (string.Equals(
                                        record.Status,
                                        "Excused",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge excused">

                                            <i class="bi bi-info-circle-fill"></i>

                                            Excused

                                        </span>
                                    }
                                    else if (string.Equals(
                                        record.Status,
                                        "InProgress",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge excused">

                                            <i class="bi bi-arrow-repeat"></i>

                                            In Progress

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge default">

                                            @record.Status

                                        </span>
                                    }

                                </td>


                                <!-- TIME IN -->

                                <td>

                                    @if (record.TimeInAt.HasValue)
                                    {
                                        <div class="recorded-cell">

                                            @AttendanceSchedule.ToAppTime(record.TimeInAt.Value).ToString("hh:mm tt")

                                            <span>
                                                Approved submission
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-notes">
                                            &mdash;
                                        </span>
                                    }

                                </td>


                                <!-- MORNING TIME OUT -->

                                <td>

                                    @if (record.TimeOutAt.HasValue)
                                    {
                                        <div class="recorded-cell">

                                            @AttendanceSchedule.ToAppTime(record.TimeOutAt.Value).ToString("hh:mm tt")

                                            <span>
                                                Approved submission
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-notes">
                                            &mdash;
                                        </span>
                                    }

                                </td>


                                <!-- AFTERNOON TIME IN -->

                                <td>

                                    @if (record.AfternoonInAt.HasValue)
                                    {
                                        <div class="recorded-cell">

                                            @AttendanceSchedule.ToAppTime(record.AfternoonInAt.Value).ToString("hh:mm tt")

                                            <span>
                                                Approved submission
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-notes">
                                            &mdash;
                                        </span>
                                    }

                                </td>


                                <!-- AFTERNOON TIME OUT -->

                                <td>

                                    @if (record.AfternoonOutAt.HasValue)
                                    {
                                        <div class="recorded-cell">

                                            @AttendanceSchedule.ToAppTime(record.AfternoonOutAt.Value).ToString("hh:mm tt")

                                            <span>
                                                Approved submission
                                            </span>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-notes">
                                            &mdash;
                                        </span>
                                    }

                                </td>


                                <!-- NOTES -->

                                <td>

                                    <div class="notes-cell">

                                        @if (string.IsNullOrWhiteSpace(
                                            record.Notes))
                                        {
                                            <span class="no-notes">
                                                No notes
                                            </span>
                                        }
                                        else
                                        {
                                            @record.Notes
                                        }

                                    </div>

                                </td>


                                <!-- RECORDED -->

                                <td>

                                    <div class="recorded-cell">

                                        @AttendanceSchedule.ToAppTime(record.RecordedAt).ToString("MMM dd, yyyy")

                                        <span>

                                            @AttendanceSchedule.ToAppTime(record.RecordedAt).ToString("h:mm tt")

                                        </span>

                                    </div>

                                </td>


                                <!-- ACTION -->

                                <td class="action-column">

                                    <a asp-controller="Attendance"
                                       asp-action="Edit"
                                       asp-route-id="@record.Id"
                                       class="edit-button"
                                       title="Edit Attendance">

                                        <i class="bi bi-pencil"></i>

                                        Edit

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-clipboard-x"></i>

                </div>


                <h3>
                    No attendance records found
                </h3>


                <p>
                    There are no attendance records matching the
                    current filters for this youth participant.
                </p>


                @if (program != null && youth != null)
                {
                    <a asp-controller="Attendance"
                       asp-action="Record"
                       asp-route-programId="@program.Id"
                       asp-route-youthParticipantId="@youth.Id"
                       class="empty-button">

                        <i class="bi bi-plus-lg"></i>

                        Record Attendance

                    </a>
                }

            </div>
        }

    </section>


    <!-- =========================================================
         STATUS LEGEND
    ========================================================== -->

    <section class="legend-panel">

        <div class="legend-title">

            <span>
                ATTENDANCE STATUS
            </span>

        </div>


        <div class="legend-items">


            <div class="legend-item">

                <span class="legend-dot present"></span>

                <strong>
                    Present
                </strong>

                <span>
                    Participant attended
                </span>

            </div>


            <div class="legend-item">

                <span class="legend-dot absent"></span>

                <strong>
                    Absent
                </strong>

                <span>
                    Participant did not attend
                </span>

            </div>


            <div class="legend-item">

                <span class="legend-dot late"></span>

                <strong>
                    Late
                </strong>

                <span>
                    Participant arrived late
                </span>

            </div>


            <div class="legend-item">

                <span class="legend-dot excused"></span>

                <strong>
                    Excused
                </strong>

                <span>
                    Absence was excused
                </span>

            </div>

        </div>

    </section>


    <!-- =========================================================
         BOTTOM ACTIONS
    ========================================================== -->

    <div class="bottom-actions">

        <a asp-controller="Attendance"
           asp-action="Participants"
           asp-route-id="@(program?.Id)"
           class="bottom-button secondary">

            <i class="bi bi-arrow-left"></i>

            Back to Participants

        </a>


        @if (program != null && youth != null)
        {
            <a asp-controller="Attendance"
               asp-action="Record"
               asp-route-programId="@program.Id"
               asp-route-youthParticipantId="@youth.Id"
               class="bottom-button primary">

                <i class="bi bi-plus-lg"></i>

                Record New Attendance

            </a>
        }

    </div>

</div>


<style>

    /* =========================================================
           PAGE
        ========================================================== */

    .records-page {
        width: 100%;
        padding: 12px 18px 18px;
    }


    /* =========================================================
           HEADER
        ========================================================== */

    .page-header {
        margin-bottom: 18px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
    }


    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 9px;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 700;
        text-decoration: none;
    }


        .back-link:hover {
            color: #0d6efd;
        }


    .page-eyebrow,
    .panel-eyebrow {
        display: block;
        color: #0d6efd;
        font-size: 0.75rem;
        font-weight: 850;
        letter-spacing: .1em;
    }


    .page-header h1 {
        margin: 5px 0 4px;
        color: #111827;
        font-size: 1.68rem;
        font-weight: 850;
        letter-spacing: -.4px;
    }


    .page-header p {
        margin: 0;
        color: #64748b;
        font-size: 0.75rem;
    }


    .header-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }


    .header-button {
        min-height: 35px;
        padding: 0 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border-radius: 7px;
        font-size: 0.75rem;
        font-weight: 750;
        text-decoration: none;
    }


        .header-button.secondary {
            border: 1px solid #dfe6ee;
            background: #ffffff;
            color: #64748b;
        }


            .header-button.secondary:hover {
                background: #f8fafc;
                color: #0d6efd;
            }


        .header-button.primary {
            border: 1px solid #0d6efd;
            background: #0d6efd;
            color: #ffffff;
        }


            .header-button.primary:hover {
                background: #0b5ed7;
                color: #ffffff;
            }


    /* =========================================================
           CONTEXT
        ========================================================== */

    .context-card {
        margin-bottom: 15px;
        padding: 14px;
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) 1px minmax(0, 1fr);
        align-items: center;
        gap: 15px;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        background: #f8fbff;
    }


    .context-person {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .participant-avatar {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #ffffff;
        color: #0d6efd;
        font-size: 0.75rem;
        font-weight: 850;
        box-shadow: 0 3px 9px rgba(15, 23, 42, .04);
    }


    .person-information {
        min-width: 0;
    }


    .context-eyebrow {
        display: block;
        color: #0d6efd;
        font-size: 0.75rem;
        font-weight: 850;
        letter-spacing: .08em;
    }


    .person-information h2 {
        margin: 3px 0 5px;
        overflow: hidden;
        color: #334155;
        font-size: .8rem;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    .person-meta,
    .program-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
    }


        .person-meta span,
        .program-meta span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            color: #64748b;
            font-size: 0.75rem;
        }


        .person-meta i,
        .program-meta i {
            color: #0d6efd;
        }


    .context-divider {
        width: 1px;
        height: 55px;
        background: #dbe4ed;
    }


    .context-program {
        min-width: 0;
    }


        .context-program h3 {
            margin: 4px 0 6px;
            overflow: hidden;
            color: #475569;
            font-size: 0.8rem;
            font-weight: 800;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


    /* =========================================================
           SUMMARY
        ========================================================== */

    .summary-grid {
        margin-bottom: 15px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }


    .summary-card {
        min-height: 87px;
        padding: 13px;
        display: flex;
        align-items: center;
        gap: 9px;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        background: #ffffff;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .025);
    }


    .summary-icon {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        font-size: 0.8rem;
    }


        .summary-icon.total {
            background: #eff6ff;
            color: #0d6efd;
        }


        .summary-icon.present {
            background: #ecfdf5;
            color: #16a34a;
        }


        .summary-icon.absent {
            background: #fef2f2;
            color: #dc2626;
        }


        .summary-icon.late {
            background: #fff7ed;
            color: #ea580c;
        }


    .summary-content {
        min-width: 0;
    }


        .summary-content span {
            display: block;
            color: #64748b;
            font-size: 0.75rem;
            font-weight: 700;
        }


        .summary-content strong {
            display: block;
            margin-top: 3px;
            color: #111827;
            font-size: 1.1rem;
            line-height: 1;
        }


        .summary-content small {
            display: block;
            margin-top: 4px;
            color: #94a3b8;
            font-size: 0.75rem;
        }


    /* =========================================================
           FILTER PANEL
        ========================================================== */

    .filter-panel {
        margin-bottom: 15px;
        padding: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #ffffff;
    }


    .filter-heading {
        margin-bottom: 12px;
    }


        .filter-heading span {
            display: block;
            color: #0d6efd;
            font-size: 0.75rem;
            font-weight: 850;
            letter-spacing: .08em;
        }


        .filter-heading h2 {
            margin: 4px 0 0;
            color: #475569;
            font-size: 0.8rem;
            font-weight: 800;
        }


    .filter-grid {
        display: grid;
        grid-template-columns: minmax(250px, 1fr) 170px 175px 170px;
        align-items: end;
        gap: 9px;
    }


    .filter-group label {
        display: block;
        margin-bottom: 5px;
        color: #526174;
        font-size: 0.75rem;
        font-weight: 750;
    }


    .search-wrapper {
        position: relative;
    }


        .search-wrapper i {
            position: absolute;
            left: 10px;
            top: 50%;
