@model BYPManagementSystem.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}


<div class="register-page">

    <div class="register-card">


        <!-- =====================================================
             REGISTER FORM
        ====================================================== -->

        <form asp-controller="Account"
              asp-action="Register"
              method="post"
              class="register-form">

            @Html.AntiForgeryToken()


            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>
            }


            <!-- =================================================
                 TITLE
            ================================================== -->

            <div class="register-header">

                <h1 class="register-title">
                    Create Your Account
                </h1>

                <p class="register-subtitle">
                    Register as a youth user to access programs,
                    registrations, and your attendance records.
                </p>

            </div>


            <!-- =================================================
                 EMAIL
            ================================================== -->

            <div class="form-group">

                <label asp-for="Email">
                    Email Address
                </label>


                <div class="input-wrapper">

                    <i class="bi bi-envelope input-icon"></i>


                    <input asp-for="Email"
                           type="email"
                           class="form-control custom-input"
                           placeholder="Enter your email"
                           autocomplete="email" />

                </div>


                <span asp-validation-for="Email"
                      class="field-error">
                </span>

            </div>


            <!-- =================================================
                 PASSWORD
            ================================================== -->

            <div class="form-group">

                <label asp-for="Password">
                    Password
                </label>


                <div class="input-wrapper">

                    <i class="bi bi-lock input-icon"></i>


                    <input asp-for="Password"
                           type="password"
                           id="passwordInput"
                           class="form-control custom-input password-input"
                           placeholder="Create a password"
                           autocomplete="new-password" />


                    <button type="button"
                            id="togglePassword"
                            class="password-toggle"
                            aria-label="Show password">

                        <i class="bi bi-eye"
                           id="passwordIcon"></i>

                    </button>

                </div>


                <span class="password-help">
                    Use at least 8 characters.
                </span>


                <span asp-validation-for="Password"
                      class="field-error">
                </span>

            </div>


            <!-- =================================================
                 CONFIRM PASSWORD
            ================================================== -->

            <div class="form-group">

                <label asp-for="ConfirmPassword">
                    Confirm Password
                </label>


                <div class="input-wrapper">

                    <i class="bi bi-shield-lock input-icon"></i>


                    <input asp-for="ConfirmPassword"
                           type="password"
                           id="confirmPasswordInput"
                           class="form-control custom-input password-input"
                           placeholder="Confirm your password"
                           autocomplete="new-password" />


                    <button type="button"
                            id="toggleConfirmPassword"
                            class="password-toggle"
                            aria-label="Show confirm password">

                        <i class="bi bi-eye"
                           id="confirmPasswordIcon"></i>

                    </button>

                </div>


                <span asp-validation-for="ConfirmPassword"
                      class="field-error">
                </span>

            </div>


            @* <!-- =================================================
                 ACCOUNT TYPE
            ================================================== -->

            <div class="account-type-box">


                <div class="account-type-icon">

                    <i class="bi bi-person-check"></i>

                </div>


                <div class="account-type-content">

                    <div class="account-type-title">
                        Account Type
                    </div>

                    <div class="account-type-description">
                        New public accounts are registered as
                        User / Youth.
                    </div>

                </div>


            </div> 
            *@


            <!-- =================================================
                 CREATE ACCOUNT
            ================================================== -->

            <button type="submit"
                    class="register-button">

                <i class="bi bi-person-plus"></i>

                <span>
                    Create Account
                </span>

            </button>


            <!-- =================================================
                 LOGIN LINK
            ================================================== -->

            <div class="login-link-area">

                <span>
                    Already have an account?
                </span>


                <a asp-controller="Account"
                   asp-action="Login">

                    Sign in

                </a>

            </div>


        </form>

    </div>

</div>


<style>

    /* =========================================================
       GLOBAL REGISTER FONT
    ========================================================== */

    .register-page,
    .register-page * {

        font-family:
            Arial,
            Helvetica,
            sans-serif;

    }


    /* =========================================================
       PAGE
    ========================================================== */

    .register-page {

        width: 100%;

        min-height: auto;

        height: auto;

        margin: 0;

        padding: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        background: transparent;

        box-sizing: border-box;

    }


    /* =========================================================
       REGISTER CARD
    ========================================================== */

    .register-card {

        width: 100%;

        max-width: 470px;

        margin: 0 auto;

        padding: 36px 40px;

        background:
            rgba(3, 22, 21, .30);

        border:
            1px solid
            rgba(183, 215, 229, .38);

        border-radius: 20px;

        box-shadow:
            0 18px 45px
            rgba(3, 22, 21, .24);

        backdrop-filter:
            blur(16px);

        -webkit-backdrop-filter:
            blur(16px);

        box-sizing: border-box;

    }


    /* =========================================================
       FORM
    ========================================================== */

    .register-form {

        width: 100%;

        margin: 0;

    }


    /* =========================================================
       HEADER
    ========================================================== */

    .register-header {

        width: 100%;

        margin: 0 0 24px;

        text-align: center;

    }


    .register-title {

        margin: 0;

        color: #FFFFFF;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: 1.8rem;

        font-weight: 800;

        line-height: 1.2;

    }


    .register-subtitle {

        max-width: 430px;

        margin: 8px auto 0;

        color: #D3E5EC;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .82rem;

        font-weight: 400;

        line-height: 1.45;

    }


    /* =========================================================
       FORM GROUP
    ========================================================== */

    .form-group {

        width: 100%;

        margin-bottom: 18px;

    }


    /* =========================================================
       LABEL
    ========================================================== */

    .form-group > label {

        display: block;

        margin:
            0 0 7px;

        color: #FFFFFF;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .92rem;

        font-weight: 700;

        line-height: 1.3;

    }


    /* =========================================================
       INPUT WRAPPER
    ========================================================== */

    .input-wrapper {

        position: relative;

        width: 100%;

    }


    /* =========================================================
       INPUT ICONS
    ========================================================== */

    .input-icon {

        position: absolute;

        top: 50%;

        left: 15px;

        z-index: 5;

        width: 26px;

        height: 26px;

        display: flex;

        align-items: center;

        justify-content: center;

        transform:
            translateY(-50%);

        border-radius: 7px;

        background:
            rgba(255,255,255,.90);

        color: #031716;

        font-size: .78rem;

        pointer-events: none;

    }


    /* =========================================================
       INPUT
    ========================================================== */

    .custom-input {

        width: 100%;

        height: 50px;

        min-height: 50px;

        padding:
            0 48px;

        border:
            1px solid
            rgba(183,215,229,.45);

        border-radius: 10px;

        background:
            rgba(104,157,184,.18);

        color: #FFFFFF;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .92rem;

        font-weight: 400;

        outline: none;

        box-shadow:
            0 4px 12px
            rgba(3,22,21,.08);

        backdrop-filter:
            blur(7px);

        -webkit-backdrop-filter:
            blur(7px);

        transition:
            background .2s ease,
            border-color .2s ease,
            box-shadow .2s ease;

        box-sizing: border-box;

    }


    /* =========================================================
       PLACEHOLDER
    ========================================================== */

    .custom-input::placeholder {

        color:
            rgba(255,255,255,.68);

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .92rem;

        opacity: 1;

    }


    /* =========================================================
       INPUT FOCUS
    ========================================================== */

    .custom-input:focus {

        border-color:
            rgba(183,215,229,.75);

        background:
            rgba(104,157,184,.26);

        box-shadow:
            0 0 0 3px
            rgba(104,157,184,.16);

    }


    /* =========================================================
       PASSWORD
    ========================================================== */

    .password-input {

        padding-right: 52px;

    }


    /* =========================================================
       PASSWORD TOGGLE
    ========================================================== */

    .password-toggle {

        position: absolute;

        top: 50%;

        right: 7px;

        z-index: 5;

        width: 34px;

        height: 34px;

        transform:
            translateY(-50%);

        display: flex;

        align-items: center;

        justify-content: center;

        margin: 0;

        padding: 0;

        border: 0;

        border-radius: 8px;

        background:
            rgba(255,255,255,.82);

        color: #031716;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .85rem;

        cursor: pointer;

    }


    .password-toggle:hover {

        background:
            rgba(255,255,255,.96);

        color: #052D2E;

    }


    /* =========================================================
       PASSWORD HELP
    ========================================================== */

    .password-help {

        display: block;

        margin-top: 5px;

        color: #B7D7E5;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .72rem;

        line-height: 1.2;

    }


    /* =========================================================
       ACCOUNT TYPE
    ========================================================== */

    .account-type-box {

        width: 100%;

        min-height: 62px;

        margin:
            2px 0 20px;

        padding:
            11px 13px;

        display: flex;

        align-items: center;

        gap: 12px;

        border:
            1px solid
            rgba(183,215,229,.34);

        border-radius: 11px;

        background:
            rgba(104,157,184,.13);

        box-sizing: border-box;

    }


    .account-type-icon {

        width: 38px;

        height: 38px;

        flex-shrink: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 9px;

        background:
            rgba(255,255,255,.90);

        color: #031716;

        font-size: .82rem;

    }


    .account-type-content {

        min-width: 0;

    }


    .account-type-title {

        color: #FFFFFF;

        font-size: .88rem;

        font-weight: 700;

        line-height: 1.2;

    }


    .account-type-description {

        margin-top: 3px;

        color: #B7D7E5;

        font-size: .72rem;

        line-height: 1.3;

    }


    /* =========================================================
       CREATE ACCOUNT BUTTON
    ========================================================== */

    .register-button {

        width: 100%;

        height: 50px;

        min-height: 50px;

        display: flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        margin: 0;

        padding:
            0 20px;

        border:
            1px solid
            rgba(104,157,184,.65);

        border-radius: 10px;

        background:
            #0C9096;

        color: #FFFFFF;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .95rem;

        font-weight: 700;

        line-height: 1;

        cursor: pointer;

        box-shadow:
            0 8px 20px
            rgba(3,22,21,.18);

        transition:
            background .2s ease,
            transform .2s ease;

    }


    .register-button i {

        font-size: .88rem;

    }


    .register-button:hover {

        background:
            #0A6C71;

        transform:
            translateY(-1px);

    }


    .register-button:active {

        transform:
            translateY(0);

    }


    /* =========================================================
       LOGIN LINK
    ========================================================== */

    .login-link-area {

        margin-top: 19px;

        padding-top: 17px;

        border-top:
            1px solid
            rgba(183,215,229,.25);

        text-align: center;

        color: #D3E5EC;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .86rem;

        line-height: 1.4;

    }


    .login-link-area a {

        margin-left: 4px;

        color: teal;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .86rem;

        font-weight: 700;

        text-decoration: none;

    }


    .login-link-area a:hover {

        color: #D3E5EC;

        text-decoration: underline;

    }


    /* =========================================================
       VALIDATION
    ========================================================== */

    .field-error {

        display: block;

        margin-top: 5px;

        color: #FFD6D6;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .76rem;

        font-weight: 400;

        line-height: 1.2;

    }


    .validation-summary {

        margin-bottom: 18px;

        padding: 10px 12px;

        border:
            1px solid
            rgba(255,150,150,.40);

        border-radius: 9px;

        background:
            rgba(90,20,20,.30);

        color: #FFE4E4;

        font-family:
            Arial,
            Helvetica,
            sans-serif;

        font-size: .82rem;

        line-height: 1.4;

    }


    .validation-summary ul {

        margin: 0;

        padding-left: 18px;

    }


    /* =========================================================
       DESKTOP
    ========================================================== */

    @@media (min-width: 992px) {

        .register-card {

            max-width: 470px;

            padding:
                38px 40px;

        }


        .register-header {

            margin-bottom:
                25px;

        }


        .register-title {

            font-size:
                1.8rem;

        }


        .register-subtitle {

            font-size:
                .80rem;

        }


        .form-group {

            margin-bottom:
                18px;

        }


        .custom-input {

            height:
                50px;

            min-height:
                50px;

        }


        .register-button {

            height:
                50px;

        }

    }

</style>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                /* =============================================
                   PASSWORD
                ============================================== */

                const passwordInput =
                    document.getElementById(
                        "passwordInput"
                    );

                const togglePassword =
                    document.getElementById(
                        "togglePassword"
                    );

                const passwordIcon =
                    document.getElementById(
                        "passwordIcon"
                    );


                if (
                    passwordInput &&
                    togglePassword &&
                    passwordIcon
                ) {

                    togglePassword.addEventListener(
                        "click",
                        function () {

                            const isPassword =
                                passwordInput.type ===
                                "password";


                            passwordInput.type =
                                isPassword
                                    ? "text"
                                    : "password";


                            passwordIcon.className =
                                isPassword
                                    ? "bi bi-eye-slash"
                                    : "bi bi-eye";


                            togglePassword.setAttribute(
                                "aria-label",
                                isPassword
                                    ? "Hide password"
                                    : "Show password"
                            );

                        }
                    );

                }


                /* =============================================
                   CONFIRM PASSWORD
                ============================================== */

                const confirmPasswordInput =
                    document.getElementById(
                        "confirmPasswordInput"
                    );

                const toggleConfirmPassword =
                    document.getElementById(
                        "toggleConfirmPassword"
                    );

                const confirmPasswordIcon =
                    document.getElementById(
                        "confirmPasswordIcon"
                    );


                if (
                    confirmPasswordInput &&
                    toggleConfirmPassword &&
                    confirmPasswordIcon
                ) {

                    toggleConfirmPassword.addEventListener(
                        "click",
                        function () {

                            const isPassword =
                                confirmPasswordInput.type ===
                                "password";


                            confirmPasswordInput.type =
                                isPassword
                                    ? "text"
                                    : "password";


                            confirmPasswordIcon.className =
                                isPassword
                                    ? "bi bi-eye-slash"
                                    : "bi bi-eye";


                            toggleConfirmPassword.setAttribute(
                                "aria-label",
                                isPassword
                                    ? "Hide confirm password"
                                    : "Show confirm password"
                            );

                        }
                    );

                }

            }
        );

    </script>

}