       ALERTS (TempData messages)
    ============================================================ */

    .alert-box {

        display: flex;

        align-items: center;

        gap: 8px;

        padding: 12px 14px;

        margin-bottom: 15px;

        border-radius: 7px;

        font-size: .73rem;

    }


    .alert-box.success {

        background: #edf5ef;

        border: 1px solid #dcebdd;

        color: #52735b;

    }


    .alert-box.error {

        background: #f8eeee;

        border: 1px solid #efdede;

        color: #955c5c;

    }


    /* ============================================================
       END DARK MODE OVERRIDES
    ============================================================ */

</style>


<div class="programs-page @(isUser ? "user-programs-page" : "")">


    <!-- =====================================================
         ALERTS (TempData success / error messages)
         ===================================================== -->

    @if (TempData["Success"] != null)
    {
        <div class="alert-box success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-box error">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@TempData["Error"]</span>
        </div>
    }


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <section class="programs-header">

        <div class="programs-header-content">

            <div class="programs-title-row">

                <div class="programs-title-icon">

                    <i class="bi bi-calendar-event-fill"></i>

                </div>


                <div>

                    <span class="programs-eyebrow">
                        BARANGAY YOUTH PROGRAM
                    </span>

                    <h1 class="programs-title">
                        Programs
                    </h1>

                    <p class="programs-subtitle">

                        @(isUser
                            ? "Browse available barangay youth programs and activities."
                            : "Create, manage, and monitor youth programs and activities.")

                    </p>

                </div>

            </div>

        </div>


        @if (isAdmin || isStaff)
        {

            <div class="programs-header-action">

                <a asp-controller="Programs"
                   asp-action="Create"
                   class="create-program-button">

                    <i class="bi bi-plus-lg"></i>

                    Create Program

                </a>

            </div>

        }

    </section>


    <!-- =====================================================
         SUMMARY
         ===================================================== -->

    <section class="program-summary">


        <!-- TOTAL -->

        <div class="program-summary-card summary-total">

            <div class="summary-icon">

                <i class="bi bi-calendar-event"></i>

            </div>

            <div>

                <span class="summary-label">

                    @(isUser
                        ? "Available Programs"
                        : "Total Programs")

                </span>

                <strong class="summary-value">
                    @totalPrograms
                </strong>

                <small class="summary-small">
                    Program records
                </small>

            </div>

        </div>


        <!-- ACTIVE -->

        <div class="program-summary-card summary-active">

            <div class="summary-icon">

                <i class="bi bi-play-circle-fill"></i>

            </div>

            <div>

                <span class="summary-label">
                    Active Programs
                </span>

                <strong class="summary-value">
                    @activePrograms
                </strong>

                <small class="summary-small">
                    Currently active
                </small>

            </div>

        </div>


        <!-- INACTIVE -->

        <div class="program-summary-card summary-inactive">

            <div class="summary-icon">

                <i class="bi bi-pause-circle-fill"></i>

            </div>

            <div>

                <span class="summary-label">
                    Inactive Programs
                </span>

                <strong class="summary-value">
                    @inactivePrograms
                </strong>

                <small class="summary-small">
                    Not currently active
                </small>

            </div>

        </div>


        <!-- COMPLETED -->

        <div class="program-summary-card summary-completed">

            <div class="summary-icon">

                <i class="bi bi-check2-circle"></i>

            </div>

            <div>

                <span class="summary-label">
                    Completed
                </span>

                <strong class="summary-value">
                    @completedPrograms
                </strong>

                <small class="summary-small">
                    Completed programs
                </small>

            </div>

        </div>


    </section>


    <!-- =====================================================
         PROGRAM LIST
         ===================================================== -->

    <section class="programs-card">


        <!-- SECTION HEADER -->

        <div class="program-list-header">


            <div class="program-list-title">

                <div class="program-list-icon">

                    <i class="bi bi-table"></i>

                </div>


                <div>

                    <span class="program-list-eyebrow">
                        PROGRAM DIRECTORY
                    </span>

                    <h2>
                        @(isUser
                            ? "Available Programs"
                            : "Program List")
                    </h2>

                    <p>

                        @(isUser
                            ? "Choose a program that you would like to join."
                            : "View and manage youth programs in the system.")

                    </p>

                </div>

            </div>


            <div class="program-count">

                <i class="bi bi-calendar2-week"></i>

                @totalPrograms

                @(totalPrograms == 1
                    ? "Program"
                    : "Programs")

            </div>

        </div>

        <form asp-controller="Programs" asp-action="Index" method="get" class="program-search-form">
            <label for="program-search">Search Programs</label>
            <div class="program-search-controls">
                <input id="program-search" name="search" value="@search" type="search"
                       placeholder="Search programs..." />
                <button type="submit" class="search-button"><i class="bi bi-search"></i> Search</button>
                <a asp-controller="Programs" asp-action="Index" class="reset-button">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </a>
            </div>
        </form>


        @if (!programs.Any())
        {

            <!-- =================================================
                 EMPTY
                 ================================================= -->

            <div class="program-empty">

                <div class="program-empty-icon">

                    <i class="bi bi-calendar-x"></i>

                </div>

                <h3>
                    No Programs Found
                </h3>

                <p>
                    There are currently no youth programs available.
                </p>


            </div>

        }
        else
        {

            <!-- =================================================
                 TABLE
                 ================================================= -->

            <div class="program-table-wrapper">

                <table class="program-table">


                    <thead>

                        <tr>

                            <th>
                                PROGRAM
                            </th>

                            <th>
                                DESCRIPTION
                            </th>

                            <th>
                                SCHEDULE
                            </th>

                            <th>
                                CAPACITY
                            </th>

                            <th>
                                STATUS
                            </th>

                            <th>
                                ACTIONS
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var program in programs)
                        {

                            <tr>


                                <!-- =================================
                                     PROGRAM
                                ================================== -->

                                <td>

                                    <div class="program-name-wrapper">

                                        <div class="program-icon">

                                            <i class="bi bi-calendar-event"></i>

                                        </div>


                                        <div>

                                            <div class="program-name">

                                                @program.Name

                                            </div>

                                            <div class="program-label">

                                                Youth Program

                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- =================================
                                     DESCRIPTION
                                ================================== -->

                                <td>

                                    @if (string.IsNullOrWhiteSpace(
                                        program.Description))
                                    {

                                        <span class="no-description">

                                            No description provided.

                                        </span>

                                    }
                                    else
                                    {

                                        <div class="program-description">

                                            @program.Description

                                        </div>

                                    }

                                </td>


                                <!-- =================================
                                     SCHEDULE
                                ================================== -->

                                <td>

                                    <div class="program-schedule">

                                        <i class="bi bi-clock-fill"></i>

                                        <span class="program-schedule-text">

                                            @program.Schedule

                                            @if (program.ScheduleStart.HasValue && program.ScheduleEnd.HasValue)
                                            {
                                                <span class="program-schedule-datetime">

                                                    @(program.ScheduleStart.Value.ToString("MMM d, yyyy h:mm tt")) – @(program.ScheduleEnd.Value.ToString("MMM d, yyyy h:mm tt"))

                                                </span>
                                            }
                                            else if (program.ScheduleStart.HasValue)
                                            {
                                                <span class="program-schedule-datetime">

                                                    Starts: @(program.ScheduleStart.Value.ToString("MMM d, yyyy h:mm tt"))

                                                </span>
                                            }

                                            <span class="program-schedule-datetime">

                                                <i class="bi bi-alarm"></i>

                                                @AttendanceSchedule.WindowsText(program)

                                            </span>

                                        </span>

                                    </div>

                                </td>


                                <!-- =================================
                                     CAPACITY
                                ================================== -->

                                <td>

                                    <span class="capacity-value">

                                        <i class="bi bi-people-fill"></i>

                                        @program.Capacity

                                    </span>

                                </td>


                                <!-- =================================
                                     STATUS
                                ================================== -->

                                <td>

                                    @if (program.Status == "Active")
                                    {

                                        <span class="program-status status-active">

                                            <span class="status-dot"></span>

                                            Active

                                        </span>

                                    }
                                    else if (program.Status == "Completed")
                                    {

                                        <span class="program-status status-completed">

                                            <span class="status-dot"></span>

                                            Completed

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="program-status status-inactive">

                                            <span class="status-dot"></span>

                                            @program.Status

                                        </span>

                                    }

                                </td>


                                <!-- =================================
                                     ACTIONS
                                ================================== -->

                                <td>

                                    <div class="program-actions">


                                        <!-- VIEW DETAILS -->

                                        <a asp-controller="Programs"
                                           asp-action="Details"
                                           asp-route-id="@program.Id"
                                           class="program-action action-view"
                                           title="View Details">

                                            <i class="bi bi-eye-fill"></i>

                                        </a>


                                        @if (isUser)
                                        {

                                            <!-- REGISTER -->

                                            @if (program.Status == "Active")
                                            {

                                                <a asp-controller="Registration"
                                                   asp-action="Register"
                                                   asp-route-programId="@program.Id"
                                                   class="program-action action-register"
                                                   title="Register">

                                                    <i class="bi bi-person-plus-fill"></i>

                                                </a>

                                            }

                                        }
                                        else
                                        {

                                            <!-- EDIT -->

                                            <a asp-controller="Programs"
                                               asp-action="Edit"
                                               asp-route-id="@program.Id"
                                               class="program-action action-edit"
                                               title="Edit">

                                                <i class="bi bi-pencil-fill"></i>

                                            </a>


                                            <!-- ACTIVATE / DEACTIVATE -->

                                            <form asp-controller="Programs"
                                                  asp-action="SetStatus"
                                                  asp-route-id="@program.Id"
                                                  method="post"
                                                  class="program-action-form">

                                                @Html.AntiForgeryToken()


                                                @if (program.Status == "Active")
                                                {

                                                    <input type="hidden"
                                                           name="status"
                                                           value="Inactive" />

                                                    <button type="submit"
                                                            class="program-action action-status"
                                                            title="Deactivate">

                                                        <i class="bi bi-pause-circle-fill"></i>

                                                    </button>

                                                }
                                                else
                                                {

                                                    <input type="hidden"
                                                           name="status"
                                                           value="Active" />

                                                    <button type="submit"
                                                            class="program-action action-status"
                                                            title="Activate">

                                                        <i class="bi bi-play-circle-fill"></i>

                                                    </button>

                                                }

                                            </form>


                                            <!-- DELETE -->

                                            @if (isAdmin)
                                            {

                                                <form asp-controller="Programs"
                                                      asp-action="Delete"
                                                      asp-route-id="@program.Id"
                                                      method="post"
                                                      class="program-action-form"
                                                      onsubmit="return confirm('Delete Program Permanently?\n\nThis action permanently deletes the selected program and its associated registrations, attendance records, photo submissions, and exclusively linked certificates or related data. This action cannot be undone.\n\nClick OK to delete permanently, or Cancel to keep it.');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="program-action action-delete"
                                                            title="Delete">

                                                        <i class="bi bi-trash-fill"></i>

                                                    </button>

                                                </form>

                                            }

                                        }

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }

    </section>


</div>

<style>
    .program-search-form { margin: 0 0 12px; }
    .program-search-form label { display:block; margin-bottom:6px; color:#b7d7e5; font-size:10px; font-weight:700; }
    .program-search-controls { display:flex; gap:8px; align-items:center; }
    .program-search-controls input { flex:1; min-width:0; height:38px; padding:0 11px; border:1px solid rgba(183,215,229,.25); border-radius:8px; background:rgba(104,157,184,.08); color:#fff; }
    .program-search-controls button, .program-search-controls a { height:38px; padding:0 13px; display:inline-flex; align-items:center; gap:5px; border:1px solid #0c9096; border-radius:8px; background:#0c9096; color:#fff; font-size:10px; font-weight:700; text-decoration:none; }
    .program-search-controls a { background:transparent; border-color:rgba(183,215,229,.25); color:#b7d7e5; }
    .user-programs-page { background:linear-gradient(135deg,#f5fbff 0%,#f9f5ff 52%,#f1fff8 100%); color:#21344a; }
    .user-programs-page .programs-header, .user-programs-page .programs-card, .user-programs-page .program-summary-card { background:rgba(255,255,255,.88); border-color:rgba(68,105,140,.14); box-shadow:0 8px 24px rgba(36,78,113,.08); }
    .user-programs-page .programs-title, .user-programs-page .program-list-title h2, .user-programs-page .program-table td { color:#1f3650; }
    .user-programs-page .programs-subtitle, .user-programs-page .program-list-title p, .user-programs-page .summary-label { color:#61758c; }
    .user-programs-page .program-summary { grid-template-columns:repeat(4,minmax(0,1fr)); }
    .user-programs-page .program-table th { background:#eef7fb; color:#48647c; }
    .user-programs-page .program-search-form label { color:#4b657d; }
    .user-programs-page .program-search-controls input { background:#fff; border-color:#d7e4ee; color:#1f3650; }
    /* Header geometry is owned by the shared .programs-header rules in theme.css. */
    /* Light-mode readability: inner text still uses dark-theme pale colors */
    html[data-theme="light"] .user-programs-page .programs-eyebrow { color:#0c9096; }
    html[data-theme="light"] .user-programs-page .summary-label, html[data-theme="light"] .user-programs-page .summary-small { color:#61758c; }
    html[data-theme="light"] .user-programs-page .summary-value { color:#1f3650; }
    html[data-theme="light"] .user-programs-page .summary-icon { background:rgba(12,144,150,.10); color:#0c9096; }
    html[data-theme="light"] .user-programs-page .programs-count { color:#4b657d; background:rgba(68,105,140,.08); }
    html[data-theme="light"] .user-programs-page .program-action { background:#eef7fb; border-color:#d7e4ee; color:#0c9096; }
    html[data-theme="light"] .user-programs-page .action-delete { color:#dc3545; }
    /* Dark-mode status badges keep readable backgrounds; icons on dark header */
    html[data-theme="dark"] .user-programs-page .programs-title-icon { color:#8DDCF2; background:rgba(105,199,232,.10); }
    html[data-theme="light"] .program-empty { min-height:140px !important; }
    @@media (max-width: 1050px) { .user-programs-page .program-summary { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @@media (max-width: 640px) { .program-search-controls { flex-wrap:wrap; } .program-search-controls input { flex-basis:100%; } }
    @@media (max-width: 700px) { .program-summary, .user-programs-page .program-summary { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @@media (max-width: 520px) { .program-summary, .user-programs-page .program-summary { grid-template-columns:1fr; } .programs-header { flex-direction:column; align-items:stretch; } .programs-header-action a { width:100%; justify-content:center; } }
</style>
