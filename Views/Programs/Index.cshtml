@model IEnumerable<BYPManagementSystem.Models.YouthProgram>

@{
    ViewData["Title"] = "Programs";

    bool isUser = User.IsInRole("User");
    bool isAdmin = User.IsInRole("Admin");
    bool isStaff = User.IsInRole("Staff");

    var programs =
        Model?.ToList()
        ?? new List<BYPManagementSystem.Models.YouthProgram>();

    var search = ViewBag.Search as string ?? "";

    int totalPrograms = programs.Count;

    int activePrograms =
        programs.Count(p => p.Status == "Active");

    int inactivePrograms =
        programs.Count(p =>
            p.Status != "Active" &&
            p.Status != "Completed");

    int completedPrograms =
        programs.Count(p =>
            p.Status == "Completed");
}


