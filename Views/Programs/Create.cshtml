@model BYPManagementSystem.Models.YouthProgram

@{
    ViewData["Title"] = "Create Program";
}

<div class="program-form-page">

    <!-- ==========================================================
         HEADER
         ========================================================== -->

    <section class="form-header">

        <div class="form-header-icon">
            <i class="bi bi-calendar-plus-fill"></i>
        </div>

        <div class="form-header-content">

            <span class="form-header-kicker">
                PROGRAM MANAGEMENT
            </span>

            <h1>
                Create Youth Program
            </h1>

            <p>
                Add a new youth program and define the Barangay used
                for automatic participant assignment.
            </p>

        </div>

        <a asp-action="Index"
           class="form-back-button">

            <i class="bi bi-arrow-left"></i>

            Back to Programs

        </a>

    </section>


    <!-- ==========================================================
         INFORMATION
         ========================================================== -->

    <div class="info-box">

        <div class="info-box-icon">
            <i class="bi bi-lightbulb-fill"></i>
        </div>

        <div class="info-box-content">

            <strong>
                Automatic Barangay Assignment
            </strong>

            <p>
                After this program is saved, active youth participants
                whose Barangay matches this program's Barangay can be
                automatically connected through a Program Registration.
            </p>

        </div>

    </div>


    <!-- ==========================================================
         VALIDATION
         ========================================================== -->

    <div asp-validation-summary="All"
         class="validation-summary">
    </div>


    <!-- ==========================================================
         FORM CARD
         ========================================================== -->

    <div class="form-card">

        <div class="form-card-header">

            <div class="form-section-icon">
                <i class="bi bi-calendar-event-fill"></i>
            </div>

            <div>

                <h2>
                    Program Information
                </h2>

                <p>
                    Enter the details for the new youth program.
                </p>

            </div>

        </div>


        <form asp-action="Create"
              method="post"
              class="program-form">

            @Html.AntiForgeryToken()


            <!-- ==================================================
                 ROW 1 - PROGRAM NAME (full width)
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Name">
                    Program Name
                    <span class="required">*</span>
                </label>

                <div class="field-wrapper">

                    <i class="bi bi-calendar-event"></i>

                    <input asp-for="Name"
                           class="form-control"
                           maxlength="150"
                           placeholder="Enter youth program name" />

                </div>

                <span asp-validation-for="Name"
                      class="field-error">
                </span>

            </div>


            <!-- ==================================================
                 ROW 2 - DESCRIPTION (full width, character-limit
                 helper aligned to the right)
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Description">
                    Description
                    <small>Optional</small>
                </label>

                <div class="field-wrapper textarea-wrapper">

                    <i class="bi bi-card-text"></i>

                    <textarea asp-for="Description"
                              class="form-control textarea-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Describe the youth program..."></textarea>

                </div>

                <div class="field-bottom">

                    <span asp-validation-for="Description"
                          class="field-error">
                    </span>

                    <span class="character-limit">
                        Maximum 1000 characters
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 ROW 3 - PROGRAM DATE / START / END TIME
                 Three-column responsive row on desktop; the
                 structured schedule the attendance windows are
                 validated against.
                 ================================================== -->

            <div class="form-row form-row-three schedule-picker-row">

                <!-- PROGRAM DATE -->

                <div class="form-group">

                    <label for="ProgramDate">
                        Program Schedule Date
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-calendar3"></i>

                        <input type="date"
                               name="ProgramDate"
                               id="ProgramDate"
                               class="form-control"
                               value="@(ViewBag.ProgramDate as string ?? Model.ScheduleStart?.ToString("yyyy-MM-dd"))" />

                    </div>

                    @Html.ValidationMessage(
                        "ProgramDate",
                        new { @class = "field-error" })

                </div>


                <!-- PROGRAM START TIME -->

                <div class="form-group">

                    <label for="ScheduleStartTime">
                        Program Start Time
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-alarm"></i>

                        <input type="time"
                               name="ScheduleStartTime"
                               id="ScheduleStartTime"
                               class="form-control"
                               value="@(ViewBag.ScheduleStartTime as string ?? Model.ScheduleStart?.ToString("HH:mm"))" />

                    </div>

                    @Html.ValidationMessage(
                        "ScheduleStartTime",
                        new { @class = "field-error" })

                </div>


                <!-- PROGRAM END TIME -->

                <div class="form-group">

                    <label for="ScheduleEndTime">
                        Program End Time
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-hourglass-split"></i>

                        <input type="time"
                               name="ScheduleEndTime"
                               id="ScheduleEndTime"
                               class="form-control"
                               value="@(ViewBag.ScheduleEndTime as string ?? Model.ScheduleEnd?.ToString("HH:mm"))" />

                    </div>

                    @Html.ValidationMessage(
                        "ScheduleEndTime",
                        new { @class = "field-error" })

                </div>

            </div>


            <!-- ==================================================
                 ATTENDANCE SCHEDULE
                 Admin-configurable Morning and Afternoon windows in
                 the configured application time zone, grouped in a
                 two-column card grid: Morning In/Out on the first
                 row, Afternoon In/Out on the second. Defaults apply
                 to newly created programs only.
                 ================================================== -->

            <div class="form-subsection">

                <div class="form-subsection-title">
                    <i class="bi bi-clock-fill"></i>
                    <strong>
                        Attendance Schedule
                    </strong>
                </div>

                <span class="field-help">

                    <i class="bi bi-info-circle"></i>

                    The Admin can configure the Morning and Afternoon
                    attendance times below. Allowed submission windows
                    (@AttendanceSchedule.ZoneLabel). These defaults
                    initialize new programs only - saved values always
                    win.

                </span>

            </div>


            <div class="attendance-grid">

                <!-- MORNING TIME IN -->

                <div class="attendance-window-card session-morning">

                    <div class="window-card-header">

                        <div class="window-icon">
                            <i class="bi bi-sunrise"></i>
                        </div>

                        <strong class="window-card-title">
                            Morning Time In
                        </strong>

                    </div>

                    <div class="window-inputs schedule-picker-row">

                        <div class="form-group">

                            <label for="TimeInStart">
                                Start Time
                            </label>

                            <div class="field-wrapper">

                                <i class="bi bi-box-arrow-in-right"></i>

                                <input type="time"
                                       name="TimeInStart"
                                       id="TimeInStart"
                                       class="form-control"
                                       value="@Model.TimeInStart.ToString("HH:mm")" />

                            </div>

                            <span class="field-help">

                                <i class="bi bi-info-circle"></i>

                                Morning Time In opens.

                            </span>

                            <span asp-validation-for="TimeInStart"
                                  class="field-error">
                            </span>

                        </div>

                        <div class="form-group">

                            <label for="TimeInEnd">
                                End Time
                            </label>

                            <div class="field-wrapper">

                                <i class="bi bi-hourglass-split"></i>

                                <input type="time"
                                       name="TimeInEnd"
                                       id="TimeInEnd"
                                       class="form-control"
                                       value="@Model.TimeInEnd.ToString("HH:mm")" />

                            </div>

                            <span class="field-help">

                                <i class="bi bi-info-circle"></i>

                                Morning Time In closes (inclusive).

                            </span>

                            <span asp-validation-for="TimeInEnd"
                                  class="field-error">
                            </span>

                        </div>

                    </div>

                    <span class="window-example">
                        <i class="bi bi-info-circle"></i>
                        Example: 7:00–8:30 AM (Morning)
                    </span>

                </div>


                <!-- MORNING TIME OUT -->

                <div class="attendance-window-card session-morning">

                    <div class="window-card-header">

                        <div class="window-icon">
                            <i class="bi bi-sunrise"></i>
                        </div>

                        <strong class="window-card-title">
                            Morning Time Out
                        </strong>

                    </div>

                    <div class="window-inputs schedule-picker-row">

                        <div class="form-group">

                            <label for="TimeOutStart">
                                Start Time
                            </label>

                            <div class="field-wrapper">

                                <i class="bi bi-box-arrow-right"></i>

                                <input type="time"
                                       name="TimeOutStart"
                                       id="TimeOutStart"
                                       class="form-control"
                                       value="@Model.TimeOutStart.ToString("HH:mm")" />

                            </div>

                            <span class="field-help">

                                <i class="bi bi-info-circle"></i>

                                Morning Time Out opens.

                            </span>

                            <span asp-validation-for="TimeOutStart"
                                  class="field-error">
                            </span>

                        </div>

                        <div class="form-group">

                            <label for="TimeOutEnd">
                                End Time
                            </label>

                            <div class="field-wrapper">

                                <i class="bi bi-hourglass-bottom"></i>

                                <input type="time"
                                       name="TimeOutEnd"
                                       id="TimeOutEnd"
                                       class="form-control"
                                       value="@Model.TimeOutEnd.ToString("HH:mm")" />

                            </div>

                            <span class="field-help">

                                <i class="bi bi-info-circle"></i>

                                Morning Time Out closes (inclusive).

                            </span>

                            <span asp-validation-for="TimeOutEnd"
                                  class="field-error">
                            </span>

                        </div>

                    </div>

                    <span class="window-example">
                        <i class="bi bi-info-circle"></i>
                        Example: 10:30–11:30 AM (Morning)
                    </span>

                </div>


                <!-- AFTERNOON TIME IN -->

                <div class="attendance-window-card session-afternoon">

                    <div class="window-card-header">

                        <div class="window-icon">
                            <i class="bi bi-sun"></i>
                        </div>

                        <strong class="window-card-title">
                            Afternoon Time In
                        </strong>

                    </div>

                    <div class="window-inputs schedule-picker-row">

                        <div class="form-group">

                            <label for="AfternoonInStart">
                                Start Time
                            </label>

                            <div class="field-wrapper">

                                <i class="bi bi-box-arrow-in-right"></i>

                                <input type="time"
                                       name="AfternoonInStart"
                                       id="AfternoonInStart"
                                       class="form-control"
                                       value="@Model.AfternoonInStart.ToString("HH:mm")" />

                            </div>

                            <span class="field-help">

                                <i class="bi bi-info-circle"></i>

                                Afternoon Time In opens.

                            </span>

                            <span asp-validation-for="AfternoonInStart"
                                  class="field-error">
                            </span>

                        </div>

                        <div class="form-group">

                            <label for="AfternoonInEnd">
                                End Time
                            </label>

                            <div class="field-wrapper">

                                <i class="bi bi-hourglass-split"></i>

                                <input type="time"
                                       name="AfternoonInEnd"
                                       id="AfternoonInEnd"
                                       class="form-control"
                                       value="@Model.AfternoonInEnd.ToString("HH:mm")" />

                            </div>

                            <span class="field-help">

                                <i class="bi bi-info-circle"></i>

                                Afternoon Time In closes (inclusive).

                            </span>

                            <span asp-validation-for="AfternoonInEnd"
                                  class="field-error">
                            </span>

                        </div>

                    </div>

                    <span class="window-example">
                        <i class="bi bi-info-circle"></i>
                        Example: 1:00–2:00 PM (Afternoon)
                    </span>

                </div>


                <!-- AFTERNOON TIME OUT -->

                <div class="attendance-window-card session-afternoon">

                    <div class="window-card-header">

                        <div class="window-icon">
                            <i class="bi bi-sun"></i>
                        </div>

                        <strong class="window-card-title">
                            Afternoon Time Out
                        </strong>

                    </div>

                    <div class="window-inputs schedule-picker-row">

                        <div class="form-group">

                            <label for="AfternoonOutStart">
                                Start Time
                            </label>

                            <div class="field-wrapper">

                                <i class="bi bi-box-arrow-right"></i>

                                <input type="time"
                                       name="AfternoonOutStart"
                                       id="AfternoonOutStart"
                                       class="form-control"
                                       value="@Model.AfternoonOutStart.ToString("HH:mm")" />

                            </div>

                            <span class="field-help">

                                <i class="bi bi-info-circle"></i>

                                Afternoon Time Out opens.

                            </span>

                            <span asp-validation-for="AfternoonOutStart"
                                  class="field-error">
                            </span>

                        </div>

                        <div class="form-group">

                            <label for="AfternoonOutEnd">
                                End Time
                            </label>

                            <div class="field-wrapper">

                                <i class="bi bi-hourglass-bottom"></i>

                                <input type="time"
                                       name="AfternoonOutEnd"
                                       id="AfternoonOutEnd"
                                       class="form-control"
                                       value="@Model.AfternoonOutEnd.ToString("HH:mm")" />

                            </div>

                            <span class="field-help">

                                <i class="bi bi-info-circle"></i>

                                Afternoon Time Out closes (inclusive).

                            </span>

                            <span asp-validation-for="AfternoonOutEnd"
                                  class="field-error">
                            </span>

                        </div>

                    </div>

                    <span class="window-example">
                        <i class="bi bi-info-circle"></i>
                        Example: 4:00–5:00 PM (Afternoon)
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 BARANGAY / CAPACITY / PROGRAM STATUS
                 One aligned responsive row: Barangay widest,
                 Capacity and Status medium.
                 ================================================== -->

            <div class="form-row meta-fields-row">

                <!-- BARANGAY -->

                <div class="form-group barangay-group">

                    <label asp-for="Barangay">
                        Barangay
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-geo-alt-fill"></i>

                        <input asp-for="Barangay"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter Barangay" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-magic"></i>

                        Active youth participants from the same Barangay
                        can be automatically assigned to this program.

                    </span>

                    <span asp-validation-for="Barangay"
                          class="field-error">
                    </span>

                </div>


                <!-- CAPACITY -->

                <div class="form-group">

                    <label asp-for="Capacity">
                        Capacity
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-people-fill"></i>

                        <input asp-for="Capacity"
                               type="number"
                               min="1"
                               max="100000"
                               class="form-control"
                               placeholder="Enter participant capacity" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Maximum number of approved youth participants.

                    </span>

                    <span asp-validation-for="Capacity"
                          class="field-error">
                    </span>

                </div>


                <!-- PROGRAM STATUS -->

                <div class="form-group">

                    <label asp-for="Status">
                        Program Status
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-toggle-on"></i>

                        <select asp-for="Status"
                                class="form-control">

                            <option value="Active">
                                Active
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Active programs are available for current use.

                    </span>

                    <span asp-validation-for="Status"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 AUTO ASSIGNMENT PREVIEW
                 Icon, heading, and flow stages on aligned rows
                 with clear spacing.
                 ================================================== -->

            <div class="assignment-preview">

                <div class="assignment-preview-icon">

                    <i class="bi bi-diagram-3-fill"></i>

                </div>

                <div class="assignment-preview-content">

                    <strong>
                        How automatic assignment works
                    </strong>

                    <div class="assignment-flow">

                        <span>
                            <i class="bi bi-geo-alt-fill"></i>
                            Program Barangay
                        </span>

                        <i class="bi bi-arrow-right"></i>

                        <span>
                            <i class="bi bi-people-fill"></i>
                            Active Youth with matching Barangay
                        </span>

                        <i class="bi bi-arrow-right"></i>

                        <span>
                            <i class="bi bi-journal-check"></i>
                            Program Registration
                        </span>

                    </div>

                </div>

            </div>


            <!-- ==================================================
                 ACTIONS (bottom-right, above the stepper)
                 ================================================== -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">

                    <i class="bi bi-x-lg"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="save-button"
                        id="createProgramSubmit">

                    <i class="bi bi-check-lg"></i>

                    Create Program

                </button>

            </div>

        </form>

    </div>


    <!-- ==========================================================
         WORKFLOW
         ========================================================== -->

    <div class="workflow-card">

        <div class="workflow-step active">

            <div class="step-number">
                1
            </div>

            <span>
                Create Program
            </span>

        </div>


        <div class="step-line"></div>


        <div class="workflow-step">

            <div class="step-number">
                2
            </div>

            <span>
                Match Barangay
            </span>

        </div>


        <div class="step-line"></div>


        <div class="workflow-step">

            <div class="step-number">
                3
            </div>

            <span>
                Assign Youth
            </span>

        </div>


        <div class="step-line"></div>


        <div class="workflow-step">

            <div class="step-number">
                4
            </div>

            <span>
                Attendance
            </span>

        </div>

    </div>

</div>


<!-- ==========================================================
     SCHEDULE DATE/TIME VALIDATION (client-side)
     ========================================================== -->

<script>
    (function () {
        var form = document.querySelector('form.program-form');

        if (!form) { return; }

        // Prevent accidental duplicate submission when the "Create
        // Program" button is clicked (or double-clicked) more than
        // once. The button is only disabled after the form actually
        // submits; a rejected validation keeps it clickable.

        form.addEventListener('submit', function () {
            var submitButton =
                document.getElementById('createProgramSubmit');

            if (submitButton &&
                typeof form.checkValidity === 'function' &&
                form.checkValidity()) {
                submitButton.disabled = true;
            }
        });


</script>


<style>

/* =========================================================
   COMPACT FORM PAGE - Matches Admin Dashboard density
   ========================================================= */

.program-form-page {

    width: 100%;
    padding: 12px 18px 18px;
    box-sizing: border-box;

}

/* Consistent box model for every element on this page only. */
.program-form-page,
.program-form-page * {
    box-sizing: border-box;
}


/* =========================================================
   HEADER
   ========================================================= */

.form-header {

    display: flex;
    align-items: center;
    gap: 14px;

    padding: 14px 18px;

    margin-bottom: 8px;

    border-radius: 13px;

    background:
        linear-gradient(
            110deg,
            rgba(12,144,150,.25),
            rgba(5,45,46,.82)
        );

    border:
        1px solid
        rgba(183,215,229,.16);

    box-shadow:
        0 8px 20px
        rgba(0,0,0,.14);

    color: #FFFFFF;
}


.form-header-icon {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: rgba(255,255,255,.09);
    border: 1px solid rgba(255,255,255,.13);

    color: #69DDF2;
    font-size: 16px;
}


.form-header-content {
    flex: 1;
    min-width: 0;
}


.form-header-kicker {
    display: block;
    margin-bottom: 4px;
    color: #A9D5DE;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}


.form-header h1 {
    margin: 0;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
}


.form-header p {
    margin: 3px 0 0;
    color: #C5DDE2;
    font-size: 13px;
    line-height: 1.4;
}


.form-back-button {

    min-height: 30px;
    padding: 0 10px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;

    border-radius: 7px;
    border: 1px solid rgba(183,215,229,.16);
    background: rgba(255,255,255,.06);
    color: #C5DDE2;

    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    transition: .16s ease;
}


.form-back-button:hover {
    color: #FFFFFF;
    background: rgba(255,255,255,.10);
    text-decoration: none;
    transform: translateY(-1px);
}


/* =========================================================
   INFO BOX
   ========================================================= */

.info-box {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 11px;
    margin-top: 8px;
    margin-bottom: 8px;
    border-radius: 8px;
    background: rgba(105,199,232,.08);
    border: 1px solid rgba(105,199,232,.14);
}

.info-box-icon { color: #69DDF2; font-size: 14px; flex-shrink: 0; }

.info-box-content {
    min-width: 0;
}

.info-box-content strong {
    display: block;
    margin-bottom: 2px;
    color: #FFFFFF;
    font-size: 13px;
}

.info-box-content p {
    margin: 0;
    color: #769BA3;
    font-size: 12px;
    line-height: 1.4;
}


/* =========================================================
   VALIDATION
   ========================================================= */

.validation-summary {
    padding: 7px 10px;
    margin-bottom: 8px;
    border-radius: 7px;
    background: rgba(255,123,138,.10);
    border: 1px solid rgba(255,123,138,.18);
    color: #FF7B8A;
    font-size: 12px;
}
.validation-summary:empty { display: none; }


/* =========================================================
   FORM CARD
   ========================================================= */

.form-card {
    margin-top: 8px;
    margin-bottom: 8px;
    border-radius: 11px;
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        );
    border: 1px solid rgba(183,215,229,.14);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
}

.form-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(183,215,229,.12);
}

.form-section-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(105,199,232,.10);
    border: 1px solid rgba(105,199,232,.12);
    color: #69DDF2;
    font-size: 15px;
}

.form-card-header h2 {
    margin: 0 0 1px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.1;
}

.form-card-header p {
    margin: 0;
    color: #769BA3;
    font-size: 12px;
}

.form-card-body { padding: 10px 12px; }


/* =========================================================
   FORM
   ========================================================= */

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

/* Program Date / Start / End in one aligned row (3 columns). */
.form-row.form-row-three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* Barangay (widest) + Capacity + Status on one aligned row. */
.form-row.meta-fields-row {
