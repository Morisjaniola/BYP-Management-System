@model BYPManagementSystem.Models.YouthProgram

@{
    ViewData["Title"] = "Create Program";
}

<div class="program-form-page">

    <!-- ==========================================================
         HEADER
         ========================================================== -->

    <section class="form-header">

        <div class="form-header-icon">
            <i class="bi bi-calendar-plus-fill"></i>
        </div>

        <div class="form-header-content">

            <span class="form-header-kicker">
                PROGRAM MANAGEMENT
            </span>

            <h1>
                Create Youth Program
            </h1>

            <p>
                Add a new youth program and define the Barangay used
                for automatic participant assignment.
            </p>

        </div>

        <a asp-action="Index"
           class="form-back-button">

            <i class="bi bi-arrow-left"></i>

            Back to Programs

        </a>

    </section>


    <!-- ==========================================================
         INFORMATION
         ========================================================== -->

    <div class="info-box">

        <div class="info-box-icon">
            <i class="bi bi-lightbulb-fill"></i>
        </div>

        <div class="info-box-content">

            <strong>
                Automatic Barangay Assignment
            </strong>

            <p>
                After this program is saved, active youth participants
                whose Barangay matches this program's Barangay can be
                automatically connected through a Program Registration.
            </p>

        </div>

    </div>


    <!-- ==========================================================
         VALIDATION
         ========================================================== -->

    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>


    <!-- ==========================================================
         FORM CARD
         ========================================================== -->

    <div class="form-card">

        <div class="form-card-header">

            <div class="form-section-icon">
                <i class="bi bi-calendar-event-fill"></i>
            </div>

            <div>

                <h2>
                    Program Information
                </h2>

                <p>
                    Enter the details for the new youth program.
                </p>

            </div>

        </div>


        <form asp-action="Create"
              method="post"
              class="program-form">

            @Html.AntiForgeryToken()


            <!-- ==================================================
                 PROGRAM NAME
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Name">
                    Program Name
                    <span class="required">*</span>
                </label>

                <div class="field-wrapper">

                    <i class="bi bi-calendar-event"></i>

                    <input asp-for="Name"
                           class="form-control"
                           maxlength="150"
                           placeholder="Enter youth program name" />

                </div>

                <span asp-validation-for="Name"
                      class="field-error">
                </span>

            </div>


            <!-- ==================================================
                 DESCRIPTION
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Description">
                    Description
                    <small>Optional</small>
                </label>

                <div class="field-wrapper textarea-wrapper">

                    <i class="bi bi-card-text"></i>

                    <textarea asp-for="Description"
                              class="form-control textarea-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Describe the youth program..."></textarea>

                </div>

                <div class="field-bottom">

                    <span asp-validation-for="Description"
                          class="field-error">
                    </span>

                    <span class="character-limit">
                        Maximum 1000 characters
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 SCHEDULE
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Schedule">
                    Schedule
                    <span>*</span>
                </label>

                <div class="field-wrapper">

                    <i class="bi bi-clock-fill"></i>

                    <input asp-for="Schedule"
                           class="form-control"
                           maxlength="250"
                           placeholder="Example: Every Saturday, 8:00 AM - 12:00 PM" />

                </div>

                <span asp-validation-for="Schedule"
                      class="field-error">
                </span>

            </div>


            <!-- ==================================================
                 SCHEDULE START / END DATE TIME PICKERS
                 ================================================== -->

            <div class="form-row schedule-picker-row">

                <!-- START -->

                <div class="form-group">

                    <label asp-for="ScheduleStart">
                        Schedule Start Date &amp; Time
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-alarm"></i>

                        <input asp-for="ScheduleStart"
                               type="datetime-local"
                               class="form-control"
                               id="ScheduleStart"
                               data-schedule-start="true" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Optional structured start date and time.

                    </span>

                    <span asp-validation-for="ScheduleStart"
                          class="field-error">
                    </span>

                </div>


                <!-- END -->

                <div class="form-group">

                    <label asp-for="ScheduleEnd">
                        Schedule End Date &amp; Time
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-hourglass-split"></i>

                        <input asp-for="ScheduleEnd"
                               type="datetime-local"
                               class="form-control"
                               id="ScheduleEnd"
                               data-schedule-end="true" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Optional. Must be after the start date and time.

                    </span>

                    <span asp-validation-for="ScheduleEnd"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 ATTENDANCE WINDOWS
                 Allowed submission windows in Philippine time.
                 Defaults: Time In 7:00-8:30 AM, Time Out
                 10:30-11:30 AM.
                 ================================================== -->

            <div class="form-row schedule-picker-row">

                <!-- TIME IN START -->

                <div class="form-group">

                    <label for="TimeInStart">
                        Time In Window Start
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-box-arrow-in-right"></i>

                        <input type="time"
                               name="TimeInStart"
                               id="TimeInStart"
                               class="form-control"
                               value="@Model.TimeInStart.ToString("HH:mm")" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Morning Time In opens (Philippine time).

                    </span>

                    <span asp-validation-for="TimeInStart"
                          class="field-error">
                    </span>

                </div>


                <!-- TIME IN END -->

                <div class="form-group">

                    <label for="TimeInEnd">
                        Time In Window End
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-hourglass-split"></i>

                        <input type="time"
                               name="TimeInEnd"
                               id="TimeInEnd"
                               class="form-control"
                               value="@Model.TimeInEnd.ToString("HH:mm")" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Morning Time In closes (inclusive).

                    </span>

                    <span asp-validation-for="TimeInEnd"
                          class="field-error">
                    </span>

                </div>


                <!-- TIME OUT START -->

                <div class="form-group">

                    <label for="TimeOutStart">
                        Time Out Window Start
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-box-arrow-right"></i>

                        <input type="time"
                               name="TimeOutStart"
                               id="TimeOutStart"
                               class="form-control"
                               value="@Model.TimeOutStart.ToString("HH:mm")" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Morning Time Out opens (inclusive).

                    </span>

                    <span asp-validation-for="TimeOutStart"
                          class="field-error">
                    </span>

                </div>


                <!-- TIME OUT END -->

                <div class="form-group">

                    <label for="TimeOutEnd">
                        Time Out Window End
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-hourglass-bottom"></i>

                        <input type="time"
                               name="TimeOutEnd"
                               id="TimeOutEnd"
                               class="form-control"
                               value="@Model.TimeOutEnd.ToString("HH:mm")" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Morning Time Out closes (inclusive).

                    </span>

                    <span asp-validation-for="TimeOutEnd"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 BARANGAY
                 ================================================== -->

            <div class="form-group barangay-group">

                <label asp-for="Barangay">
                    Barangay
                    <span>*</span>
                </label>

                <div class="field-wrapper">

                    <i class="bi bi-geo-alt-fill"></i>

                    <input asp-for="Barangay"
                           class="form-control"
                           maxlength="100"
                           placeholder="Enter Barangay" />

                </div>

                <span class="field-help">

                    <i class="bi bi-magic"></i>

                    Active youth participants from the same Barangay
                    can be automatically assigned to this program.

                </span>

                <span asp-validation-for="Barangay"
                      class="field-error">
                </span>

            </div>


            <!-- ==================================================
                 CAPACITY / STATUS
                 ================================================== -->

            <div class="form-row">

                <!-- CAPACITY -->

                <div class="form-group">

                    <label asp-for="Capacity">
                        Capacity
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-people-fill"></i>

                        <input asp-for="Capacity"
                               type="number"
                               min="1"
                               max="100000"
                               class="form-control"
                               placeholder="Enter participant capacity" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Maximum number of approved youth participants.

                    </span>

                    <span asp-validation-for="Capacity"
                          class="field-error">
                    </span>

                </div>


                <!-- STATUS -->

                <div class="form-group">

                    <label asp-for="Status">
                        Program Status
                        <span>*</span>
                    </label>

                    <select asp-for="Status"
                            class="form-control">

                        <option value="Active">
                            Active
                        </option>

                        <option value="Inactive">
                            Inactive
                        </option>

                    </select>

                    <span class="field-help">

                        <i class="bi bi-toggle-on"></i>

                        Active programs are available for current use.

                    </span>

                    <span asp-validation-for="Status"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 AUTO ASSIGNMENT PREVIEW
                 ================================================== -->

            <div class="assignment-preview">

                <div class="assignment-preview-icon">

                    <i class="bi bi-diagram-3-fill"></i>

                </div>

                <div class="assignment-preview-content">

                    <strong>
                        How automatic assignment works
                    </strong>

                    <p>

                        Program Barangay

                        <strong>?</strong>

                        Active Youth with matching Barangay

                        <strong>?</strong>

                        Program Registration

                    </p>

                </div>

            </div>


            <!-- ==================================================
                 ACTIONS
                 ================================================== -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="cancel-button">

                    <i class="bi bi-x-lg"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="save-button">

                    <i class="bi bi-check-lg"></i>

                    Create Program

                </button>

            </div>

        </form>

    </div>


    <!-- ==========================================================
         WORKFLOW
         ========================================================== -->

    <div class="workflow-card">

        <div class="workflow-step active">

            <div class="step-number">
                1
            </div>

            <span>
                Create Program
            </span>

        </div>


        <div class="step-line"></div>


        <div class="workflow-step">

            <div class="step-number">
                2
            </div>

            <span>
                Match Barangay
            </span>

        </div>


        <div class="step-line"></div>


        <div class="workflow-step">

            <div class="step-number">
                3
            </div>

            <span>
                Assign Youth
            </span>

        </div>


        <div class="step-line"></div>


        <div class="workflow-step">

            <div class="step-number">
                4
            </div>

            <span>
                Attendance
            </span>

        </div>

    </div>

</div>


<!-- ==========================================================
     SCHEDULE DATE/TIME VALIDATION (client-side)
     ========================================================== -->

<script>
    (function () {
        var form = document.querySelector('form.program-form');

        if (!form) { return; }

        form.addEventListener('submit', function (event) {
            var startInput = form.querySelector('[data-schedule-start]');
            var endInput = form.querySelector('[data-schedule-end]');

            if (!startInput || !endInput || !startInput.value || !endInput.value) { return; }

            var start = new Date(startInput.value);
            var end = new Date(endInput.value);

            if (isNaN(start.getTime()) || isNaN(end.getTime())) { return; }

            if (end <= start) {
                event.preventDefault();

                endInput.setCustomValidity(
                    'The schedule end date/time must be after the start date/time.'
                );

                endInput.reportValidity();
            }
        });
    })();
</script>


<style>

/* =========================================================
