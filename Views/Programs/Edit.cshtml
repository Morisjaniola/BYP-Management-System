@model BYPManagementSystem.Models.YouthProgram

@{
    ViewData["Title"] = "Edit Program";

    var isActive = Model.Status == "Active";
}

<div class="program-form-page">

    <!-- ==========================================================
         HEADER
         ========================================================== -->

    <section class="form-header">

        <div class="form-header-icon">
            <i class="bi bi-calendar2-event-fill"></i>
        </div>

        <div class="form-header-content">

            <span class="form-header-kicker">
                PROGRAM MANAGEMENT
            </span>

            <h1>
                Edit Youth Program
            </h1>

            <p>
                Update the program information, Barangay, capacity,
                schedule, and current status.
            </p>

        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="form-back-button">

            <i class="bi bi-arrow-left"></i>

            Back to Details

        </a>

    </section>


    <!-- ==========================================================
         PROGRAM SUMMARY
         ========================================================== -->

    <div class="profile-summary">

        <div class="profile-avatar">
            <i class="bi bi-calendar-event-fill"></i>
        </div>

        <div class="profile-info">

            <span>
                CURRENT PROGRAM
            </span>

            <h2>
                @Model.Name
            </h2>

            <div class="profile-meta">

                <span>
                    <i class="bi bi-geo-alt-fill"></i>
                    @(string.IsNullOrWhiteSpace(Model.Barangay)
                        ? "Barangay not set"
                        : Model.Barangay)
                </span>

                <span>
                    <i class="bi bi-people-fill"></i>
                    Capacity: @Model.Capacity
                </span>

            </div>

        </div>


        <div class="profile-status">

            @if (isActive)
            {
                <span class="status-badge active">
                    <i class="bi bi-check-circle-fill"></i>
                    Active
                </span>
            }
            else
            {
                <span class="status-badge inactive">
                    <i class="bi bi-pause-circle-fill"></i>
                    Inactive
                </span>
            }

        </div>

    </div>


    <!-- ==========================================================
         INFO
         ========================================================== -->

    <div class="info-box">

        <div class="info-box-icon">
            <i class="bi bi-magic"></i>
        </div>

        <div class="info-box-content">

            <strong>
                Barangay Matching
            </strong>

            <p>
                When you save changes, the system checks active youth
                participants whose Barangay matches this program's
                Barangay and can automatically connect them through
                Program Registration.
            </p>

        </div>

    </div>


    <!-- ==========================================================
         VALIDATION
         ========================================================== -->

    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>


    <!-- ==========================================================
         EDIT FORM
         ========================================================== -->

    <div class="form-card">

        <div class="form-card-header">

            <div class="form-section-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>

                <h2>
                    Program Information
                </h2>

                <p>
                    Update the fields below and save your changes.
                </p>

            </div>

            <span class="edit-badge">
                <i class="bi bi-pencil-fill"></i>
                Editing
            </span>

        </div>


        <form asp-action="Edit"
              method="post"
              class="program-form">

            @Html.AntiForgeryToken()

            <!-- ID -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />


            <!-- ==================================================
                 PROGRAM NAME
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Name">
                    Program Name
                    <span>*</span>
                </label>

                <div class="field-wrapper">
                    <i class="bi bi-calendar-event"></i>
                    <input asp-for="Name"
                           class="form-control"
                           maxlength="150"
                           placeholder="Enter youth program name" />
                </div>

                <span asp-validation-for="Name"
                      class="field-error">
                </span>

            </div>


            <!-- ==================================================
                 DESCRIPTION
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Description">
                    Description
                    <small>Optional</small>
                </label>

                <div class="field-wrapper textarea-wrapper">
                    <i class="bi bi-card-text"></i>
                    <textarea asp-for="Description"
                              class="form-control textarea-control"
                              rows="3"
                              maxlength="1000"
                              placeholder="Describe the youth program..."></textarea>
                </div>

                <div class="field-bottom">
                    <span asp-validation-for="Description"
                          class="field-error">
                    </span>
                    <span class="character-limit">
                        Maximum 1000 characters
                    </span>
                </div>

            </div>


            <!-- ==================================================
                 SCHEDULE
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Schedule">
                    Schedule
                    <span>*</span>
                </label>

                <div class="field-wrapper">
                    <i class="bi bi-clock-fill"></i>
                    <input asp-for="Schedule"
                           class="form-control"
                           maxlength="250"
                           placeholder="Example: Every Saturday, 8:00 AM - 12:00 PM" />
                </div>

                <span asp-validation-for="Schedule"
                      class="field-error">
                </span>

            </div>


            <!-- ==================================================
                 SCHEDULE START / END DATE TIME PICKERS
                 ================================================== -->

            <div class="form-row schedule-picker-row">

                <!-- START -->

                <div class="form-group">

                    <label asp-for="ScheduleStart">
                        Schedule Start Date &amp; Time
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-alarm"></i>

                        <input asp-for="ScheduleStart"
                               type="datetime-local"
                               class="form-control"
                               data-schedule-start="true" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Optional structured start date and time.

                    </span>

                    <span asp-validation-for="ScheduleStart"
                          class="field-error">
                    </span>

                </div>


                <!-- END -->

                <div class="form-group">

                    <label asp-for="ScheduleEnd">
                        Schedule End Date &amp; Time
                    </label>

                    <div class="field-wrapper">

                        <i class="bi bi-hourglass-split"></i>

                        <input asp-for="ScheduleEnd"
                               type="datetime-local"
                               class="form-control"
                               data-schedule-end="true" />

                    </div>

                    <span class="field-help">

                        <i class="bi bi-info-circle"></i>

                        Optional. Must be after the start date and time.

                    </span>

                    <span asp-validation-for="ScheduleEnd"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 BARANGAY
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Barangay">
                    Barangay
                    <span>*</span>
                </label>

                <div class="field-wrapper">
                    <i class="bi bi-geo-alt-fill"></i>
                    <input asp-for="Barangay"
                           class="form-control"
                           maxlength="100"
                           placeholder="Enter Barangay" />
                </div>

                <span class="field-help">
                    <i class="bi bi-arrow-left-right"></i>
                    Changing the Barangay can change which active
                    youth participants are automatically matched.
                </span>

                <span asp-validation-for="Barangay"
                      class="field-error">
                </span>

            </div>


            <!-- ==================================================
                 CAPACITY / STATUS
                 ================================================== -->

            <div class="form-row">

                <!-- CAPACITY -->

                <div class="form-group">

                    <label asp-for="Capacity">
                        Capacity
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">
                        <i class="bi bi-people-fill"></i>
                        <input asp-for="Capacity"
                               type="number"
                               min="1"
                               max="100000"
                               class="form-control" />
                    </div>

                    <span class="field-help">
                        <i class="bi bi-info-circle"></i>
                        Maximum number of approved participants.
                    </span>

                    <span asp-validation-for="Capacity"
                          class="field-error">
                    </span>

                </div>


                <!-- STATUS -->

                <div class="form-group">

                    <label asp-for="Status">
                        Program Status
                        <span>*</span>
                    </label>

                    <select asp-for="Status"
                            class="form-control">

                        @if (Model.Status == "Active")
                        {
                            <option value="Active" selected>
                                Active
                            </option>
                        }
                        else
                        {
                            <option value="Active">
                                Active
                            </option>
                        }

                        @if (Model.Status == "Inactive")
                        {
                            <option value="Inactive" selected>
                                Inactive
                            </option>
                        }
                        else
                        {
                            <option value="Inactive">
                                Inactive
                            </option>
                        }

                        @if (Model.Status == "Completed")
                        {
                            <option value="Completed" selected>
                                Completed
                            </option>
                        }
                        else
                        {
                            <option value="Completed">
                                Completed
                            </option>
                        }

                    </select>

                    <span class="field-help">
                        <i class="bi bi-toggle-on"></i>
                        Update the program's current availability.
                    </span>

                    <span asp-validation-for="Status"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 CURRENT PROGRAM STATUS
                 ================================================== -->

            <div class="status-section">

                <div class="status-section-heading">
                    <div class="status-heading-icon">
                        @if (isActive)
                        {
                            <i class="bi bi-check-circle-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-pause-circle-fill"></i>
                        }
                    </div>
                    <div>
                        <strong>
                            Current Program Status
                        </strong>
                        <span>
                            @if (isActive)
                            {
                                <span>This program is currently active.</span>
                            }
                            else
                            {
                                <span>This program is currently inactive.</span>
                            }
                        </span>
                    </div>
                </div>

                <div class="current-status">
                    @if (isActive)
                    {
                        <span class="large-status active">
                            <i class="bi bi-check-circle-fill"></i>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="large-status inactive">
                            <i class="bi bi-pause-circle-fill"></i>
                            Inactive
                        </span>
                    }
                </div>

            </div>


            <!-- ==================================================
                 ASSIGNMENT PREVIEW
                 ================================================== -->

            <div class="assignment-preview">

                <div class="assignment-preview-icon">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>

                <div class="assignment-preview-content">

                    <strong>
                        Automatic Assignment Flow
                    </strong>

                    <div class="assignment-flow">

                        <span>
                            <i class="bi bi-people-fill"></i>
                            Active Youth
                        </span>

                        <i class="bi bi-arrow-right"></i>

                        <span>
                            <i class="bi bi-geo-alt-fill"></i>
                            Same Barangay
                        </span>

                        <i class="bi bi-arrow-right"></i>

                        <span>
                            <i class="bi bi-journal-check"></i>
                            Registration
                        </span>

                    </div>

                </div>

            </div>


            <!-- ==================================================
                 ACTIONS
                 ================================================== -->

            <div class="form-actions">

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="cancel-button">

                    <i class="bi bi-x-lg"></i>
                    Cancel

                </a>


                <button type="submit"
                        class="save-button">

                    <i class="bi bi-check-lg"></i>
                    Save Changes

                </button>

            </div>

        </form>

    </div>


    <!-- ==========================================================
         WORKFLOW
         ========================================================== -->

    <div class="workflow-card">

        <div class="workflow-step completed">
            <div class="step-number">
                <i class="bi bi-check-lg"></i>
            </div>
            <span>Program</span>
        </div>

        <div class="step-line completed-line"></div>

        <div class="workflow-step active">
            <div class="step-number">2</div>
            <span>Update</span>
        </div>

        <div class="step-line"></div>

        <div class="workflow-step">
            <div class="step-number">3</div>
            <span>Match Youth</span>
        </div>

        <div class="step-line"></div>

        <div class="workflow-step">
            <div class="step-number">4</div>
            <span>Attendance</span>
        </div>

    </div>

</div>


<!-- ==========================================================
     SCHEDULE DATE/TIME VALIDATION (client-side)
     ========================================================== -->

<script>
    (function () {
        var form = document.querySelector('form.program-form');

        if (!form) { return; }

        form.addEventListener('submit', function (event) {
            var startInput = form.querySelector('[data-schedule-start]');
            var endInput = form.querySelector('[data-schedule-end]');

            if (!startInput || !endInput || !startInput.value || !endInput.value) { return; }

            var start = new Date(startInput.value);
            var end = new Date(endInput.value);

            if (isNaN(start.getTime()) || isNaN(end.getTime())) { return; }

            if (end <= start) {
                event.preventDefault();

                endInput.setCustomValidity(
                    'The schedule end date/time must be after the start date/time.'
                );

                endInput.reportValidity();
            }
        });
    })();
</script>


<style>

/* =========================================================
   FORM PAGE - full content width (matches /Programs layout)
   ========================================================= */

.program-form-page {
    width: 100%;
    padding: 12px 18px 18px;
    box-sizing: border-box;
}


/* =========================================================
   HEADER
   ========================================================= */

.form-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    margin-bottom: 8px;
    border-radius: 13px;
    background:
        linear-gradient(
            110deg,
            rgba(12,144,150,.25),
            rgba(5,45,46,.82)
        );
    border: 1px solid rgba(183,215,229,.16);
    box-shadow: 0 8px 20px rgba(0,0,0,.14);
    color: #FFFFFF;
}

.form-header-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(255,255,255,.09);
    border: 1px solid rgba(255,255,255,.13);
    color: #69DDF2;
    font-size: 16px;
}

.form-header-content {
    flex: 1;
    min-width: 0;
}

.form-header-kicker {
    display: block;
    margin-bottom: 4px;
    color: #A9D5DE;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 1px;
}

.form-header h1 {
    margin: 0;
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
}

.form-header p {
    margin: 3px 0 0;
    color: #C5DDE2;
    font-size: 8px;
    line-height: 1.4;
}

.form-back-button {
    min-height: 30px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 7px;
    border: 1px solid rgba(183,215,229,.16);
    background: rgba(255,255,255,.06);
    color: #C5DDE2;
    text-decoration: none;
    font-size: 7px;
    font-weight: 700;
    white-space: nowrap;
    transition: .16s ease;
}

.form-back-button:hover {
    color: #FFFFFF;
    background: rgba(255,255,255,.10);
    text-decoration: none;
    transform: translateY(-1px);
}


/* =========================================================
   PROFILE SUMMARY
   ========================================================= */

.profile-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    margin-bottom: 8px;
    border-radius: 11px;
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        );
    border: 1px solid rgba(183,215,229,.14);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
}

.profile-avatar {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: rgba(105,199,232,.15);
    color: #69DDF2;
    font-size: 15px;
    font-weight: 800;
}

.profile-info {
    flex: 1;
    min-width: 0;
}

.profile-info > span {
    display: block;
    margin-bottom: 2px;
    color: #69DDF2;
    font-size: 6px;
    font-weight: 700;
    letter-spacing: .8px;
}

.profile-info h2 {
    margin: 0 0 4px;
    overflow: hidden;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.profile-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.profile-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #72969E;
    font-size: 6px;
}

.profile-meta i { color: #69DDF2; }

.profile-status { align-self: flex-start; }


/* =========================================================
   STATUS BADGES
   ========================================================= */

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 8px;
    border-radius: 999px;
    font-size: 6px;
    font-weight: 700;
    white-space: nowrap;
}

.status-badge.active {
    color: #69F0AE;
    background: rgba(43,166,126,.12);
    border: 1px solid rgba(105,240,174,.17);
}

.status-badge.inactive {
    color: #FF7B8A;
    background: rgba(255,123,138,.10);
    border: 1px solid rgba(255,123,138,.15);
}


/* =========================================================
   INFO BOX
   ========================================================= */

.info-box {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 10px;
    margin-bottom: 8px;
    border: 1px solid rgba(105,199,232,.14);
    border-radius: 8px;
    background: rgba(105,199,232,.08);
}

.info-box-icon {
    color: #69DDF2;
    font-size: 13px;
    flex-shrink: 0;
}

.info-box-content {
    min-width: 0;
}

.info-box-content strong {
    display: block;
    margin-bottom: 2px;
    color: #FFFFFF;
    font-size: 8px;
}

.info-box-content p {
    margin: 0;
    color: #769BA3;
    font-size: 6px;
    line-height: 1.4;
}


/* =========================================================
   VALIDATION
   ========================================================= */

.validation-summary {
    margin-bottom: 8px;
    color: #FF7B8A;
    font-size: 6px;
}
.validation-summary:empty { display: none; }


/* =========================================================
   EDIT BADGE
   ========================================================= */

.edit-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
    padding: 5px 7px;
    border-radius: 999px;
    background: rgba(255,209,102,.15);
    color: #FFD166;
    font-size: 6px;
    font-weight: 700;
    white-space: nowrap;
}


/* =========================================================
   FORM CARD
   ========================================================= */

.form-card {
    margin-top: 8px;
    margin-bottom: 8px;
    border-radius: 11px;
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        );
    border: 1px solid rgba(183,215,229,.14);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
}

.form-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(183,215,229,.12);
}

.form-section-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(105,199,232,.10);
    border: 1px solid rgba(105,199,232,.12);
    color: #69DDF2;
    font-size: 14px;
}

.form-card-header h2 {
    margin: 0 0 1px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.1;
}

.form-card-header p {
    margin: 0;
    color: #769BA3;
    font-size: 7px;
}

.form-card-body { padding: 10px 12px; }


/* =========================================================
   FORM
   ========================================================= */

.program-form { padding: 0; }

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}


/* =========================================================
   SCHEDULE DATE/TIME PICKERS
   ========================================================= */

.schedule-picker-row {
    margin-top: 2px;
}

.schedule-picker-row .form-control {
    padding-left: 28px;
}

.schedule-picker-row input[type="datetime-local"]::-webkit-calendar-picker-indicator,
.schedule-picker-row input[type="datetime-local"]::-webkit-inner-spin-button {
    filter: invert(88%) sepia(18%) saturate(1200%) hue-rotate(150deg) brightness(96%) contrast(88%);
    cursor: pointer;
}

.form-group { margin-bottom: 10px; }

.form-group label {
    display: block;
    margin-bottom: 4px;
    color: #A9D5DE;
    font-size: 6px;
    font-weight: 700;
    letter-spacing: .5px;
}

.form-group label span { color: #FF7B8A; }

.field-wrapper { position: relative; }

.field-wrapper > i {
    position: absolute;
    left: 9px;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    color: #69B8CB;
    pointer-events: none;
    font-size: 10px;
}

.textarea-wrapper > i {
    top: 8px;
    transform: none;
}

.form-control {
    width: 100%;
    min-height: 33px;
    box-sizing: border-box;
    padding: 0 8px 0 28px;
    border: 1px solid rgba(183,215,229,.16);
    border-radius: 7px;
    background: rgba(255,255,255,.055);
    color: #D8EEF2;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 8px;
    outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
}

.field-wrapper .form-control { padding-left: 28px; }

.form-control:focus {
    border-color: #69C7E8;
    box-shadow: 0 0 0 3px rgba(105,199,232,.15);
}

textarea.textarea-control {
    min-height: 70px;
    resize: vertical;
    line-height: 1.4;
}

.field-error {
    display: block;
    margin-top: 3px;
    color: #FF7B8A;
    font-size: 6px;
}

.field-help {
    display: block;
    margin-top: 4px;
    color: #72969E;
    font-size: 6px;
    line-height: 1.4;
}
.field-help i { color: #69DDF2; margin-right: 3px; }

.field-bottom {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.character-limit {
    margin-top: 3px;
    color: #72969E;
    font-size: 6px;
    white-space: nowrap;
}


/* =========================================================
   STATUS SECTION
   ========================================================= */

.status-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid rgba(105,199,232,.14);
    border-radius: 8px;
    background: rgba(105,199,232,.05);
}

.status-section-heading {
    display: flex;
    align-items: center;
    gap: 8px;
}

.status-heading-icon {
    width: 28px;
    height: 28px;
    display: flex;
