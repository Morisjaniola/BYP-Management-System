@model BYPManagementSystem.Models.YouthProgram

@{
    ViewData["Title"] = "Program Details";

    bool isAdmin = User.IsInRole("Admin");

    bool isAdminOrStaff =
        User.IsInRole("Admin") ||
        User.IsInRole("Staff");

    bool isYouth =
        User.IsInRole("User");

    var participants =
        ViewBag.Participants
        as IEnumerable<BYPManagementSystem.Models.YouthParticipant>
        ?? Enumerable.Empty<BYPManagementSystem.Models.YouthParticipant>();

    var participantCount =
        ViewBag.ParticipantCount
        ?? participants.Count();

    bool isActive =
        string.Equals(
            Model.Status,
            "Active",
            StringComparison.OrdinalIgnoreCase
        );
}


<div class="program-details-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <section class="form-header">

        <div class="form-header-icon">
            <i class="bi bi-person-vcard-fill"></i>
        </div>

        <div class="form-header-content">

            <span class="form-header-kicker">
                YOUTH PROGRAMS
            </span>

            <h1>
                @Model.Name
            </h1>

            <p>
                View program details, capacity, and participants.
            </p>

        </div>

        @if (isAdminOrStaff)
        {
            <div class="form-header-actions">

                <a asp-controller="Programs"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="header-button edit">

                    <i class="bi bi-pencil"></i>
                    Edit

                </a>


                <a asp-controller="Programs"
                   asp-action="ManageParticipants"
                   asp-route-id="@Model.Id"
                   class="header-button manage">

                    <i class="bi bi-people"></i>
                    Manage Participants

                </a>


                @if (isAdmin)
                {
                    <a asp-controller="Programs"
                       asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="header-button delete">

                        <i class="bi bi-trash3"></i>
                        Delete

                    </a>
                }

            </div>
        }

    </section>


    <!-- =========================================================
         MAIN PROGRAM CARD
         ========================================================= -->

    <section class="dashboard-panel program-overview">

        <div class="program-cover">

            <div class="cover-icon">
                <i class="bi bi-calendar-event"></i>
            </div>


            <div class="cover-text">

                <span class="eyebrow">
                    YOUTH PROGRAM
                </span>

                <h2>
                    @Model.Name
                </h2>

                <div class="description-section">

                    <span class="section-label">
                        ABOUT THIS PROGRAM
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p class="muted-text">
                            No description has been provided for this program.
                        </p>
                    }

                </div>

            </div>

        </div>


        <div class="cover-status">

                @if (isActive)
                {
                    <span class="status-badge active">
                        <span class="status-dot"></span>
                        Active
                    </span>
                }
                else
                {
                    <span class="status-badge inactive">
                        <span class="status-dot"></span>
                        @Model.Status
                    </span>
                }

        </div>

    </section>


    <section class="dashboard-panel program-information-panel">

        <div class="panel-header">

            <div>

                <span class="panel-eyebrow">
                    PROGRAM INFORMATION
                </span>

                <h2>
                    Details
                </h2>

                <p>
                    Schedule, Barangay, capacity, and participants.
                </p>

            </div>

        </div>


        <div class="information-grid">

            <div class="information-card">

                <div class="information-icon schedule">
                    <i class="bi bi-clock"></i>
                </div>

                <div class="information-text">

                    <span>
                        Schedule
                    </span>

                    <strong>
                        @Model.Schedule
                    </strong>

                    @if (Model.ScheduleStart.HasValue && Model.ScheduleEnd.HasValue)
                    {
                        <small class="schedule-datetime-line">

                            <i class="bi bi-calendar-event"></i>

                            @(Model.ScheduleStart.Value.ToString("f")) – @(Model.ScheduleEnd.Value.ToString("f"))

                        </small>
                    }
                    else if (Model.ScheduleStart.HasValue)
                    {
                        <small class="schedule-datetime-line">

                            <i class="bi bi-calendar-event"></i>

                            Starts: @(Model.ScheduleStart.Value.ToString("f"))

                        </small>
                    }

                    <small class="schedule-datetime-line">

                        <i class="bi bi-alarm"></i>

                        Attendance: @AttendanceSchedule.WindowsText(Model)

                    </small>

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon barangay">
                    <i class="bi bi-geo-alt"></i>
                </div>

                <div class="information-text">

                    <span>
                        Barangay
                    </span>

                    <strong>
                        @Model.Barangay
                    </strong>

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon capacity">
                    <i class="bi bi-people"></i>
                </div>

                <div class="information-text">

                    <span>
                        Capacity
                    </span>

                    <strong>
                        @Model.Capacity participants
                    </strong>

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon participants">
                    <i class="bi bi-person-check"></i>
                </div>

                <div class="information-text">

                    <span>
                        Approved Participants
                    </span>

                    <strong>
                        @participantCount
                    </strong>

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon available-slots">
                    <i class="bi bi-person-plus"></i>
                </div>

                <div class="information-text">

                    <span>
                        Available Slots
                    </span>

                    <strong>
                        @(participantCount >= Model.Capacity ? 0 : Model.Capacity - participantCount)
                    </strong>

                </div>

            </div>

        </div>


        <!-- =================================================
             CAPACITY STATUS
         ================================================== -->

        <div class="capacity-section">

            <div class="capacity-header">

                <div>

                    <span class="section-label">
                        PROGRAM CAPACITY
                    </span>

                    <strong>
                        @participantCount / @Model.Capacity participants
                    </strong>

                </div>


                @if (participantCount >= Model.Capacity)
                {
                    <span class="capacity-badge full">

                        <i class="bi bi-exclamation-circle"></i>

                        Full

                    </span>
                }
                else
                {
                    <span class="capacity-badge available">

                        <i class="bi bi-check-circle"></i>

                        @(Model.Capacity - participantCount) slot@(Model.Capacity - participantCount == 1 ? "" : "s") available

                    </span>
                }

            </div>


            <div class="capacity-bar">

                <div class="capacity-progress"
                     style="width:@(Math.Min(100, (double)participantCount / Model.Capacity * 100).ToString("0.##"))%;">

                </div>

            </div>

        </div>


        <!-- =================================================
             USER REGISTRATION AREA
         ================================================== -->

        @if (isYouth)
        {
            <div class="youth-registration-panel">

                <div class="registration-panel-icon">

                    @if (isActive && participantCount < Model.Capacity)
                    {
                        <i class="bi bi-person-plus"></i>
                    }
                    else
                    {
                        <i class="bi bi-lock"></i>
                    }

                </div>


                <div class="registration-panel-content">

                    @if (!isActive)
                    {
                        <strong>
                            Registration is currently unavailable
                        </strong>

                        <p>
                            This program is not currently active.
                        </p>
                    }
                    else if (participantCount >= Model.Capacity)
                    {
                        <strong>
                            Program is currently full
                        </strong>

                        <p>
                            The program has reached its current capacity.
                        </p>
                    }
                    else
                    {
                        <strong>
                            Interested in joining this program?
                        </strong>

                        <p>
                            Submit your registration request to participate
                            in this youth program.
                        </p>
                    }

                </div>


                @if (isActive && participantCount < Model.Capacity)
                {
                    <a asp-controller="Registration"
                       asp-action="Register"
                       asp-route-programId="@Model.Id"
                       class="registration-panel-button">

                        Register Now

                        <i class="bi bi-arrow-right"></i>

                    </a>
                }

            </div>
        }

    </section>


    <!-- =========================================================
         PARTICIPANTS SECTION
         ========================================================= -->

    @if (isAdminOrStaff)
    {
        <section class="dashboard-panel participants-panel">

            <div class="section-header">

                <div>

                    <span class="eyebrow">
                        PARTICIPANTS
                    </span>

                    <h2>
                        Approved Youth Participants
                    </h2>

                    <p>
                        Youth participants currently approved for this program.
                    </p>

                </div>


                <div class="participant-count">

                    <i class="bi bi-people"></i>

                    @participantCount

                </div>

            </div>


            @if (participants.Any())
            {
                <div class="participants-grid">

                    @foreach (var participant in participants)
                    {
                        var firstInitial =
                            !string.IsNullOrWhiteSpace(participant.FirstName)
                                ? participant.FirstName.Substring(0, 1).ToUpper()
                                : "U";

                        var lastInitial =
                            !string.IsNullOrWhiteSpace(participant.LastName)
                                ? participant.LastName.Substring(0, 1).ToUpper()
                                : "";

                        <div class="participant-card">

                            <div class="participant-avatar">

                                @firstInitial@lastInitial

                            </div>


                            <div class="participant-information">

                                <strong>
                                    @participant.FullName
                                </strong>

                                <span>
                                    @participant.Barangay
                                </span>

                                @if (!string.IsNullOrWhiteSpace(participant.ContactNumber))
                                {
                                    <small>

                                        <i class="bi bi-telephone"></i>

                                        @participant.ContactNumber

                                    </small>
                                }

                            </div>


                            <div class="participant-status">

                                @if (participant.IsActive)
                                {
                                    <span class="active-label">

                                        <span></span>

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="inactive-label">

                                        <span></span>

                                        Inactive

                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="empty-participants">

                    <div class="empty-participant-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <strong>
                        No approved participants yet
                    </strong>

                    <span>
                        Approved youth participants will appear here.
                    </span>

                </div>
            }

        </section>
    }


    <!-- =========================================================
         YOUTH INFORMATION
         ========================================================= -->

    @if (isYouth)
    {
        <section class="youth-info-panel">

            <div class="info-panel-icon">
                <i class="bi bi-info-circle"></i>
            </div>

            <div>

                <strong>
                    Program Registration
                </strong>

                <p>
                    Your registration request will be recorded in the system.
                    You can check the current status through
                    <strong>My Registrations</strong>.
                </p>

            </div>

            <a asp-controller="Registration"
               asp-action="MyRegistrations"
               class="my-registration-link">

                My Registrations

                <i class="bi bi-arrow-right"></i>

            </a>

        </section>
    }


    <!-- =========================================================
         BOTTOM ACTIONS
         ========================================================= -->

    <div class="bottom-actions">

        <a asp-controller="Programs"
           asp-action="Index"
           class="bottom-button secondary">

            <i class="bi bi-arrow-left"></i>

            Back to Programs

        </a>


        @if (isYouth && isActive && participantCount < Model.Capacity)
        {
            <a asp-controller="Registration"
               asp-action="Register"
               asp-route-programId="@Model.Id"
               class="bottom-button primary">

                <i class="bi bi-person-plus"></i>

                Register for This Program

            </a>
        }
        else if (isAdminOrStaff)
        {
            <a asp-controller="Programs"
               asp-action="ManageParticipants"
               asp-route-id="@Model.Id"
               class="bottom-button primary">

                <i class="bi bi-people"></i>

                Manage Participants

            </a>
        }

    </div>

</div>


<style>

/* =========================================================
   COMPACT DETAILS PAGE - Matches Admin Dashboard density
   ========================================================= */

.program-details-page {
    width: 100%;
    padding: 12px 18px 18px;
    box-sizing: border-box;
    color: #FFFFFF;
    font-family: Arial, Helvetica, sans-serif;
}


/* =========================================================
   HEADER
   ========================================================= */

.form-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    margin-bottom: 8px;
    border-radius: 13px;
    background:
        linear-gradient(
            110deg,
            rgba(12,144,150,.25),
            rgba(5,45,46,.82)
        );
    border: 1px solid rgba(183,215,229,.16);
    box-shadow: 0 8px 20px rgba(0,0,0,.14);
    color: #FFFFFF;
}

.form-header-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(255,255,255,.09);
    border: 1px solid rgba(255,255,255,.13);
    color: #69DDF2;
    font-size: 16px;
}

.form-header-content {
    flex: 1;
    min-width: 0;
}

.form-header-kicker {
    display: block;
    margin-bottom: 4px;
    color: #A9D5DE;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 1px;
}

.form-header h1 {
    margin: 0;
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
}

.form-header p {
    margin: 3px 0 0;
    color: #C5DDE2;
    font-size: 8px;
    line-height: 1.4;
}

.form-header-actions {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
}

.header-button {
    min-height: 30px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 7px;
    font-size: 7px;
    font-weight: 700;
    text-decoration: none;
    transition: .16s ease;
}

.header-button.edit {
    border: 1px solid rgba(183,215,229,.16);
    background: rgba(255,255,255,.06);
    color: #8DDCF2;
}

.header-button.manage {
    border: 1px solid rgba(183,215,229,.16);
    background: rgba(255,255,255,.06);
    color: #B9BFFF;
}

.header-button.delete {
    border: 1px solid rgba(255,123,138,.20);
    background: rgba(255,123,138,.08);
    color: #FF7B8A;
}

.header-button:hover {
    filter: brightness(.98);
    text-decoration: none;
}


/* =========================================================
   PROGRAM MAIN CARD
   ========================================================= */

.program-main-card {
    padding: 10px;
    border-radius: 11px;
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        );
    border: 1px solid rgba(183,215,229,.14);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
}


/* =========================================================
   COVER
   ========================================================= */

.program-cover {
    min-height: 90px;
    padding: 12px 14px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    background:
        linear-gradient(
            135deg,
            rgba(105,199,232,.15) 0%,
            rgba(5,45,46,.82) 100%
        );
    border-bottom:
        1px solid
        rgba(183,215,229,.12);
    margin: -10px -10px 10px -10px;
    border-radius: 11px 11px 0 0;
}

.cover-icon {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: rgba(255,255,255,.08);
    color: #69DDF2;
    font-size: 18px;
    box-shadow: 0 4px 10px rgba(0,0,0,.10);
}

.cover-text {
    flex: 1;
    min-width: 0;
    margin-left: 12px;
}

.cover-status {
    display: flex;
    align-items: center;
}

.program-overview {
    position: relative;
}

.program-overview .program-cover {
    padding-right: 116px;
}

.program-overview .cover-status {
    position: absolute;
    top: 12px;
    right: 12px;
}

.eyebrow {
    display: block;
    color: #A9D5DE;
    font-size: 6px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.cover-text h2 {
    margin: 0 0 6px;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
}

.description-section {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(183,215,229,.10);
}

.section-label {
    display: block;
    color: #9FC6CC;
    font-size: 6px;
    font-weight: 600;
    letter-spacing: .8px;
}

.description-section p {
    margin: 4px 0 0;
    color: #C5DDE2;
    font-size: 7px;
    line-height: 1.5;
}

.muted-text {
    color: #72969E !important;
}


/* =========================================================
   STATUS BADGES
   ========================================================= */

.status-badge {
    min-height: 22px;
    padding: 0 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 999px;
    font-size: 6px;
    font-weight: 700;
}

.status-badge.active {
    background: rgba(43,166,126,.12);
    color: #69F0AE;
    border: 1px solid rgba(105,240,174,.17);
}

.status-badge.inactive {
    background: rgba(183,215,229,.07);
    color: #A9BAC0;
    border: 1px solid rgba(183,215,229,.12);
}

.status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
}


/* =========================================================
   PANEL
   ========================================================= */

.dashboard-panel {
    padding: 10px;
    border-radius: 11px;
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        );
    border: 1px solid rgba(183,215,229,.14);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
}

.dashboard-panel + .dashboard-panel {
    margin-top: 8px;
}

.panel-header {
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
}

.panel-eyebrow {
    display: block;
    color: #69DDF2;
    font-size: 6px;
    font-weight: 700;
    letter-spacing: .8px;
}

.panel-header h2 {
    margin: 2px 0 1px;
    color: #FFFFFF;
    font-size: 12px;
    line-height: 1.1;
}

.panel-header p {
    margin: 0;
    color: #769BA3;
    font-size: 7px;
}

.panel-icon-box {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    color: #69DDF2;
    background: rgba(105,199,232,.09);
    border: 1px solid rgba(105,199,232,.12);
}

.panel-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #8DDCF2;
    font-size: 7px;
    font-weight: 700;
    text-decoration: none;
}

.panel-link:hover { color: #FFFFFF; text-decoration: none; }


/* =========================================================
   INFORMATION GRID
   ========================================================= */

.information-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 8px;
    margin-top: 8px;
}

.information-card {
    min-height: 64px;
    min-width: 0;
    padding: 9px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 9px;
    background: rgba(255,255,255,.035);
    border: 1px solid rgba(183,215,229,.10);
}

.information-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(255,255,255,.06);
    font-size: 11px;
}

.information-icon.schedule { color: #69DDF2; }
.information-icon.barangay { color: #FFD166; }
.information-icon.capacity { color: #8DDCF2; }
.information-icon.participants { color: #69F0AE; }
.information-icon.available-slots { color: #69F0AE; }

.information-text span {
    display: block;
    color: #9FC6CC;
    font-size: 6px;
    font-weight: 600;
}

.information-text strong {
    display: block;
    margin-top: 1px;
    color: #FFFFFF;
    font-size: 10px;
    line-height: 1.2;
}


/* =========================================================
   SCHEDULE DATE/TIME LINE
   ========================================================= */

.schedule-datetime-line {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 3px;
    color: #69DDF2;
    font-size: 7px;
    font-weight: 600;
}

.schedule-datetime-line i {
    color: #69DDF2;
}


/* =========================================================
   CAPACITY
   ========================================================= */

.capacity-section {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(183,215,229,.12);
}

.capacity-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.capacity-header strong {
    display: block;
    margin-top: 3px;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
}

.capacity-badge {
    min-height: 20px;
    padding: 0 7px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 999px;
    font-size: 6px;
    font-weight: 700;
}

.capacity-badge.available {
    background: rgba(43,166,126,.12);
    color: #69F0AE;
    border: 1px solid rgba(105,240,174,.17);
}

.capacity-badge.full {
    background: rgba(255,123,138,.10);
    color: #FF7B8A;
    border: 1px solid rgba(255,123,138,.15);
}

.capacity-bar {
    height: 6px;
    margin-top: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(183,215,229,.10);
}

.capacity-progress {
    height: 100%;
    border-radius: inherit;
    background: #0C9096;
    transition: width .2s ease;
}


/* =========================================================
   YOUTH REGISTRATION PANEL
   ========================================================= */

.youth-registration-panel {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    margin-top: 8px;
    border: 1px solid rgba(105,199,232,.14);
    border-radius: 8px;
    background: rgba(105,199,232,.08);
}

.registration-panel-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(105,199,232,.10);
    color: #69DDF2;
    font-size: 11px;
}

.registration-panel-content { flex: 1; min-width: 0; }

.registration-panel-content strong {
    display: block;
    color: #FFFFFF;
    font-size: 8px;
    font-weight: 700;
}

.registration-panel-content p {
