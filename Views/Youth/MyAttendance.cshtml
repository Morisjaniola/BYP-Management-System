@model IEnumerable<BYPManagementSystem.Models.AttendanceRecord>

@{
    ViewData["Title"] = "My Attendance";
    
    var records = Model?.ToList() ?? new List<BYPManagementSystem.Models.AttendanceRecord>();
    var participant = ViewBag.Participant as BYPManagementSystem.Models.YouthParticipant;
    var participantName = participant?.FullName ?? "Youth Participant";
}

<div class="my-attendance-page">
    <!-- HEADER -->
    <div class="page-header">
        <div class="header-icon">
            <i class="bi bi-clipboard-check-fill"></i>
        </div>
        <div class="header-content">
            <span class="header-kicker">YOUTH PORTAL</span>
            <h1>My Attendance</h1>
            <p>View your attendance history for approved programs.</p>
        </div>
        <a asp-controller="Programs" asp-action="Index" class="browse-button">
            <i class="bi bi-calendar-event-fill"></i>
            Browse Programs
        </a>
    </div>

    <!-- PARTICIPANT PROFILE -->
    <div class="profile-card">
        <div class="profile-avatar">
            @(participant?.FirstName?.Length > 0
                ? participant.FirstName.Substring(0, 1).ToUpper()
                : "Y")
        </div>
        <div class="profile-info">
            <span>REGISTERED YOUTH PARTICIPANT</span>
            <h2>@participantName</h2>
        </div>
    </div>

    <!-- SUCCESS / ERROR -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-message success">
            <div class="alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <strong>Success</strong>
                <p>@TempData["Success"]</p>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-message error">
            <div class="alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <strong>Notice</strong>
                <p>@TempData["Error"]</p>
            </div>
        </div>
    }

    <!-- ATTENDANCE RECORDS -->
    <div class="section-card">
        <div class="section-header">
            <div class="section-heading">
                <div class="section-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div>
                    <h2>Attendance History</h2>
                    <p>Your participation records for program activities.</p>
                </div>
            </div>
            <span class="record-count">
                @records.Count attendance record(s)
            </span>
        </div>

        @if (records.Any())
        {
            <div class="attendance-scroll-container">
                <table class="attendance-table">
                    <thead>
                        <tr>
                            <th>Program</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in records.OrderByDescending(r => r.AttendanceDate).ThenByDescending(r => r.RecordedAt))
                        {
                            <tr>
                                <td>
                                    <div class="program-cell">
                                        <div class="program-icon">
                                            <i class="bi bi-calendar-event-fill"></i>
                                        </div>
                                        <div>
                                            <strong class="program-name">
                                                @(record.Registration?.Program?.Name ?? "Unknown Program")
                                            </strong>
                                            <span class="program-meta">
                                                @(record.Registration?.Program?.Schedule ?? "Schedule not set")
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="date-cell">
                                        <i class="bi bi-calendar3"></i>
                                        @record.AttendanceDate.ToString("MMM dd, yyyy")
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var statusClass = record.Status.ToLower() switch
                                        {
                                            "present" => "present",
                                            "absent" => "absent",
                                            "late" => "late",
                                            "excused" => "excused",
                                            _ => "neutral"
                                        };
                                    }
                                    <span class="status-badge @statusClass">
                                        <i class="bi bi-@(record.Status == "Present" ? "check-circle-fill" :
                                                      record.Status == "Absent" ? "x-circle-fill" :
                                                      record.Status == "Late" ? "clock-fill" :
                                                      record.Status == "Excused" ? "info-circle-fill" : "question-circle-fill")"></i>
                                        @record.Status
                                    </span>
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(record.Notes) ? "—" : record.Notes)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h3>No Attendance Records Yet</h3>
                <p>
                    Your attendance records will appear here once you are approved 
                    for a program and attendance is recorded.
                </p>
                <a asp-controller="Programs" asp-action="Index" class="empty-button">
                    <i class="bi bi-calendar-event-fill"></i>
                    Browse Available Programs
                </a>
            </div>
        }
    </div>

    <!-- INFO -->
    <div class="info-card">
        <div class="info-icon">
            <i class="bi bi-info-circle-fill"></i>
        </div>
        <div>
            <strong>How Attendance Works</strong>
            <p>
                When your program registration is approved, the admin can record 
                your attendance for each session. Your attendance history will 
                appear here automatically.
            </p>
        </div>
    </div>
</div>

<style>
    .my-attendance-page {
        width: 100%;
        
        
        padding: 12px 18px 18px;
        
    }

    .page-header {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 14px 18px;
        margin-bottom: 12px;
        border-radius: 13px;
        color: white;
        background: radial-gradient(circle at 85% 5%, rgba(12,144,150,.14), transparent 27%), #031716;
        overflow: hidden;
    }

    

    .header-icon {
        position: relative;
        z-index: 2;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 7px;
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.13);
        font-size: 1rem;
    }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .header-kicker {
        display: block;
        margin-bottom: 2px;
        font-size: 7px;
        font-weight: 700;
        letter-spacing: .8px;
        opacity: .88;
    }

    .page-header h1 {
        margin: 3px 0 2px;
        font-size: 20px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        font-size: .6rem;
        
    }

    .browse-button {
        position: relative;
        z-index: 2;
        margin-left: auto;
        min-height: 26px;
        padding: 0 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 1px solid rgba(183,215,229,.16);
        border-radius: 7px;
        color: white;
        background: rgba(255,255,255,.06);
        text-decoration: none;
        font-size: 7px;
        font-weight: 700;
        white-space: nowrap;
    }

    .browse-button:hover {
        color: white;
        background: rgba(255,255,255,.10);
    }

    /* LIGHT MODE: theme.css renders .page-header as a white card,
       so the translucent white button would become invisible. */
    html[data-theme="light"] .my-attendance-page .browse-button {
        background: #009FA3;
        border-color: #009FA3;
        color: #FFFFFF;
    }

    html[data-theme="light"] .my-attendance-page .browse-button:hover {
        background: #0A7D82;
        border-color: #0A7D82;
        color: #FFFFFF;
    }

    /* ============================================================
       DARK MODE OVERRIDES
    ============================================================ */

    html[data-theme="dark"] .profile-card {
        background: #073F3F;
        border-color: rgba(80,220,220,.18);
        box-shadow: 0 6px 22px rgba(0,0,0,.16);
    }

    html[data-theme="dark"] .profile-avatar {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .profile-info > span {
        color: #6CB6B8;
    }

    html[data-theme="dark"] .profile-info h2 {
        color: white;
    }

    html[data-theme="dark"] .section-card {
        background: #073F3F;
        border-color: rgba(80,220,220,.18);
        box-shadow: 0 6px 22px rgba(0,0,0,.16);
    }

    html[data-theme="dark"] .section-header {
        border-bottom-color: rgba(80,220,220,.12);
    }

    html[data-theme="dark"] .section-icon {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .section-header h2 {
        color: white;
    }

    html[data-theme="dark"] .section-header p {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .record-count {
        background: #0A4848;
        border-color: rgba(80,220,220,.18);
        color: #A7D2D2;
    }

    html[data-theme="dark"] .attendance-scroll-container {
        padding: 0 14px 12px;
    }

    html[data-theme="dark"] .attendance-table thead {
        background: #0A4848;
    }

    html[data-theme="dark"] .attendance-table th {
        color: white;
        border-bottom-color: rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .attendance-table td {
        color: #A7D2D2;
        border-bottom-color: rgba(80,220,220,.12);
    }

    html[data-theme="dark"] .attendance-table tbody tr:hover {
        background: #0A4848;
    }

    html[data-theme="dark"] .program-icon {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .program-name {
        color: white;
    }

    html[data-theme="dark"] .program-meta {
        color: #78A5A5;
    }

    html[data-theme="dark"] .date-cell {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .date-cell i {
        color: #6CECEC;
    }

    html[data-theme="dark"] .status-badge.present {
        color: #2DC7A5;
        background: rgba(45,199,165,.10);
        border: 1px solid rgba(45,199,165,.18);
    }

    html[data-theme="dark"] .status-badge.absent {
        color: #F56D78;
        background: rgba(241,91,103,.10);
        border: 1px solid rgba(241,91,103,.18);
    }

    html[data-theme="dark"] .status-badge.late {
        color: #F1A33C;
        background: rgba(241,147,22,.10);
        border: 1px solid rgba(241,147,22,.18);
    }

    html[data-theme="dark"] .status-badge.excused {
        color: #6CECEC;
        background: rgba(105,199,232,.10);
        border: 1px solid rgba(105,199,232,.18);
    }

    html[data-theme="dark"] .status-badge.neutral {
        color: #78A5A5;
        background: #0A4848;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .empty-state {
        background: #073F3F;
        border: 1px solid rgba(80,220,220,.18);
        padding: 40px 16px;
        text-align: center;
    }

    html[data-theme="dark"] .empty-icon {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .empty-state h3 {
        color: white;
    }

    html[data-theme="dark"] .empty-state p {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .empty-button {
        background: #20D8D8;
        color: #001F1F;
    }

    html[data-theme="dark"] .empty-button:hover {
        background: #6CECEC;
    }

    html[data-theme="dark"] .info-card {
        border-color: rgba(80,220,220,.18);
        background: #0A4848;
    }

    html[data-theme="dark"] .info-icon {
        color: #6CECEC;
    }

    html[data-theme="dark"] .info-card strong {
        color: #6CECEC;
    }

    html[data-theme="dark"] .info-card p {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .alert-message.success {
        background: #0A4848;
        border-color: rgba(45,199,165,.18);
        color: #A7D2D2;
    }

    html[data-theme="dark"] .alert-message.error {
        background: #0A4848;
        border-color: rgba(241,91,103,.18);
        color: #A7D2D2;
    }

    html[data-theme="dark"] .alert-message strong {
        color: white;
    }

    html[data-theme="dark"] .alert-message p {
        color: #A7D2D2;
    }

    .profile-card {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 14px;
        margin-bottom: 12px;
        background: white;
        border: 1px solid #e5e9ef;
        border-radius: 7px;
        box-shadow: 0 4px 16px rgba(31, 43, 70, .03);
    }

    .profile-avatar {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 7px;
        background: #eef2f7;
        color: #1f2b46;
        font-size: 1.25rem;
        font-weight: 700;
    }

    .profile-info {
        min-width: 0;
    }

    .profile-info > span {
        display: block;
        margin-bottom: 2px;
        color: #8a98a9;
        font-size: .6rem;
        font-weight: 700;
        letter-spacing: .1em;
    }

    .profile-info h2 {
        margin: 0 0 2px;
        color: #172a41;
        font-size: .98rem;
        font-weight: 700;
    }

    .section-card {
        overflow: hidden;
        margin-bottom: 12px;
        background: white;
        border: 1px solid #e5e9ef;
        border-radius: 10px;
        box-shadow: 0 4px 16px rgba(31, 43, 70, .03);
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 12px 14px;
        border-bottom: 1px solid #edf1f5;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 10px;
        background: #eef2f7;
        color: #1f2b46;
        font-size: 1.05rem;
    }

    .section-header h2 {
        margin: 0 0 2px;
        color: #202b3c;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .section-header p {
        margin: 0;
        color: #717b8c;
        font-size: 7px;
    }

    .record-count {
        display: inline-flex;
        align-items: center;
        min-height: 26px;
        padding: 0 8px;
        border-radius: 8px;
        background: #eef2f7;
        color: #1f2b46;
        font-size: .6rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .attendance-scroll-container {
        max-height: 600px;
        overflow-y: auto;
        overflow-x: auto;
        padding: 0 14px 12px;
    }

    .attendance-table {
        width: 100%;
        min-width: 600px;
        border-collapse: collapse;
    }

    .attendance-table thead {
        background: #eef2f7;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .attendance-table th {
        padding: 8px 12px;
        text-align: left;
        color: #065f46;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .5px;
        border-bottom: 2px solid #a7f3d0;
    }

    .attendance-table td {
        padding: 10px 12px;
        vertical-align: middle;
        color: #475569;
        font-size: 7px;
        border-bottom: 1px solid #f1f5f9;
    }

    .attendance-table tbody tr:hover {
        background: #f8fafc;
    }

    .program-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .program-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 7px;
        background: #eef2f7;
        color: #1f2b46;
        font-size: 1.05rem;
    }

    .program-name {
        display: block;
        color: #1e293b;
        font-size: .6rem;
        font-weight: 700;
    }

    .program-meta {
        display: block;
        margin-top: 2px;
        color: #94a3b8;
        font-size: .6rem;
    }

    .date-cell {
        display: flex;
        align-items: center;
        gap: 4px;
        color: #717b8c;
        font-size: 7px;
    }

    .date-cell i {
        color: #1f2b46;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 7px;
        border-radius: 999px;
        font-size: .6rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-badge.present {
        color: #065f46;
        background: #eef2f7;
    }

    .status-badge.absent {
        color: #991b1b;
        background: #fee2e2;
    }

    .status-badge.late {
        color: #92400e;
        background: #fef3c7;
    }

    .status-badge.excused {
        color: #1e40af;
        background: #dbeafe;
    }

    .status-badge.neutral {
        color: #717b8c;
        background: #f1f5f9;
    }

    .empty-state {
        padding: 40px 16px;
        text-align: center;
    }

    .empty-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 8px;
        border-radius: 10px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 1.15rem;
    }

    .empty-state h3 {
        margin: 3px 0 2px;
        color: #35485e;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .empty-state p {
        max-width: 310px;
        margin: 5px auto 10px;
        color: #7d8b9c;
        font-size: 7px;
        line-height: 1.5;
    }

    .empty-button {
        min-height: 36px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 10px;
        background: #1f2b46;
        color: white;
        text-decoration: none;
        font-size: 7px;
        font-weight: 700;
    }

    .empty-button:hover {
        background: #344054;
        color: white;
    }

    .info-card {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 12px;
        border: 1px solid #e5e9ef;
        border-radius: 10px;
        background: #edf5ef;
    }

    .info-icon {
        color: #1f2b46;
        font-size: .98rem;
        margin-top: 2px;
    }

    .info-card > div {
        flex: 1;
    }

    .info-card strong {
        display: block;
        margin-bottom: 2px;
        color: #1f2b46;
        font-size: .78rem;
        font-weight: 700;
    }

    .info-card p {
        margin: 0;
        color: #717b8c;
        font-size: .6rem;
        line-height: 1.5;
    }

    @@media (max-width: 700px) {
        .my-attendance-page {
            padding: 8px 8px 18px 8px;
        }
        .page-header {
            align-items: flex-start;
            padding: 14px;
        }
        .page-header h1 {
            font-size: 1.5rem;
        }
        .browse-button {
            display: none;
        }
        .section-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 12px;
        }
        .attendance-scroll-container {
            padding: 0 8px 8px;
        }
    }
</style>

