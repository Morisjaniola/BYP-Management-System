@model BYPManagementSystem.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="change-password-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="page-header">

        <div class="header-title-content">

            <div class="header-title-row">

                <div class="header-icon">
                    <i class="bi bi-key-fill"></i>
                </div>

                <div class="change-password-title">

                    <span class="page-eyebrow">
                        ACCOUNT SECURITY
                    </span>

                    <h1>
                        Change Password
                    </h1>

                    <p>
                        Update the password for your account.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         FORM
    ========================================================== -->

    <div class="change-password-card">

        <form asp-action="ChangePassword"
              method="post">

            @Html.AntiForgeryToken()


            <!-- VALIDATION -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- FIELDS -->

            <div class="change-password-grid">

                <div class="form-field">

                    <label asp-for="CurrentPassword"
                           class="form-label">
                    </label>

                    <input asp-for="CurrentPassword"
                           class="form-control"
                           autocomplete="current-password" />

                    <span asp-validation-for="CurrentPassword"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-field">

                    <label asp-for="NewPassword"
                           class="form-label">
                    </label>

                    <input asp-for="NewPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="NewPassword"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-field">

                    <label asp-for="ConfirmNewPassword"
                           class="form-label">
                    </label>

                    <input asp-for="ConfirmNewPassword"
                           class="form-control"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmNewPassword"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <!-- BUTTONS (bottom-right) -->

            <div class="form-actions">

                <a asp-controller="Profile"
                   asp-action="Index"
                   class="btn-cancel">
                    <i class="bi bi-arrow-left"></i> Back to Profile
                </a>

                <button type="submit"
                        class="btn-save">
                    <i class="bi bi-key"></i> Change Password
                </button>

            </div>

        </form>

    </div>

</div>

<style>

    /* =========================================================
       PAGE CONTAINER (standardized: full width, shared padding)
       ========================================================= */

    .change-password-page {
        width: 100%;
        padding: 12px 18px 18px;
        box-sizing: border-box;
    }

    .change-password-page .page-eyebrow {
        display: block;
        margin-bottom: 4px;
        color: #B7D7E5;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }


    /* =========================================================
       FORM CARD (dark surface in Dark Mode via theme vars;
       Bootstrap .card supplies the Light Mode white surface)
       ========================================================= */

    .change-password-card {
        background: var(--byp-surface);
        border: 1px solid var(--byp-border);
        border-radius: 13px;
        padding: 18px 20px;
        color: var(--byp-text);
    }

    .change-password-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px 16px;
        margin-bottom: 6px;
    }

    .change-password-card .form-label {
        margin-bottom: 5px;
        font-size: 14px;
        font-weight: 700;
        color: var(--byp-text-secondary);
    }

    .change-password-card .form-control {
        font-size: 15px;
        min-height: 34px;
    }

    .change-password-card .text-danger {
        display: block;
        margin-top: 4px;
        font-size: 14px;
    }

    @@media (max-width: 767.98px) {
        .change-password-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .change-password-page { padding: 8px; }
        .change-password-card { padding: 14px; }
        .form-actions { flex-direction: column-reverse; }
        .btn-cancel, .btn-save { width: 100%; }
    }

</style>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
