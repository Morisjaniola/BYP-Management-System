@model BYPManagementSystem.Models.ReportsDashboardViewModel

@{
    ViewData["Title"] = "Reports";

    var isUser = User.IsInRole("User");

    // ------------------------------------------------------
    // REPORT FILTER STATE (from query string)
    // ------------------------------------------------------

    var pSearchVal = Context.Request.Query["pSearch"].ToString();
    var pStatusVal = Context.Request.Query["pStatus"].ToString();

    var progSearchVal = Context.Request.Query["progSearch"].ToString();
    var progStatusVal = Context.Request.Query["progStatus"].ToString();

    var regSearchVal = Context.Request.Query["regSearch"].ToString();
    var regStatusVal = Context.Request.Query["regStatus"].ToString();

    var attSearchVal = Context.Request.Query["attSearch"].ToString();
    var attStatusVal = Context.Request.Query["attStatus"].ToString();

    var pS_All = string.IsNullOrEmpty(pStatusVal) || pStatusVal == "All";
    var pS_Active = pStatusVal == "Active";
    var pS_Inactive = pStatusVal == "Inactive";

    var prS_All = string.IsNullOrEmpty(progStatusVal) || progStatusVal == "All";
    var prS_Active = progStatusVal == "Active";
    var prS_Inactive = progStatusVal == "Inactive";
    var prS_Completed = progStatusVal == "Completed";

    var rS_All = string.IsNullOrEmpty(regStatusVal) || regStatusVal == "All";
    var rS_Pending = regStatusVal == "Pending";
    var rS_Approved = regStatusVal == "Approved";
    var rS_Rejected = regStatusVal == "Rejected";

    var aS_All = string.IsNullOrEmpty(attStatusVal) || attStatusVal == "All";
    var aS_Present = attStatusVal == "Present";
    var aS_InProgress = attStatusVal == "InProgress";
    var aS_Absent = attStatusVal == "Absent";
    var aS_Late = attStatusVal == "Late";
    var aS_Excused = attStatusVal == "Excused";
}


<div class="reports-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="page-header">

        <div class="header-title-content">

            <div class="header-title-row">
                <div class="header-icon">

                    <i class="bi bi-bar-chart-line-fill"></i>

                </div>
                <div>

                    <span class="page-eyebrow">
                        SYSTEM REPORTS
                    </span>

                    <h1>
                        Reports
                    </h1>

                    <p>
                        @(isUser
                            ? "View your personal registration and attendance information."
                            : "View participant, program, registration, and attendance information.")
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ADMIN / STAFF
    ========================================================== -->

    @if (!isUser)
    {

        <!-- =====================================================
             SUMMARY CARDS
        ====================================================== -->

        <div class="summary-grid">


            <!-- PARTICIPANTS -->

            <div class="summary-card">

                <div class="summary-icon participants">

                    <i class="bi bi-people"></i>

                </div>


                <div class="summary-content">

                    <span>
                        Youth Participants
                    </span>


                    <strong>
                        @Model.TotalParticipants
                    </strong>


                    <small>
                        @Model.ActiveParticipants active
                    </small>

                </div>

            </div>


            <!-- PROGRAMS -->

            <div class="summary-card">

                <div class="summary-icon programs">

                    <i class="bi bi-calendar-event"></i>

                </div>


                <div class="summary-content">

                    <span>
                        Programs
                    </span>


                    <strong>
                        @Model.TotalPrograms
                    </strong>


                    <small>
                        @Model.ActivePrograms active
                    </small>

                </div>

            </div>


            <!-- REGISTRATIONS -->

            <div class="summary-card">

                <div class="summary-icon registrations">

                    <i class="bi bi-person-plus"></i>

                </div>


                <div class="summary-content">

                    <span>
                        Registrations
                    </span>


                    <strong>
                        @Model.TotalRegistrations
                    </strong>


                    <small>
                        @Model.PendingRegistrations pending
                    </small>

                </div>

            </div>


            <!-- ATTENDANCE -->

            <div class="summary-card">

                <div class="summary-icon attendance">

                    <i class="bi bi-clipboard-check"></i>

                </div>


                <div class="summary-content">

                    <span>
                        Attendance Records
                    </span>


                    <strong>
                        @Model.TotalAttendanceRecords
                    </strong>


                    <small>
                        @Model.PresentCount present
                    </small>

                </div>

            </div>

        </div>


        <!-- =====================================================
             REGISTRATION SUMMARY
        ====================================================== -->

        <section class="report-panel report-section" id="registration-summary-report">

            <div class="panel-header">

                <div>

                    <span>
                        REGISTRATION REPORT
                    </span>


                    <h2>
                        Registration Summary
                    </h2>


                    <p>
                        Current registration status totals.
                    </p>

                </div>


                <i class="bi bi-person-check panel-header-icon"></i>

            </div>


            <div class="metric-grid">


                <div class="metric-card pending">

                    <div class="metric-icon">

                        <i class="bi bi-hourglass-split"></i>

                    </div>


                    <div>

                        <span>
                            Pending
                        </span>


                        <strong>
                            @Model.PendingRegistrations
                        </strong>

                    </div>

                </div>


                <div class="metric-card approved">

                    <div class="metric-icon">

                        <i class="bi bi-check-circle"></i>

                    </div>


                    <div>

                        <span>
                            Approved
                        </span>


                        <strong>
                            @Model.ApprovedRegistrations
                        </strong>

                    </div>

                </div>


                <div class="metric-card rejected">

                    <div class="metric-icon">

                        <i class="bi bi-x-circle"></i>

                    </div>


                    <div>

                        <span>
                            Rejected
                        </span>


                        <strong>
                            @Model.RejectedRegistrations
                        </strong>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             ATTENDANCE SUMMARY
        ====================================================== -->

        <section class="report-panel report-section" id="attendance-summary-report">

            <div class="panel-header">

                <div>

                    <span>
                        ATTENDANCE REPORT
                    </span>


                    <h2>
                        Attendance Summary
                    </h2>


                    <p>
                        Summary of recorded attendance statuses.
                    </p>

                </div>


                <i class="bi bi-clipboard-data panel-header-icon"></i>

            </div>


            <div class="metric-grid four">


                <div class="metric-card present">

                    <div class="metric-icon">

                        <i class="bi bi-check-lg"></i>

                    </div>


                    <div>

                        <span>
                            Present
                        </span>


                        <strong>
                            @Model.PresentCount
                        </strong>

                    </div>

                </div>


                <div class="metric-card absent">

                    <div class="metric-icon">

                        <i class="bi bi-x-lg"></i>

                    </div>


                    <div>

                        <span>
                            Absent
                        </span>


                        <strong>
                            @Model.AbsentCount
                        </strong>

                    </div>

                </div>


                <div class="metric-card late">

                    <div class="metric-icon">

                        <i class="bi bi-clock"></i>

                    </div>


                    <div>

                        <span>
                            Late
                        </span>


                        <strong>
                            @Model.LateCount
                        </strong>

                    </div>

                </div>


                <div class="metric-card excused">

                    <div class="metric-icon">

                        <i class="bi bi-info-circle"></i>

                    </div>


                    <div>

                        <span>
                            Excused
                        </span>


                        <strong>
                            @Model.ExcusedCount
                        </strong>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             PARTICIPANTS TABLE
        ====================================================== -->

        <section class="report-panel report-section" id="youth-participants-report">

            <div class="panel-header">

                <div>

                    <span>
                        YOUTH PARTICIPANTS
                    </span>


                    <h2>
                        Participant Report
                    </h2>


                    <p>
                        Registered youth participant records.
                    </p>

                </div>


                <div class="record-count">

                    @(
                        Model.YouthParticipants?.Count()
                        ?? 0
                    )
                    records

                </div>

                <button type="button" class="panel-print-button" onclick="printReport('youth-participants-report')">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>


            <form asp-controller="Reports" asp-action="Index" method="get" class="report-filter-bar">

                <span class="report-filter-label">
                    Filter
                </span>

                <input type="search" name="pSearch" value="@pSearchVal"
                       class="report-filter-input"
                       placeholder="Search name or barangay..." />

                <select name="pStatus" class="report-filter-select">
                    <option value="All" selected="@(pS_All ? "selected" : null)">All Statuses</option>
                    <option value="Active" selected="@(pS_Active ? "selected" : null)">Active</option>
                    <option value="Inactive" selected="@(pS_Inactive ? "selected" : null)">Inactive</option>
                </select>

                <button type="submit" class="report-filter-button">
                    <i class="bi bi-funnel"></i> Apply
                </button>

                <input type="hidden" name="progSearch" value="@progSearchVal" />
                <input type="hidden" name="progStatus" value="@progStatusVal" />
                <input type="hidden" name="regSearch" value="@regSearchVal" />
                <input type="hidden" name="regStatus" value="@regStatusVal" />
                <input type="hidden" name="attSearch" value="@attSearchVal" />
                <input type="hidden" name="attStatus" value="@attStatusVal" />

                <a asp-controller="Reports" asp-action="Index" class="report-filter-reset">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </a>

            </form>


            <div class="table-wrapper">

                <table class="report-table">

                    <thead>

                        <tr>

                            <th>
                                Name
                            </th>

                            <th>
                                Birth Date
                            </th>

                            <th>
                                Contact
                            </th>

                            <th>
                                Barangay
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.YouthParticipants == null ||
                            !Model.YouthParticipants.Any())
                        {
                            <tr>

                                <td colspan="5"
                                    class="empty-table">

                                    No participant records found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var participant in Model.YouthParticipants)
                            {
                                <tr>

                                    <td>

                                        <div class="name-cell">

                                            <div class="mini-avatar">

                                                @(
                                                    !string.IsNullOrWhiteSpace(
                                                        participant.FirstName)
                                                    ? participant.FirstName
                                                        .Substring(0, 1)
                                                        .ToUpper()
                                                    : "U"
                                                )

                                            </div>


                                            <strong>
                                                @participant.FullName
                                            </strong>

                                        </div>

                                    </td>


                                    <td>

                                        @(participant.BirthDate.HasValue
                                            ? participant.BirthDate.Value
                                                .ToString("MMM dd, yyyy")
                                            : "-")

                                    </td>


                                    <td>

                                        @(participant.ContactNumber ?? "-")

                                    </td>


                                    <td>

                                        @participant.Barangay

                                    </td>


                                    <td>

                                        @if (participant.IsActive)
                                        {
                                            <span class="table-status active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="table-status inactive">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </section>


        <!-- =====================================================
             PROGRAM TABLE
        ====================================================== -->

        <section class="report-panel report-section" id="programs-report">

            <div class="panel-header">

                <div>

                    <span>
                        YOUTH PROGRAMS
                    </span>


                    <h2>
                        Program Report
                    </h2>


                    <p>
                        Programs and their current status.
                    </p>

                </div>


                <div class="record-count">

                    @(
                        Model.Programs?.Count()
                        ?? 0
                    )
                    records

                </div>

                <button type="button" class="panel-print-button" onclick="printReport('programs-report')">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>


            <form asp-controller="Reports" asp-action="Index" method="get" class="report-filter-bar">

                <span class="report-filter-label">
                    Filter
                </span>

                <input type="search" name="progSearch" value="@progSearchVal"
                       class="report-filter-input"
                       placeholder="Search name or description..." />

                <select name="progStatus" class="report-filter-select">
                    <option value="All" selected="@(prS_All ? "selected" : null)">All Statuses</option>
                    <option value="Active" selected="@(prS_Active ? "selected" : null)">Active</option>
                    <option value="Inactive" selected="@(prS_Inactive ? "selected" : null)">Inactive</option>
                    <option value="Completed" selected="@(prS_Completed ? "selected" : null)">Completed</option>
                </select>

                <button type="submit" class="report-filter-button">
                    <i class="bi bi-funnel"></i> Apply
                </button>

                <input type="hidden" name="pSearch" value="@pSearchVal" />
                <input type="hidden" name="pStatus" value="@pStatusVal" />
                <input type="hidden" name="regSearch" value="@regSearchVal" />
                <input type="hidden" name="regStatus" value="@regStatusVal" />
                <input type="hidden" name="attSearch" value="@attSearchVal" />
                <input type="hidden" name="attStatus" value="@attStatusVal" />

                <a asp-controller="Reports" asp-action="Index" class="report-filter-reset">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </a>

            </form>


            <div class="table-wrapper">

                <table class="report-table">

                    <thead>

                        <tr>

                            <th>
                                Program
                            </th>

                            <th>
                                Schedule
                            </th>

                            <th>
                                Barangay
                            </th>

                            <th>
                                Capacity
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Created
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Programs == null ||
                            !Model.Programs.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="empty-table">

                                    No program records found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var program in Model.Programs)
                            {
                                <tr>

                                    <td>

                                        <div class="name-cell">

                                            <div class="mini-avatar program-avatar">

                                                <i class="bi bi-calendar-event"></i>

                                            </div>


                                            <strong>
                                                @program.Name
                                            </strong>

                                        </div>

                                    </td>


                                    <td>
                                        @program.Schedule
                                    </td>


                                    <td>
                                        @program.Barangay
                                    </td>


                                    <td>
                                        @program.Capacity
                                    </td>


                                    <td>

                                        @if (program.Status == "Active")
                                        {
                                            <span class="table-status active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="table-status inactive">
                                                @program.Status
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @(program.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy"))

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </section>


        <!-- =====================================================
             REGISTRATION TABLE
        ====================================================== -->

        <section class="report-panel report-section" id="registrations-report">

            <div class="panel-header">

                <div>

                    <span>
                        REGISTRATIONS
                    </span>


                    <h2>
                        Registration Details
                    </h2>


                    <p>
                        Program registration records and their status.
                    </p>

                </div>


                <div class="record-count">

                    @(
                        Model.Registrations?.Count()
                        ?? 0
                    )
                    records

                </div>

                <button type="button" class="panel-print-button" onclick="printReport('registrations-report')">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>


            <form asp-controller="Reports" asp-action="Index" method="get" class="report-filter-bar">

                <span class="report-filter-label">
                    Filter
                </span>

                <input type="search" name="regSearch" value="@regSearchVal"
                       class="report-filter-input"
                       placeholder="Search program, youth, or email..." />

                <select name="regStatus" class="report-filter-select">
                    <option value="All" selected="@(rS_All ? "selected" : null)">All Statuses</option>
                    <option value="Pending" selected="@(rS_Pending ? "selected" : null)">Pending</option>
                    <option value="Approved" selected="@(rS_Approved ? "selected" : null)">Approved</option>
                    <option value="Rejected" selected="@(rS_Rejected ? "selected" : null)">Rejected</option>
                </select>

                <button type="submit" class="report-filter-button">
                    <i class="bi bi-funnel"></i> Apply
                </button>

                <input type="hidden" name="pSearch" value="@pSearchVal" />
                <input type="hidden" name="pStatus" value="@pStatusVal" />
                <input type="hidden" name="progSearch" value="@progSearchVal" />
                <input type="hidden" name="progStatus" value="@progStatusVal" />
                <input type="hidden" name="attSearch" value="@attSearchVal" />
                <input type="hidden" name="attStatus" value="@attStatusVal" />

                <a asp-controller="Reports" asp-action="Index" class="report-filter-reset">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </a>

            </form>


            <div class="table-wrapper">

                <table class="report-table">

                    <thead>

                        <tr>

                            <th>
                                Program
                            </th>

                            <th>
                                Participant
                            </th>

                            <th>
                                Account
                            </th>

                            <th>
                                Registered
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Registrations == null ||
                            !Model.Registrations.Any())
                        {
                            <tr>

                                <td colspan="5"
                                    class="empty-table">

                                    No registration records found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var registration in Model.Registrations)
                            {
                                <tr>

                                    <td>

                                        <strong class="table-main-text">

                                            @(registration.Program?.Name
                                                ?? "-")

                                        </strong>

                                    </td>


                                    <td>

                                        @(registration.YouthParticipant?.FullName
                                            ?? "-")

                                    </td>


                                    <td>

                                        @(registration.UserEmail
                                            ?? "-")

                                    </td>


                                    <td>

                                        @(registration.RegisteredAt.ToLocalTime().ToString("MMM dd, yyyy"))

                                    </td>


                                    <td>

                                        @if (registration.Status == "Approved")
                                        {
                                            <span class="table-status approved">
                                                Approved
                                            </span>
                                        }
                                        else if (registration.Status == "Pending")
                                        {
                                            <span class="table-status pending">
                                                Pending
                                            </span>
                                        }
                                        else if (registration.Status == "Rejected")
                                        {
                                            <span class="table-status rejected">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="table-status inactive">
                                                @registration.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </section>


        <!-- =====================================================
             ATTENDANCE TABLE
        ====================================================== -->

        <section class="report-panel report-section" id="attendance-report">

            <div class="panel-header">

                <div>

                    <span>
                        ATTENDANCE
                    </span>


                    <h2>
                        Attendance Details
                    </h2>


                    <p>
                        Recorded attendance for program participants.
                    </p>

                </div>


                <div class="record-count">

                    @(
                        Model.AttendanceRecords?.Count()
                        ?? 0
                    )
                    records

                </div>

                <button type="button" class="panel-print-button" onclick="printReport('attendance-report')">
                    <i class="bi bi-printer"></i> Print
                </button>

            </div>


            <form asp-controller="Reports" asp-action="Index" method="get" class="report-filter-bar">

                <span class="report-filter-label">
                    Filter
                </span>

                <input type="search" name="attSearch" value="@attSearchVal"
                       class="report-filter-input"
                       placeholder="Search program, youth, or notes..." />

                <select name="attStatus" class="report-filter-select">
                    <option value="All" selected="@(aS_All ? "selected" : null)">All Statuses</option>
                    <option value="Present" selected="@(aS_Present ? "selected" : null)">Present</option>
                    <option value="InProgress" selected="@(aS_InProgress ? "selected" : null)">In Progress</option>
                    <option value="Absent" selected="@(aS_Absent ? "selected" : null)">Absent</option>
                    <option value="Late" selected="@(aS_Late ? "selected" : null)">Late</option>
                    <option value="Excused" selected="@(aS_Excused ? "selected" : null)">Excused</option>
                </select>

                <button type="submit" class="report-filter-button">
                    <i class="bi bi-funnel"></i> Apply
                </button>

                <input type="hidden" name="pSearch" value="@pSearchVal" />
                <input type="hidden" name="pStatus" value="@pStatusVal" />
                <input type="hidden" name="progSearch" value="@progSearchVal" />
                <input type="hidden" name="progStatus" value="@progStatusVal" />
                <input type="hidden" name="regSearch" value="@regSearchVal" />
                <input type="hidden" name="regStatus" value="@regStatusVal" />

                <a asp-controller="Reports" asp-action="Index" class="report-filter-reset">
                    <i class="bi bi-arrow-clockwise"></i> Reset
                </a>

            </form>


            <div class="table-wrapper">

                <table class="report-table">

                    <thead>

                        <tr>

                            <th>
                                Program
                            </th>

                            <th>
                                Participant
                            </th>

                            <th>
                                Account
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th>                                Morning In
                            </th>


                            <th>

                                Morning Out
                            </th>


                            <th>

                                Afternoon In
                            </th>


                            <th>

                                Afternoon Out
                            </th>

                            <th>
                                Notes
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.AttendanceRecords == null ||
                            !Model.AttendanceRecords.Any())
                        {
                            <tr>

                                <td colspan="8"
                                    class="empty-table">

                                    No attendance records found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var attendance in Model.AttendanceRecords)
                            {
                                <tr>

                                    <td>

                                        <strong class="table-main-text">

                                            @(attendance.Registration?.Program?.Name
                                                ?? "-")

                                        </strong>

                                    </td>


                                    <td>

                                        @(attendance.Registration
                                            ?.YouthParticipant
                                            ?.FullName
                                            ?? "-")

                                    </td>


                                    <td>

                                        @(attendance.Registration?.UserEmail
                                            ?? "-")

                                    </td>


                                    <td>

                                        @(attendance.AttendanceDate.ToString("MMM dd, yyyy"))

                                    </td>


                                    <td>

                                        @if (attendance.Status == "Present")
                                        {
                                            <span class="table-status present">
                                                Present
                                            </span>
                                        }
                                        else if (attendance.Status == "Absent")
                                        {
                                            <span class="table-status rejected">
                                                Absent
                                            </span>
                                        }
                                        else if (attendance.Status == "Late")
                                        {
                                            <span class="table-status pending">
                                                Late
                                            </span>
                                        }
                                        else if (attendance.Status == "Excused")
                                        {
                                            <span class="table-status approved">
                                                Excused
                                            </span>
                                        }
                                        else if (attendance.Status == "InProgress")
                                        {
                                            <span class="table-status pending">
                                                In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="table-status inactive">
                                                @attendance.Status
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @(attendance.TimeInAt.HasValue
                                            ? BYPManagementSystem.Services.AttendanceSchedule.ToAppTime(attendance.TimeInAt.Value).ToString("h:mm tt")
                                            : "-")

                                    </td>


                                    <td>

                                        @(attendance.TimeOutAt.HasValue
                                            ? BYPManagementSystem.Services.AttendanceSchedule.ToAppTime(attendance.TimeOutAt.Value).ToString("h:mm tt")
                                            : "-")

                                    </td>


                                    <td>

                                        @(attendance.AfternoonInAt.HasValue
                                            ? BYPManagementSystem.Services.AttendanceSchedule.ToAppTime(attendance.AfternoonInAt.Value).ToString("h:mm tt")
                                            : "-")

                                    </td>


                                    <td>

                                        @(attendance.AfternoonOutAt.HasValue
                                            ? BYPManagementSystem.Services.AttendanceSchedule.ToAppTime(attendance.AfternoonOutAt.Value).ToString("h:mm tt")
                                            : "-")

                                    </td>


                                    <td>

                                        @(string.IsNullOrWhiteSpace(
