            <div class="panel-header">

                <div>

                    <span>
                        MY REGISTRATIONS
                    </span>


                    <h2>
                        Registration History
                    </h2>


                    <p>
                        Programs you have registered for.
                    </p>

                </div>


                <a asp-controller="Registration"
                   asp-action="MyRegistrations"
                   class="panel-link">

                    View All

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>


            <div class="table-wrapper">

                <table class="report-table">

                    <thead>

                        <tr>

                            <th>
                                Program
                            </th>

                            <th>
                                Registered
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Registrations == null ||
                            !Model.Registrations.Any())
                        {
                            <tr>

                                <td colspan="3"
                                    class="empty-table">

                                    You have no registration records.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var registration in Model.Registrations)
                            {
                                <tr>

                                    <td>

                                        <strong class="table-main-text">

                                            @(registration.Program?.Name
                                                ?? "-")

                                        </strong>

                                    </td>


                                    <td>

                                        @(registration.RegisteredAt.ToLocalTime().ToString("MMM dd, yyyy"))

                                    </td>


                                    <td>

                                        @if (registration.Status == "Approved")
                                        {
                                            <span class="table-status approved">
                                                Approved
                                            </span>
                                        }
                                        else if (registration.Status == "Pending")
                                        {
                                            <span class="table-status pending">
                                                Pending
                                            </span>
                                        }
                                        else if (registration.Status == "Rejected")
                                        {
                                            <span class="table-status rejected">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="table-status inactive">
                                                @registration.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </section>


        <!-- =====================================================
             USER ATTENDANCE
        ====================================================== -->

        <section class="report-panel">

            <div class="panel-header">

                <div>

                    <span>
                        MY ATTENDANCE
                    </span>


                    <h2>
                        Attendance History
                    </h2>


                    <p>
                        Your personal participation records.
                    </p>

