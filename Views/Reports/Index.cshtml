                                Program
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th>                                Morning In
                            </th>


                            <th>

                                Morning Out
                            </th>


                            <th>

                                Afternoon In
                            </th>


                            <th>

                                Afternoon Out
                            </th>

                            <th>
                                Notes
                            </th>

                        </tr>

                    </thead>


