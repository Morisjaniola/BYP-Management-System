@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }


    <script>

        const roleInput =
            document.getElementById("Name");

        const rolePreview =
            document.getElementById("rolePreview");


        function updateRolePreview()
        {
            if (!roleInput ||
                !rolePreview)
            {
                return;
            }

            const value =
                roleInput.value.trim();

            rolePreview.textContent =
                value.length > 0
                    ? value
                    : "Custom Role";
        }


        if (roleInput &&
            !roleInput.hasAttribute("readonly"))
        {
            roleInput.addEventListener(
                "input",
                updateRolePreview
            );

            updateRolePreview();
        }

    </script>

}