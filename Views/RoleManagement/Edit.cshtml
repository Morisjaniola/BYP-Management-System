@model BYPManagementSystem.Controllers.RoleManagementController.RoleEditViewModel

@{
    ViewData["Title"] = "Edit Role";
}

<div class="edit-role-page">

    <!-- ==========================================================
         HEADER
    =========================================================== -->

    <div class="page-header">

        <div>

            <a asp-controller="RoleManagement"
               asp-action="Index"
               class="back-link">

                <i class="bi bi-arrow-left"></i>

                Back to Role Management

            </a>

            <span class="page-eyebrow">
                ADMINISTRATION
            </span>

            <h1>
                Edit Role
            </h1>

            <p>
                Update the name of a custom role and review
                its current account usage.
            </p>

        </div>

    </div>


    <!-- ==========================================================
         VALIDATION
    =========================================================== -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-box error">

            <div class="alert-icon">

                <i class="bi bi-exclamation-circle-fill"></i>

            </div>

            <div>

                <strong>
                    Role update failed.
                </strong>

                <div class="validation-list">

                    @foreach (
                        var error in
                        ViewData.ModelState.Values
                            .SelectMany(v => v.Errors)
                    )
                    {
                        if (!string.IsNullOrWhiteSpace(
                            error.ErrorMessage))
                        {
                            <div>
                                @error.ErrorMessage
                            </div>
                        }
                    }

                </div>

            </div>

        </div>
    }


    <!-- ==========================================================
         MAIN LAYOUT
    =========================================================== -->

    <div class="edit-role-layout">


        <!-- ======================================================
             FORM
        ======================================================= -->

        <section class="form-card">

            <div class="card-header">

                <div class="header-icon">

                    <i class="bi bi-shield-gear"></i>

                </div>

                <div>

                    <span>
                        ROLE MANAGEMENT
                    </span>

                    <h2>
                        Role Information
                    </h2>

                </div>

            </div>


            <form asp-controller="RoleManagement"
                  asp-action="Edit"
                  method="post"
                  class="role-form">

                @Html.AntiForgeryToken()

                <input asp-for="Id"
                       type="hidden" />

                <input asp-for="OriginalName"
                       type="hidden" />

                <input asp-for="UserCount"
                       type="hidden" />

                <input asp-for="IsSystemRole"
                       type="hidden" />


                <!-- ==================================================
                     ROLE NAME
                =================================================== -->

                <div class="form-section">

                    <div class="section-heading">

                        <i class="bi bi-shield"></i>

                        <div>

                            <strong>
                                Role Name
                            </strong>

                            <span>
                                Change the name of this custom role.
                            </span>

                        </div>

                    </div>


                    @if (Model.IsSystemRole)
                    {

                        <div class="protected-box">

                            <div class="protected-icon">

                                <i class="bi bi-lock-fill"></i>

                            </div>

                            <div>

                                <strong>
                                    Protected System Role
                                </strong>

                                <p>
                                    The role
                                    <b>@Model.OriginalName</b>
                                    is protected and cannot be renamed.
                                </p>

                            </div>

                        </div>


                        <div class="form-group">

                            <label asp-for="Name">
                                Role Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   readonly />

                            <span asp-validation-for="Name"
                                  class="field-error">
                            </span>

                        </div>

                    }
                    else
                    {

                        <div class="form-group">

                            <label asp-for="Name">
                                Role Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter role name"
                                   autocomplete="off" />

                            <span asp-validation-for="Name"
                                  class="field-error">
                            </span>

                            <small>
                                Role names must contain 2 to 50 characters.
                            </small>

                        </div>


                        <!-- PREVIEW -->

                        <div class="role-preview">

                            <div class="preview-icon">

                                <i class="bi bi-shield"></i>

                            </div>

                            <div>

                                <span>
                                    ROLE PREVIEW
                                </span>

                                <strong id="rolePreview">
                                    @Model.Name
                                </strong>

                            </div>

                        </div>

                    }

                </div>


                <!-- ==================================================
                     ROLE USAGE
                =================================================== -->

                <div class="form-section">

                    <div class="section-heading">

                        <i class="bi bi-people"></i>

                        <div>

                            <strong>
                                Role Usage
                            </strong>

                            <span>
                                Accounts currently assigned to this role.
                            </span>

                        </div>

                    </div>


                    <div class="usage-card">

                        <div class="usage-icon">

                            <i class="bi bi-person-check"></i>

                        </div>


                        <div class="usage-content">

                            <span>
                                ASSIGNED ACCOUNTS
                            </span>

                            <strong>
                                @Model.UserCount
                            </strong>

                            <small>
                                @(Model.UserCount == 1
                                    ? "user account is assigned to this role."
                                    : "user accounts are assigned to this role.")
                            </small>

                        </div>

                    </div>


                    @if (Model.UserCount > 0)
                    {

                        <div class="usage-note">

                            <i class="bi bi-info-circle"></i>

                            <span>
                                This role is currently in use by one or more
                                accounts. Review role changes carefully because
                                they affect those users.
                            </span>

                        </div>

                    }
                    else
                    {

                        <div class="usage-note available">

                            <i class="bi bi-check-circle"></i>

                            <span>
                                No accounts are currently assigned to this role.
                            </span>

                        </div>

                    }

                </div>


                <!-- ==================================================
                     ACTIONS
                =================================================== -->

                <div class="form-actions">

                    <a asp-controller="RoleManagement"
                       asp-action="Index"
                       class="cancel-button">

                        <i class="bi bi-x-circle"></i>

                        Cancel

                    </a>


                    @if (!Model.IsSystemRole)
                    {

                        <button type="submit"
                                class="save-button">

                            <i class="bi bi-check2-circle"></i>

                            Save Changes

                        </button>

                    }
                    else
                    {

                        <span class="protected-button">

                            <i class="bi bi-lock-fill"></i>

                            Protected Role

                        </span>

                    }

                </div>

            </form>

        </section>


        <!-- ======================================================
             SIDE PANEL
        ======================================================= -->

        <aside class="side-panel">


            <!-- CURRENT ROLE -->

            <div class="side-card">

                <div class="side-header">

                    <div class="side-icon">

                        <i class="bi bi-shield"></i>

                    </div>

                    <div>

                        <span>
                            CURRENT ROLE
                        </span>

                        <h3>
                            @Model.OriginalName
                        </h3>

                    </div>

                </div>


                <div class="status-row">

                    <span>
                        Type
                    </span>

                    <strong>
                        @(Model.IsSystemRole
                            ? "System Role"
                            : "Custom Role")
                    </strong>

                </div>


                <div class="status-row">

                    <span>
                        Assigned Accounts
                    </span>

                    <strong>
                        @Model.UserCount
                    </strong>

                </div>


                <div class="status-row">

                    <span>
                        Role ID
                    </span>

                    <strong class="break-text">
                        @Model.Id
                    </strong>

                </div>

            </div>


            <!-- PROTECTED SYSTEM ROLES -->

            <div class="side-card">

                <div class="side-header">

                    <div class="side-icon">

                        <i class="bi bi-shield-lock"></i>

                    </div>

                    <div>

                        <span>
                            PROTECTED
                        </span>

                        <h3>
                            System Roles
                        </h3>

                    </div>

                </div>


                <div class="system-role-list">


                    <div class="system-role-item">

                        <div class="role-circle">

                            <i class="bi bi-shield-lock"></i>

                        </div>

                        <div>

                            <strong>
                                Admin
                            </strong>

                            <span>
                                Full system administration.
                            </span>

                        </div>

                    </div>


                    <div class="system-role-item">

                        <div class="role-circle">

                            <i class="bi bi-person-badge"></i>

                        </div>

                        <div>

                            <strong>
                                Staff
                            </strong>

                            <span>
                                Operational system access.
                            </span>

                        </div>

                    </div>


                    <div class="system-role-item">

                        <div class="role-circle">

                            <i class="bi bi-person"></i>

                        </div>

                        <div>

                            <strong>
                                User
                            </strong>

                            <span>
                                Youth portal access.
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- SECURITY -->

            <div class="side-card security-card">

                <div class="side-header">

                    <div class="side-icon">

                        <i class="bi bi-lock-fill"></i>

                    </div>

                    <div>

                        <span>
                            SECURITY
                        </span>

                        <h3>
                            Role Protection
                        </h3>

                    </div>

                </div>


                <div class="security-list">

                    <div>

                        <i class="bi bi-check-circle"></i>

                        <span>
                            Only Admin can modify roles.
                        </span>

                    </div>


                    <div>

                        <i class="bi bi-check-circle"></i>

                        <span>
                            Admin, Staff, and User are protected.
                        </span>

                    </div>


                    <div>

                        <i class="bi bi-check-circle"></i>

                        <span>
                            Duplicate role names are prevented.
                        </span>

                    </div>


                    <div>

                        <i class="bi bi-check-circle"></i>

                        <span>
                            Changes use POST and anti-forgery protection.
                        </span>

                    </div>

                </div>

            </div>


            <!-- WORKFLOW -->

            <div class="side-card">

                <div class="side-header">

                    <div class="side-icon">

                        <i class="bi bi-diagram-3"></i>

                    </div>

                    <div>

                        <span>
                            WORKFLOW
                        </span>

                        <h3>
                            Role Management
                        </h3>

                    </div>

                </div>


                <div class="workflow">

                    <div class="workflow-step">

                        <span>
                            1
                        </span>

                        <strong>
                            Review role
                        </strong>

                    </div>


                    <div class="workflow-line"></div>


                    <div class="workflow-step">

                        <span>
                            2
                        </span>

                        <strong>
                            Update custom role
                        </strong>

                    </div>


                    <div class="workflow-line"></div>


                    <div class="workflow-step">

                        <span>
                            3
                        </span>

                        <strong>
                            Save changes
                        </strong>

                    </div>

                </div>

            </div>

        </aside>

    </div>

</div>


<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .edit-role-page {

        width: 100%;

        padding: 12px 18px 18px;

    }


    /* ============================================================
       HEADER
    ============================================================ */

    .page-header {

        margin-bottom: 21px;

    }


    .back-link {

        display: inline-flex;

        align-items: center;

        gap: 6px;

        margin-bottom: 10px;

        color: #6f7a8b;

        text-decoration: none;

        font-size: 0.75rem;

        font-weight: 700;

    }


    .back-link:hover {

        color: #1f2b46;

        text-decoration: none;

    }


    .page-eyebrow {

        display: block;

        color: #7e8999;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .14em;

    }


    .page-header h1 {

        margin: 5px 0 5px;

        color: #202b3c;

        font-size: 2rem;

        font-weight: 800;

    }


    .page-header p {

        margin: 0;

        color: #7b8595;

        font-size: 0.9rem;

    }


    /* ============================================================
       ALERT
    ============================================================ */

    .alert-box {

        display: flex;

        align-items: flex-start;

        gap: 10px;

        padding: 13px 15px;

        margin-bottom: 17px;

        border-radius: 12px;

    }


    .alert-box.error {

        background: #f8eeee;

        border: 1px solid #efdede;

        color: #945b5b;

    }


    .alert-icon {

        margin-top: 1px;

        flex-shrink: 0;

    }


    .alert-box strong {

        display: block;

        font-size: 0.8rem;

    }


    .validation-list {

        margin-top: 5px;

        font-size: 0.75rem;

        line-height: 1.6;

    }


    /* ============================================================
       LAYOUT
    ============================================================ */

    .edit-role-layout {

        display: grid;

        grid-template-columns:
            minmax(0, 1.55fr)
            minmax(275px, .8fr);

        gap: 18px;

        align-items: start;

    }


    .form-card,

    .side-card {

        background: white;

        border: 1px solid #e5e9ef;

        border-radius: 16px;

        box-shadow:
            0 6px 24px
            rgba(31, 43, 70, .035);

    }


    .form-card {

        overflow: hidden;

    }


    /* ============================================================
       CARD HEADER
    ============================================================ */

    .card-header {

        display: flex;

        align-items: center;

        gap: 12px;

        padding: 18px;

        border-bottom: 1px solid #edf0f4;

    }


    .header-icon {

        width: 42px;

        height: 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 11px;

        background: #eef2f7;

        color: #1f2b46;

    }


    .card-header > div:last-child span {

        display: block;

        color: #8d96a4;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .11em;

    }


    .card-header h2 {

        margin: 3px 0 0;

        color: #293446;

        font-size: 1.0rem;

        font-weight: 800;

    }


    /* ============================================================
       FORM
    ============================================================ */

    .role-form {

        padding: 20px;

    }


    .form-section {

        padding-bottom: 20px;

        margin-bottom: 20px;

        border-bottom: 1px solid #edf0f4;

    }


    .section-heading {

        display: flex;

        align-items: flex-start;

        gap: 9px;

        margin-bottom: 14px;

    }


    .section-heading > i {

        margin-top: 2px;

        color: #667386;

        font-size: .8rem;

    }


    .section-heading > div {

        display: flex;

        flex-direction: column;

    }


    .section-heading strong {

        color: #354153;

        font-size: 0.8rem;

    }


    .section-heading span {

        margin-top: 2px;

        color: #919aa8;

        font-size: 0.75rem;

    }


    .form-group {

        display: flex;

        flex-direction: column;

    }


    .form-group label {

        margin-bottom: 6px;

        color: #4c5768;

        font-size: 0.75rem;

        font-weight: 700;

    }


    .form-control {

        width: 100%;

        min-height: 43px;

        padding: 8px 11px;

        border: 1px solid #dfe4ec;

        border-radius: 9px;

        background: white;

        color: #293446;

        font-size: 0.8rem;

        outline: none;

        box-shadow: none;

    }


    .form-control:focus {

        border-color: #b9c2ce;

        box-shadow:
            0 0 0 3px
            rgba(31, 43, 70, .05);

    }


    .form-control[readonly] {

        background: #f4f5f7;

        color: #717b89;

        cursor: not-allowed;

    }


    .form-group small {

        margin-top: 5px;

        color: #9aa2ae;

        font-size: 0.75rem;

        line-height: 1.4;

    }


    .field-error {

        margin-top: 4px;

        color: #a05f5f;

        font-size: 0.75rem;

    }


    /* ============================================================
       PROTECTED BOX
    ============================================================ */

    .protected-box {

        display: flex;

        align-items: flex-start;

        gap: 9px;

        padding: 12px;

        margin-bottom: 14px;

        border: 1px solid #e8e3d8;

        border-radius: 10px;

        background: #fbfaf7;

        color: #7d6c4e;

    }


    .protected-icon {

        width: 32px;

        height: 32px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 8px;

        background: white;

    }


    .protected-box > div:last-child {

        display: flex;

        flex-direction: column;

    }


    .protected-box strong {

        color: #756548;

        font-size: 0.75rem;

    }


    .protected-box p {

        margin: 3px 0 0;

        color: #88785f;

        font-size: 0.75rem;

        line-height: 1.5;

    }


    /* ============================================================
       PREVIEW
    ============================================================ */

    .role-preview {

        display: flex;

        align-items: center;

        gap: 11px;

        margin-top: 15px;

        padding: 13px;

        border: 1px solid #edf0f4;

        border-radius: 11px;

        background: #f8f9fa;

    }


    .preview-icon {

        width: 42px;

        height: 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        background: white;

        color: #1f2b46;

    }


    .role-preview > div:last-child {

        display: flex;

        flex-direction: column;

        min-width: 0;

    }


    .role-preview span {

        color: #929aa7;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .1em;

    }


    .role-preview strong {

        margin-top: 3px;

        color: #3d4859;

        font-size: 0.8rem;

        word-break: break-word;

    }


    /* ============================================================
       USAGE
    ============================================================ */

    .usage-card {

        display: flex;

        align-items: center;

        gap: 12px;

        padding: 14px;

        margin-bottom: 10px;

        border: 1px solid #edf0f4;

        border-radius: 11px;

        background: #fafbfc;

    }


    .usage-icon {

        width: 42px;

        height: 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        background: white;

        color: #5f6d80;

    }


    .usage-content {

        display: flex;

        flex-direction: column;

    }


    .usage-content span {

        color: #929aa7;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .1em;

    }


    .usage-content strong {

        margin-top: 2px;

        color: #303b4c;

        font-size: 1.2rem;

        line-height: 1.1;

    }


    .usage-content small {

        margin-top: 3px;

        color: #8b94a2;

        font-size: 0.75rem;

    }


    .usage-note {

        display: flex;

        align-items: flex-start;

        gap: 7px;

        padding: 10px;

        border-radius: 9px;

        background: #f4f1ea;

        color: #806f50;

        font-size: 0.75rem;

        line-height: 1.45;

    }


    .usage-note.available {

        background: #edf5ef;

        color: #52735b;

    }


    .usage-note i {

        margin-top: 1px;

        flex-shrink: 0;

    }


    /* ============================================================
       ACTIONS
    ============================================================ */

    .form-actions {

        display: flex;

        align-items: center;

        justify-content: flex-end;

        gap: 9px;

    }


    .cancel-button,

    .save-button,

    .protected-button {

        min-height: 40px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        padding: 0 14px;

        border-radius: 10px;

        font-size: 0.8rem;

        font-weight: 700;

        text-decoration: none;

    }


    .cancel-button {

        background: #f2f4f7;

        color: #697386;

    }


    .save-button {

        border: 0;

        background: #1f2b46;

        color: white;

        cursor: pointer;

    }


    .protected-button {

        background: #f2f4f7;

        color: #7b8594;

    }


    .cancel-button:hover {

        color: #344054;

        text-decoration: none;

    }


    .save-button:hover {

        background: #172137;

    }


    /* ============================================================
       SIDE PANEL
    ============================================================ */

    .side-panel {

        display: flex;

        flex-direction: column;

        gap: 15px;

    }


    .side-card {

        padding: 17px;

    }


    .side-header {

        display: flex;

        align-items: center;

        gap: 10px;

        margin-bottom: 14px;

    }


    .side-icon {

        width: 38px;

        height: 38px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 10px;

        background: #eef2f7;

        color: #1f2b46;

        flex-shrink: 0;

    }


    .side-header span {

        display: block;

        color: #9098a5;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .1em;

    }


    .side-header h3 {

        margin: 3px 0 0;

        color: #2c3748;

        font-size: 0.8rem;

        font-weight: 800;

    }


    /* ============================================================
       STATUS
    ============================================================ */

    .status-row {

        display: flex;

        align-items: flex-start;

        justify-content: space-between;

        gap: 14px;

        padding: 10px 0;

        border-top: 1px solid #f0f2f5;

    }


    .status-row span {

        color: #808a99;

        font-size: 0.75rem;

    }


    .status-row strong {

        max-width: 165px;

        color: #354153;

        font-size: 0.75rem;

        text-align: right;

        word-break: break-word;

    }


    .break-text {

        word-break: break-all;

    }


    /* ============================================================
       SYSTEM ROLES
    ============================================================ */

    .system-role-list {

        display: flex;

        flex-direction: column;

        gap: 11px;

    }


    .system-role-item {

        display: flex;

        align-items: center;

        gap: 9px;

    }


    .role-circle {

        width: 34px;

        height: 34px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 9px;

        background: #f2f4f7;

        color: #657186;

    }


    .system-role-item > div:last-child {

        display: flex;

        flex-direction: column;

    }


    .system-role-item strong {

        color: #4c5768;

        font-size: 0.75rem;

    }


    .system-role-item span {

        margin-top: 2px;

        color: #929aa7;

        font-size: 0.75rem;

    }


    /* ============================================================
       SECURITY
    ============================================================ */

    .security-list {

        display: flex;

        flex-direction: column;

        gap: 9px;

    }


    .security-list > div {

        display: flex;

        align-items: flex-start;

        gap: 7px;

        color: #758091;

        font-size: 0.75rem;

        line-height: 1.45;

    }


    .security-list i {

        color: #63806c;

        margin-top: 1px;

        flex-shrink: 0;

    }


    /* ============================================================
       WORKFLOW
    ============================================================ */

    .workflow {

        display: flex;

        flex-direction: column;

    }


    .workflow-step {

        display: flex;

        align-items: center;

        gap: 9px;

    }


    .workflow-step > span {

