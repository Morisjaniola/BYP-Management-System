@model IEnumerable<BYPManagementSystem.Controllers.RoleManagementController.RoleManagementRowViewModel>

@{
    ViewData["Title"] = "Role Management";

    var roles =
        Model?.ToList()
        ?? new List<BYPManagementSystem.Controllers.RoleManagementController.RoleManagementRowViewModel>();

    var search =
        ViewBag.Search as string
        ?? "";

    var totalRoles =
        ViewBag.TotalRoles ?? 0;

    var systemRoles =
        ViewBag.SystemRoles ?? 0;

    var customRoles =
        ViewBag.CustomRoles ?? 0;
}


<div class="role-management-page">

    <!-- ==========================================================
         HEADER
    =========================================================== -->

    <div class="page-header">

        <div class="header-title-content">

            <div class="header-title-row">

                <div class="header-icon">
                    <i class="bi bi-shield-fill-check"></i>
                </div>

                <div>

                    <span class="page-eyebrow">
                        ADMINISTRATION
                    </span>

                    <h1>
                        Role Management
                    </h1>

                    <p>
                        Manage system roles and control which roles are
                        available for authorized account assignment.
                    </p>

                </div>

            </div>

        </div>


        <div class="header-actions">

            <a asp-controller="UserManagement"
               asp-action="Index"
               class="header-button secondary">

                <i class="bi bi-people"></i>

                User Management

            </a>


            <a asp-controller="RoleManagement"
               asp-action="Create"
               class="header-button primary">

                <i class="bi bi-plus-circle"></i>

                Create Role

            </a>

        </div>

    </div>


    <!-- ==========================================================
         ALERTS
    =========================================================== -->

    @if (TempData["Success"] != null)
    {
        <div class="alert-box success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert-box error">

            <i class="bi bi-exclamation-circle-fill"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- ==========================================================
         SUMMARY
    =========================================================== -->

    <div class="summary-grid">

        <!-- TOTAL -->

        <div class="summary-card">

            <div class="summary-icon total">

                <i class="bi bi-shield"></i>

            </div>

            <div class="summary-content">

                <span>
                    Total Roles
                </span>

                <strong>
                    @totalRoles
                </strong>

                <small>
                    Available system roles
                </small>

            </div>

        </div>


        <!-- SYSTEM -->

        <div class="summary-card">

            <div class="summary-icon system">

                <i class="bi bi-shield-lock"></i>

            </div>

            <div class="summary-content">

                <span>
                    System Roles
                </span>

                <strong>
                    @systemRoles
                </strong>

                <small>
                    Admin, Staff, User
                </small>

            </div>

        </div>


        <!-- CUSTOM -->

        <div class="summary-card">

            <div class="summary-icon custom">

                <i class="bi bi-shield-plus"></i>

            </div>

            <div class="summary-content">

                <span>
                    Custom Roles
                </span>

                <strong>
                    @customRoles
                </strong>

                <small>
                    Administrator-created roles
                </small>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         SEARCH
    =========================================================== -->

    <section class="search-card">

        <div class="search-header">

            <div>

                <span>
                    ROLE DIRECTORY
                </span>

                <h2>
                    Search Roles
                </h2>

            </div>


            <a asp-controller="RoleManagement"
               asp-action="Index"
               class="reset-link">

                <i class="bi bi-arrow-clockwise"></i>

                Reset

            </a>

        </div>


        <form asp-controller="RoleManagement"
              asp-action="Index"
              method="get"
              class="search-form">

            <div class="search-input-wrapper">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="search"
                       value="@search"
                       placeholder="Search role name..." />

            </div>


            <button type="submit"
                    class="search-button">

                <i class="bi bi-search"></i>

                Search

            </button>

        </form>

    </section>


    <!-- ==========================================================
         ROLES
    =========================================================== -->

    <section class="roles-card">

        <div class="roles-header">

            <div>

                <span>
                    ROLES
                </span>

                <h2>
                    System Roles
                </h2>

            </div>


            <div class="record-count">

                @roles.Count

                @(roles.Count == 1 ? "role" : "roles")

            </div>

        </div>


        @if (roles.Any())
        {

            <div class="roles-list">

                @foreach (var role in roles)
                {

                    var roleClass =
                        role.Name
                            .ToLowerInvariant()
                            .Replace(" ", "-");


                    <div class="role-row">


                        <!-- ==================================================
                             ROLE ICON
                        =================================================== -->

                        <div class="role-main">

                            <div class="role-icon @roleClass">

                                @if (role.Name == "Admin")
                                {
                                    <i class="bi bi-shield-lock-fill"></i>
                                }
                                else if (role.Name == "Staff")
                                {
                                    <i class="bi bi-person-badge-fill"></i>
                                }
                                else if (role.Name == "User")
                                {
                                    <i class="bi bi-person-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-shield-fill"></i>
                                }

                            </div>


                            <div class="role-info">

                                <div class="role-name-row">

                                    <strong>
                                        @role.Name
                                    </strong>


                                    @if (role.IsSystemRole)
                                    {

                                        <span class="system-badge">

                                            <i class="bi bi-lock-fill"></i>

                                            System Role

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="custom-badge">

                                            Custom Role

                                        </span>

                                    }

                                </div>


                                <span class="role-id">
                                    ID: @role.Id
                                </span>

                            </div>

                        </div>


                        <!-- ==================================================
                             USERS
                        =================================================== -->

                        <div class="role-users">

                            <span>
                                USERS
                            </span>

                            <strong>
                                @role.UserCount
                            </strong>

                            <small>
                                @(role.UserCount == 1
                                    ? "account"
                                    : "accounts")
                            </small>

                        </div>


                        <!-- ==================================================
                             ACTIONS
                        =================================================== -->

                        <div class="role-actions">

                            @if (role.IsSystemRole)
                            {

                                <span class="protected-role">

                                    <i class="bi bi-lock"></i>

                                    Protected

                                </span>

                            }
                            else
                            {

                                <a asp-controller="RoleManagement"
                                   asp-action="Edit"
                                   asp-route-id="@role.Id"
                                   class="role-action edit">

                                    <i class="bi bi-pencil"></i>

                                    Edit

                                </a>


                                @if (role.UserCount == 0)
                                {

                                    <form asp-controller="RoleManagement"
                                          asp-action="Delete"
                                          asp-route-id="@role.Id"
                                          method="post"
                                          onsubmit="return confirm('Delete this role? This action cannot be undone.');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="role-action delete">

                                            <i class="bi bi-trash"></i>

                                            Delete

                                        </button>

                                    </form>

                                }
                                else
                                {

                                    <span class="cannot-delete">

                                        <i class="bi bi-people"></i>

                                        In Use

                                    </span>

                                }

                            }

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-shield-x"></i>

                </div>

                <h3>
                    No roles found
                </h3>

                @if (!string.IsNullOrWhiteSpace(search))
                {

                    <p>
                        No role matched your current search.
                    </p>

                    <a asp-controller="RoleManagement"
                       asp-action="Index"
                       class="empty-button">

                        <i class="bi bi-arrow-clockwise"></i>

                        Clear Search

                    </a>

                }
                else
                {

                    <p>
                        There are currently no roles available.
                    </p>

                    <a asp-controller="RoleManagement"
                       asp-action="Create"
                       class="empty-button">

                        <i class="bi bi-plus-circle"></i>

                        Create Role

                    </a>

                }

            </div>

        }

    </section>


    <!-- ==========================================================
         SYSTEM ROLE INFORMATION
    =========================================================== -->

    <section class="system-role-card">

        <div class="system-role-header">

            <div class="system-role-icon">

                <i class="bi bi-info-circle"></i>

            </div>

            <div>

                <strong>
                    Protected System Roles
                </strong>

                <p>
                    The default Admin, Staff, and User roles are protected
                    because application authorization depends on these
                    role names.
                </p>

            </div>

        </div>


        <div class="system-role-grid">


            <div class="system-role-item">

                <div class="system-role-item-icon admin">

                    <i class="bi bi-shield-lock"></i>

                </div>

                <div>

                    <strong>
                        Admin
                    </strong>

                    <span>
                        Full administrative access.
                    </span>

                </div>

            </div>


            <div class="system-role-item">

                <div class="system-role-item-icon staff">

                    <i class="bi bi-person-badge"></i>

                </div>

                <div>

                    <strong>
                        Staff
                    </strong>

                    <span>
                        Operational system access.
                    </span>

                </div>

            </div>


            <div class="system-role-item">

                <div class="system-role-item-icon user">

                    <i class="bi bi-person"></i>

                </div>

                <div>

                    <strong>
                        User
                    </strong>

                    <span>
                        Youth participant portal access.
                    </span>

                </div>

            </div>

        </div>

    </section>

<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .role-management-page {

        width: 100%;

        padding: 12px 18px 18px;

    }


    /* ============================================================
       HEADER
    ============================================================ */

    .page-header {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 25px;

        margin-bottom: 23px;

    }


    .page-eyebrow {

        display: block;

        color: #7e8999;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .15em;

    }


    .page-header h1 {

        margin: 6px 0 5px;

        color: #202b3c;

        font-size: 2rem;

        font-weight: 800;

    }


    .page-header p {

        margin: 0;

        color: #7b8595;

        font-size: 0.9rem;

    }


    .header-actions {

        display: flex;

        align-items: center;

        justify-content: flex-end;

        gap: 9px;

        flex-wrap: wrap;

    }


    .header-button {

        min-height: 42px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 8px;

        padding: 0 14px;

        border-radius: 11px;

        text-decoration: none;

        font-size: 0.8rem;

        font-weight: 700;

    }


    .header-button.primary {

        background: #1f2b46;

        color: white;

    }


    .header-button.secondary {

        background: white;

        border: 1px solid #dfe4ec;

        color: #344054;

    }


    .header-button:hover {

        text-decoration: none;

        transform: translateY(-1px);

    }


    /* ============================================================
       ALERT
    ============================================================ */

    .alert-box {

        display: flex;

        align-items: center;

        gap: 9px;

        padding: 12px 14px;

        margin-bottom: 15px;

        border-radius: 11px;

        font-size: 0.8rem;

    }


    .alert-box.success {

        background: #edf5ef;

        border: 1px solid #dcebdd;

        color: #52735b;

    }


    .alert-box.error {

        background: #f8eeee;

        border: 1px solid #efdede;

        color: #955c5c;

    }


    /* ============================================================
       SUMMARY
    ============================================================ */

    .summary-grid {

        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 13px;

        margin-bottom: 18px;

    }


    .summary-card {

        display: flex;

        align-items: center;

        gap: 12px;

        min-height: 89px;

        padding: 15px;

        background: white;

        border: 1px solid #e5e9ef;

        border-radius: 14px;

        box-shadow:
            0 5px 20px
            rgba(31, 43, 70, .035);

    }


    .summary-icon {

        width: 41px;

        height: 41px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        background: #eef2f7;

        color: #1f2b46;

    }


    .summary-icon.system {

        background: #f0f2f6;

        color: #5f6b80;

    }


    .summary-icon.custom {

        background: #f1f3f5;

        color: #707b89;

    }


    .summary-content {

        display: flex;

        flex-direction: column;

    }


    .summary-content span {

        color: #7d8796;

        font-size: 0.75rem;

    }


    .summary-content strong {

        margin-top: 1px;

        color: #293446;

        font-size: 1.25rem;

        line-height: 1.1;

    }


    .summary-content small {

        margin-top: 3px;

        color: #9ca4af;

        font-size: 0.75rem;

    }


    /* ============================================================
       SEARCH
    ============================================================ */

    .search-card,

    .roles-card,

    .system-role-card,

    .security-note {

        background: white;

        border: 1px solid #e5e9ef;

        border-radius: 16px;

        box-shadow:
            0 6px 24px
            rgba(31, 43, 70, .035);

    }


    .search-card {

        padding: 17px;

        margin-bottom: 17px;

    }


    .search-header {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        margin-bottom: 13px;

    }


    .search-header span {

        display: block;

        color: #8b95a4;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .11em;

    }


    .search-header h2 {

        margin: 3px 0 0;

        color: #293446;

        font-size: 0.95rem;

        font-weight: 800;

    }


    .reset-link {

        display: inline-flex;

        align-items: center;

        gap: 5px;

        color: #697386;

        text-decoration: none;

        font-size: 0.75rem;

        font-weight: 700;

    }


    .reset-link:hover {

        color: #1f2b46;

        text-decoration: none;

    }


    .search-form {

        display: flex;

        align-items: center;

        gap: 9px;

    }


    .search-input-wrapper {

        position: relative;

        flex: 1;

    }


    .search-input-wrapper i {

        position: absolute;

        left: 11px;

        top: 50%;

        transform: translateY(-50%);

        color: #9aa2ae;

        font-size: 0.8rem;

        pointer-events: none;

    }


    .search-input-wrapper input {

        width: 100%;

        height: 40px;

        padding: 0 11px 0 31px;

        border: 1px solid #dfe4ec;

        border-radius: 9px;

        color: #364153;

        background: white;

        outline: none;

        font-size: 0.8rem;

    }


    .search-input-wrapper input:focus {

        border-color: #b9c2ce;

        box-shadow:
            0 0 0 3px
            rgba(31, 43, 70, .05);

    }


    .search-button {

        height: 40px;

        padding: 0 15px;

        border: 0;

        border-radius: 9px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        background: #1f2b46;

        color: white;

        font-size: 0.75rem;

        font-weight: 700;

        cursor: pointer;

    }


    /* ============================================================
       ROLES CARD
    ============================================================ */

    .roles-card {

        overflow: hidden;

        margin-bottom: 17px;

    }


    .roles-header {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 20px;

        padding: 17px 18px;

        border-bottom: 1px solid #edf0f4;

    }


    .roles-header span {

        display: block;

        color: #8b95a4;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .11em;

    }


    .roles-header h2 {

        margin: 3px 0 0;

        color: #293446;

        font-size: 0.95rem;

        font-weight: 800;

    }


    .record-count {

        padding: 6px 9px;

        border-radius: 999px;

        background: #f2f4f7;

        color: #687386;

        font-size: 0.75rem;

        font-weight: 700;

        white-space: nowrap;

    }


    /* ============================================================
       ROLE ROW
    ============================================================ */

    .roles-list {

        padding: 4px 18px 7px;

    }


    .role-row {

        display: flex;

        align-items: center;

        gap: 18px;

        padding: 14px 0;

        border-bottom: 1px solid #f0f2f5;

    }


    .role-row:last-child {

        border-bottom: 0;

    }


    .role-main {

        display: flex;

        align-items: center;

        gap: 11px;

        flex: 1;

        min-width: 0;

    }


    .role-icon {

        width: 43px;

        height: 43px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        background: #eef2f7;

        color: #1f2b46;

    }


    .role-icon.admin {

        background: #eef0f6;

        color: #5d687f;

    }


    .role-icon.staff {

        background: #f1f3f5;

        color: #687487;

    }


    .role-icon.user {

        background: #edf4f4;

        color: #617777;

    }


    .role-info {

        min-width: 0;

    }


    .role-name-row {

        display: flex;

        align-items: center;

        gap: 7px;

        flex-wrap: wrap;

    }


    .role-name-row strong {

        color: #303b4c;

        font-size: 0.8rem;

    }


    .system-badge,

    .custom-badge {

        display: inline-flex;

        align-items: center;

        gap: 4px;

        padding: 4px 7px;

        border-radius: 999px;

        font-size: 0.75rem;

        font-weight: 700;

    }


    .system-badge {

        background: #f1f3f6;

        color: #707b8c;

    }


    .custom-badge {

        background: #edf4f4;

        color: #667c7c;

    }


    .role-id {

        display: block;

        max-width: 430px;

        margin-top: 4px;

        color: #9ba3ae;

        font-size: 0.75rem;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

    }


    /* ============================================================
       ROLE USERS
    ============================================================ */

    .role-users {

        width: 90px;

        display: flex;

        flex-direction: column;

        text-align: center;

        flex-shrink: 0;

    }


    .role-users span {

        color: #9aa2ae;

        font-size: 0.75rem;

        font-weight: 700;

        letter-spacing: .09em;

    }


    .role-users strong {

        margin-top: 2px;

        color: #354153;

        font-size: 1.0rem;

    }


    .role-users small {

        color: #929aa7;

        font-size: 0.75rem;

    }


    /* ============================================================
       ACTIONS
    ============================================================ */

    .role-actions {

        min-width: 210px;

        display: flex;

        align-items: center;

        justify-content: flex-end;

        gap: 6px;

        flex-shrink: 0;

    }


    .role-actions form {

        margin: 0;

    }


    .role-action,

    .protected-role,

    .cannot-delete {

        min-height: 32px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 5px;

        padding: 0 9px;

        border-radius: 8px;

        font-size: 0.75rem;

        font-weight: 700;

        white-space: nowrap;

    }


    .role-action {

        border: 0;

        text-decoration: none;

        cursor: pointer;

    }


    .role-action:hover {

        text-decoration: none;

        transform: translateY(-1px);

    }


    .role-action.edit {

        background: #eef2f7;

        color: #536175;

    }


    .role-action.delete {

        background: #f7eeee;

        color: #985f5f;

    }


    .protected-role {

        background: #f2f4f7;

        color: #7b8594;

    }


    .cannot-delete {

        background: #f4f1ea;

        color: #806f50;

    }


    /* ============================================================
       EMPTY
    ============================================================ */

    .empty-state {

        padding: 53px 20px;

        text-align: center;

    }


    .empty-icon {

        width: 53px;

        height: 53px;

        display: flex;

        align-items: center;

        justify-content: center;

        margin: 0 auto 11px;

        border-radius: 14px;

        background: #f2f4f7;

        color: #929ba8;

        font-size: 1.15rem;

    }


    .empty-state h3 {

        margin: 0;

        color: #303b4c;

        font-size: .95rem;

        font-weight: 800;

    }


    .empty-state p {

        max-width: 360px;

        margin: 6px auto 13px;

        color: #8791a0;

        font-size: 0.75rem;

    }


    .empty-button {

        min-height: 36px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        padding: 0 12px;

        border-radius: 9px;

        background: #1f2b46;

        color: white;

        text-decoration: none;

        font-size: 0.75rem;

        font-weight: 700;

    }


    .empty-button:hover {

        color: white;

        text-decoration: none;

    }


    /* ============================================================
       SYSTEM ROLE CARD
    ============================================================ */

    .system-role-card {

        padding: 17px;

        margin-bottom: 17px;

    }


    .system-role-header {

        display: flex;

        align-items: flex-start;

        gap: 10px;

        margin-bottom: 15px;

    }


    .system-role-icon {

        width: 37px;

        height: 37px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: #eef2f7;

        color: #1f2b46;

    }


    .system-role-header strong {

        display: block;

        color: #394457;

        font-size: 0.8rem;

    }


    .system-role-header p {

        margin: 3px 0 0;

        color: #8791a0;

        font-size: 0.75rem;

        line-height: 1.45;

    }


    .system-role-grid {

        display: grid;

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

        gap: 10px;

    }


    .system-role-item {

        display: flex;

        align-items: center;

        gap: 9px;

        padding: 10px;

        border: 1px solid #edf0f4;

        border-radius: 10px;

    }


    .system-role-item-icon {

        width: 33px;

