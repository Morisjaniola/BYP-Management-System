@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.EntityFrameworkCore
@inject BYPManagementSystem.Data.ApplicationDbContext _context

@{
    var controller =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var action =
        ViewContext.RouteData.Values["action"]?.ToString();


    // =========================================================
    // ROLES
    // =========================================================

    var isAdmin =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Admin");

    var isStaff =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Staff");

    var isUser =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("User");

    var isAuthenticated =
        User.Identity?.IsAuthenticated == true;


    // =========================================================
    // USER INFORMATION
    // =========================================================

    var displayName =
        User.Identity?.Name ?? "User";

    var roleName =
        isAdmin ? "Administrator" :
        isStaff ? "Staff" :
        isUser ? "Youth / User" :
        "Guest";


    // =========================================================
    // ACTIVE MENU
    // =========================================================

    var isDashboard =
        (controller == "Admin" && action == "Dashboard") ||
        (controller == "Staff" && action == "Dashboard") ||
        (controller == "Youth" && action == "Dashboard");

    var isYouthParticipants =
        controller == "YouthParticipants";

    var isPrograms =
        controller == "Programs";

    var isRegistration =
        controller == "Registration";

    var isAttendance =
        controller == "Attendance";

    var isReports =
        controller == "Reports";

    var isUserManagement =
        controller == "UserManagement";

    var isProfile =
        controller == "Profile";

    var isNotifications =
        controller == "Notifications";

    var isCertificates =
        controller == "Certificates";

    // =========================================================
    // UNREAD NOTIFICATION COUNT (Youth / User only)
    // =========================================================

    var unreadNotificationCount = 0;

    if (isUser && isAuthenticated)
    {
        var notifUserId = UserManager.GetUserId(User);

        if (!string.IsNullOrEmpty(notifUserId))
        {
            unreadNotificationCount =
                await _context.YouthNotifications
                    .AsNoTracking()
                    .CountAsync(n => n.UserId == notifUserId && !n.IsRead);
        }
    }

    var profileImagePath = "";
    if (isAuthenticated)
    {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            profileImagePath = (await UserManager.GetClaimsAsync(currentUser))
                .FirstOrDefault(c => c.Type == "BYPManagementSystem.ProfileImagePath")?.Value ?? "";
        }
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - BYPManagementSystem
    </title>


    <!-- =====================================================
         BOOTSTRAP
    ====================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         GLOBAL THEME
    ====================================================== -->

    <script>
        (function () {
            var t = localStorage.getItem('byp-theme');
            if (!t) { t = 'dark'; }
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <link rel="stylesheet"
          href="~/css/theme.css"
          asp-append-version="true" />


    <style>

            /* =====================================================
                       GLOBAL
                    ====================================================== */

            * {
                box-sizing: border-box;
            }


            html,
            body {
                min-height: 100%;
                margin: 0;
                padding: 0;
            }


            body {
                font-family: Arial, Helvetica, sans-serif;
                background: #001F1F;
                color: #FFFFFF;
                overflow-x: hidden;
            }


            a {
                text-decoration: none;
            }


            /* =====================================================
                       APP SHELL
                    ====================================================== */

            .app-shell {
                min-height: 100vh;
                display: flex;
                background: #001F1F;
            }


            /* =====================================================
                       SIDEBAR
                       OLD DARK TEAL DESIGN
                    ====================================================== */

            .app-sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                width: 292px;
                background: linear-gradient( 180deg, #001C1C 0%, #002827 48%, #003332 100% );
                border-right: 1px solid rgba(82,220,213,.18);
                display: flex;
                flex-direction: column;
                z-index: 1000;
                box-shadow: 8px 0 30px rgba(0,0,0,.18);
            }

            /* =====================================================
                       SIDEBAR BRAND
                    ====================================================== */

            .sidebar-brand {
                min-height: 110px;
                padding: 20px 20px;
                display: flex;
                align-items: center;
                gap: 12px;
                border-bottom: 1px solid rgba(157,218,218,.12);
            }


            .sidebar-brand-icon {
                width: 52px;
                height: 52px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(116,231,225,.20);
                border-radius: 14px;
                background: rgba(255,255,255,.04);
                overflow: hidden;
                box-shadow: 0 5px 15px rgba(0,0,0,.18);
            }


            .sidebar-logo-image {
                width: 48px;
                height: 48px;
                object-fit: contain;
                display: block;
            }


            .sidebar-brand-text {
                min-width: 0;
            }


            .sidebar-brand-name {
                color: #FFFFFF;
                font-size: 1.05rem;
                font-weight: 800;
                line-height: 1.15;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }


            .sidebar-brand-subtitle {
                margin-top: 4px;
                color: #82B6B8;
                font-size: .61rem;
                line-height: 1.3;
                max-width: 190px;
            }


            /* =====================================================
                       SIDEBAR NAVIGATION
                    ====================================================== */

            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                padding: 25px 12px 18px;
            }


            .sidebar-section-title {
                padding: 0 20px;
                margin-bottom: 12px;
                color: #6CB6B8;
                font-size: .62rem;
                font-weight: 800;
                letter-spacing: .15em;
                text-transform: uppercase;
            }


            .sidebar-menu {
                display: flex;
                flex-direction: column;
                gap: 5px;
            }


            /* =====================================================
                       SIDEBAR LINK
                    ====================================================== */

            .sidebar-link {
                min-height: 49px;
                padding: 0 18px;
                display: flex;
                align-items: center;
                gap: 14px;
                border: 1px solid transparent;
                border-radius: 11px;
                color: #A7C7C9;
                font-size: .81rem;
                font-weight: 600;
                transition: all .18s ease;
            }


                .sidebar-link i {
                    width: 22px;
                    flex-shrink: 0;
                    text-align: center;
                    font-size: 1.05rem;
                    color: #69AEB1;
                    transition: all .18s ease;
                }


                /* =====================================================
                       SIDEBAR LINK LABELS
                    Labels keep a predictable width: they shrink inside
                    the flex row instead of overflowing or clipping.
                    ====================================================== */

                .sidebar-link span {
                    min-width: 0;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }


                .sidebar-link:hover {
                    background: rgba(36,173,175,.10);
                    border-color: rgba(74,215,211,.15);
                    color: #FFFFFF;
                    text-decoration: none;
                    transform: translateX(2px);
                }


                    .sidebar-link:hover i {
                        color: #55E4DF;
                    }


                /* =====================================================
                       ACTIVE SIDEBAR LINK
                    ====================================================== */

                .sidebar-link.active {
                    background: linear-gradient( 90deg, rgba(15,129,130,.28), rgba(18,106,108,.18) );
                    border: 1px solid rgba(63,224,218,.38);
                    color: #FFFFFF;
                    box-shadow: inset 3px 0 0 #35E0D9, 0 5px 18px rgba(0,0,0,.12);
                }


                    .sidebar-link.active i {
                        color: #4CE8E1;
                    }


                /* =====================================================
                       INDIVIDUAL ICON COLORS
                    ====================================================== */

                .sidebar-link:nth-child(1) i {
                    color: #63B9C0;
                }

                .sidebar-link:nth-child(2) i {
                    color: #50DCE0;
                }

                .sidebar-link:nth-child(3) i {
                    color: #6C96F4;
                }

                .sidebar-link:nth-child(4) i {
                    color: #F1A33C;
                }

                .sidebar-link:nth-child(5) i {
                    color: #2DC7A5;
                }

                .sidebar-link:nth-child(6) i {
                    color: #6598E8;
                }

                .sidebar-link:nth-child(7) i {
                    color: #55A6C8;
                }

                .sidebar-link:nth-child(8) i {
                    color: #55AEE7;
                }


                .sidebar-link.active i {
                    color: #50E6E0 !important;
                }


            /* =====================================================
                       SIDEBAR FOOTER / LOGOUT
                    ====================================================== */

            .sidebar-footer {
                padding: 14px 12px 16px;
                border-top: 1px solid rgba(157,218,218,.12);
            }


            .logout-form {
                margin: 0;
            }


            .logout-button {
                width: 100%;
                min-height: 50px;
                padding: 0 18px;
                display: flex;
                align-items: center;
                gap: 14px;
                border: 1px solid rgba(241,91,103,.20);
                border-radius: 11px;
                background: rgba(255,255,255,.035);
                color: #F3A4AA;
                font-family: Arial, Helvetica, sans-serif;
                font-size: .81rem;
                font-weight: 700;
                text-align: left;
                cursor: pointer;
                transition: all .18s ease;
            }


                .logout-button i {
                    width: 22px;
                    text-align: center;
                    font-size: 1rem;
                    color: #F56D78;
                }


                .logout-button:hover {
                    background: rgba(225,67,79,.10);
                    border-color: rgba(241,91,103,.38);
                    color: #FFB7BC;
                    transform: translateY(-1px);
                }


            /* =====================================================
                       MAIN AREA
                    ====================================================== */

            .app-main {
                min-height: 100vh;
                width: calc(100% - 292px);
                margin-left: 292px;
                display: flex;
                flex-direction: column;
                background: #001F1F;
            }


            html[data-theme="light"] .user-portal-shell .app-main {
                background: #f4f8fc;
            }

            html[data-theme="light"] .user-portal-shell .app-topbar {
                background: rgba(255,255,255,.92);
                border-bottom: 1px solid #dce8f0;
            }

            html[data-theme="light"] .user-portal-shell .topbar-user-name {
                color: #1f3650;
            }

            html[data-theme="light"] .user-portal-shell .topbar-user-role {
                color: #5f7a95;
            }

            html[data-theme="light"] .user-portal-shell .topbar-user-role i {
                color: #2f9ee9;
            }

            html[data-theme="light"] .user-portal-shell .topbar-avatar {
                border-color: #bcd6ea;
                background: #e8f3fc;
                color: #2f9ee9;
            }

            html[data-theme="light"] .user-portal-shell .app-footer {
                background: #ffffff;
                border-top: 1px solid #dce8f0;
                color: #6b8296;
            }

            html[data-theme="light"] .user-portal-shell .app-footer strong {
                color: #2f9ee9;
            }

            html[data-theme="light"] .user-portal-shell .sidebar-link {
                color: #41607a;
            }

            html[data-theme="light"] .user-portal-shell .sidebar-link:hover {
                background: rgba(47,158,233,.08);
                color: #1f3650;
            }

            html[data-theme="light"] .user-portal-shell .sidebar-link.active {
                background: rgba(47,158,233,.12);
                color: #1475f5;
            }

            html[data-theme="light"] .user-portal-shell .sidebar-brand-name {
                color: #1f3650;
            }

            html[data-theme="light"] .user-portal-shell .sidebar-brand-subtitle,
            html[data-theme="light"] .user-portal-shell .sidebar-section-title {
                color: #7a92a8;
            }

            html[data-theme="light"] .user-portal-shell .sidebar-footer {
                background: rgba(240,246,251,.9);
                border-top-color: #dce8f0;
            }

            html[data-theme="light"] .user-portal-shell .logout-button {
                color: #c04353;
            }

            /* =====================================================
                       TOPBAR
                    ====================================================== */

            .app-topbar {
                min-height: 68px;
                width: 100%;
                padding: 0 22px;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                background: #001C1C;
                border-bottom: 1px solid rgba(106,205,205,.13);
            }


            .topbar-user {
                display: flex;
                align-items: center;
                gap: 12px;
            }


            .topbar-user-info {
                text-align: right;
            }


            .topbar-user-name {
                color: #FFFFFF;
                font-size: .78rem;
                font-weight: 700;
                line-height: 1.2;
            }


            .topbar-user-role {
                margin-top: 3px;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 5px;
                color: #6EA9AD;
                font-size: .60rem;
            }


                .topbar-user-role i {
                    color: #4BC9CE;
                }


            .topbar-avatar {
                width: 45px;
                height: 45px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(73,224,219,.30);
                border-radius: 50%;
                background: rgba(21,147,150,.12);
                color: #49D7D6;
                font-size: 1.15rem;
                text-decoration: none;
            }


                .topbar-avatar:hover {
                    background: rgba(21,147,150,.22);
                    color: #6DEBE5;
                }


            /* Scoped to the top-right avatar only: fills the 45px
               circular container, never stretches (aspect-ratio +
               object-fit), independent of the sidebar icon. */

            .topbar-avatar-image {
                width: 100%;
                height: 100%;
                aspect-ratio: 1 / 1;
                object-fit: cover;
                border-radius: 50%;
                flex-shrink: 0;
                display: block;
            }


            /* =====================================================
                       PAGE CONTENT
                    ====================================================== */

            .app-content {
                flex: 1;
                width: 100%;
                background: linear-gradient( 135deg, #002121 0%, #002B2B 55%, #003333 100% );
            }

            html[data-theme="light"] .app-content.user-portal-content {
                color: #21344a;
                background: linear-gradient(135deg, #f5fbff 0%, #f9f6ff 48%, #f1fff8 100%);
            }


            /* =====================================================
                       FOOTER
                    ====================================================== */

            .app-footer {
                min-height: 55px;
                padding: 15px 25px;
                display: flex;
                align-items: center;
                background: #001C1C;
                border-top: 1px solid rgba(106,205,205,.13);
                color: #638C90;
                font-size: .67rem;
            }


                .app-footer strong {
                    color: #8EBABC;
                }


                .app-footer a {
                    color: #55C9CC;
                }


            /* =====================================================
                       SCROLLBAR
                    ====================================================== */

            .sidebar-nav::-webkit-scrollbar {
                width: 5px;
            }


            .sidebar-nav::-webkit-scrollbar-track {
                background: transparent;
            }


            .sidebar-nav::-webkit-scrollbar-thumb {
                background: rgba(78,177,180,.30);
                border-radius: 10px;
            }


            /* =====================================================
                       RESPONSIVE
                    ====================================================== */

            @@media (max-width: 1199.98px) {

                .app-sidebar {
                    width: 270px;
                }


                .app-main {
                    width: calc(100% - 270px);
                    margin-left: 270px;
                }
            }


            @@media (max-width: 991.98px) {

                .app-sidebar {
                    width: 250px;
                }


                .app-main {
                    width: calc(100% - 250px);
                    margin-left: 250px;
                }


                .sidebar-brand {
                    padding: 18px 15px;
                }


                .sidebar-link {
                    padding: 0 14px;
                }
            }


            @@media (max-width: 767.98px) {

                .app-sidebar {
                    width: 225px;
                }


                .app-main {
                    width: calc(100% - 225px);
                    margin-left: 225px;
                }


                .sidebar-brand-name {
                    font-size: .90rem;
                }


                .sidebar-brand-subtitle {
                    font-size: .55rem;
                }


                .app-topbar {
                    padding: 0 15px;
                }
            }


            @@media (max-width: 575.98px) {

                .app-sidebar {
                    width: 205px;
                }


                .app-main {
                    width: calc(100% - 205px);
                    margin-left: 205px;
                }


                .sidebar-brand {
                    min-height: 85px;
                    padding: 15px 10px;
                }


                .sidebar-brand-icon {
                    width: 42px;
                    height: 42px;
                }


                .sidebar-logo-image {
                    width: 40px;
                    height: 40px;
                }


                .sidebar-brand-name {
                    font-size: .78rem;
                }


                .sidebar-brand-subtitle {
                    display: none;
                }


                .sidebar-nav {
                    padding: 18px 8px;
                }


                .sidebar-section-title {
                    padding: 0 12px;
                }


                .sidebar-link {
                    min-height: 45px;
                    padding: 0 12px;
                    gap: 9px;
                    font-size: .70rem;
                }


                    .sidebar-link i {
                        font-size: .90rem;
                    }


                .logout-button {
                    min-height: 45px;
                    padding: 0 12px;
                    font-size: .70rem;
                }


                .topbar-user-name {
                    max-width: 130px;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    white-space: nowrap;
                }
            }

    </style>

</head>


<body>


    <div class="app-shell @(isUser && !isAdmin && !isStaff ? "user-portal-shell" : "")">


        <!-- =====================================================
         SIDEBAR
    ====================================================== -->

        <aside class="app-sidebar">


            <!-- =================================================
             BRAND
        ================================================== -->

            <div class="sidebar-brand">

                <div class="sidebar-brand-icon">

                    <img src="~/images/login_image.png"
                         alt="Barangay Youth Program Management System Logo"
                         class="sidebar-logo-image" />

                </div>


                <div class="sidebar-brand-text">

                    <div class="sidebar-brand-name">
                        BYProgram
                    </div>

                    <div class="sidebar-brand-subtitle">
                        Barangay Youth Program Management System
                    </div>

                </div>

            </div>



            <!-- =================================================
             NAVIGATION
        ================================================== -->

            <nav class="sidebar-nav">


                <!-- =================================================
                 ADMIN
            ================================================== -->
                @if (isAdmin)
                {

                    <div class="sidebar-section-title">
                        Administration
                    </div>


                    <div class="sidebar-menu">


                        <!-- DASHBOARD -->

                        <a asp-controller="Admin"
                           asp-action="Dashboard"
                           class="sidebar-link @(isDashboard && controller == "Admin" ? "active" : "")">

                            <i class="bi bi-speedometer2"></i>

                            <span>
                                Dashboard
                            </span>

                        </a>


                        <!-- YOUTH PARTICIPANTS -->

                        <a asp-controller="YouthParticipants"
                           asp-action="Index"
                           class="sidebar-link @(isYouthParticipants ? "active" : "")">

                            <i class="bi bi-people"></i>

                            <span>
                                Youth Participants
                            </span>

                        </a>


                        <!-- PROGRAMS -->

                        <a asp-controller="Programs"
                           asp-action="Index"
                           class="sidebar-link @(isPrograms ? "active" : "")">

                            <i class="bi bi-calendar-event"></i>

                            <span>
                                Programs
                            </span>

                        </a>


                        <!-- REGISTRATION -->

                        <a asp-controller="Registration"
                           asp-action="Index"
                           class="sidebar-link @(isRegistration ? "active" : "")">

                            <i class="bi bi-person-check"></i>

                            <span>
                                Registration
                            </span>

                        </a>


                        <!-- ATTENDANCE -->

                        <a asp-controller="Attendance"
                           asp-action="Index"
                           class="sidebar-link @(isAttendance ? "active" : "")">

                            <i class="bi bi-clipboard-check"></i>

                            <span>
                                Attendance
                            </span>

                        </a>


                        <!-- REPORTS -->

                        <a asp-controller="Reports"
                           asp-action="Index"
                           class="sidebar-link @(isReports ? "active" : "")">

                            <i class="bi bi-bar-chart-line"></i>

                            <span>
                                Reports
                            </span>

                        </a>


                        <!-- CERTIFICATES -->

                        <a asp-controller="Certificates"
                           asp-action="Index"
                           class="sidebar-link @(isCertificates ? "active" : "")">

                            <i class="bi bi-award"></i>

                            <span>
                                Certificates
                            </span>

                        </a>


                        <!-- USER MANAGEMENT -->

                        <a asp-controller="UserManagement"
                           asp-action="Index"
                           class="sidebar-link @(isUserManagement ? "active" : "")">

                            <i class="bi bi-person-gear"></i>

                            <span>
                                User Management
                            </span>

                        </a>


                        <!-- PROFILE -->
                        @* Reference design: the sidebar Profile button always
                           shows the generic circular person icon. The uploaded
                           picture is rendered only in the top-right header
                           avatar and on the Profile page. *@

                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="sidebar-link @(isProfile ? "active" : "")">

                            <i class="bi bi-person-circle"></i>

                            <span>
                                Profile
                            </span>

                        </a>


                    </div>

                }



                <!-- =================================================
                 STAFF
            ================================================== -->
                @if (isStaff)
                {

                    <div class="sidebar-section-title">
                        Staff Operations
                    </div>


                    <div class="sidebar-menu">


                        <a asp-controller="Staff"
                           asp-action="Dashboard"
                           class="sidebar-link @(isDashboard && controller == "Staff" ? "active" : "")">

                            <i class="bi bi-speedometer2"></i>

                            <span>
                                Dashboard
                            </span>

                        </a>


                        <a asp-controller="YouthParticipants"
                           asp-action="Index"
                           class="sidebar-link @(isYouthParticipants ? "active" : "")">

                            <i class="bi bi-people"></i>

                            <span>
                                Youth Participants
                            </span>

                        </a>


                        <a asp-controller="Programs"
                           asp-action="Index"
                           class="sidebar-link @(isPrograms ? "active" : "")">

                            <i class="bi bi-calendar-event"></i>

                            <span>
                                Programs
                            </span>

                        </a>


                        <a asp-controller="Registration"
                           asp-action="Index"
                           class="sidebar-link @(isRegistration ? "active" : "")">

                            <i class="bi bi-person-check"></i>

                            <span>
                                Registration
                            </span>

                        </a>


                        <a asp-controller="Attendance"
                           asp-action="Index"
                           class="sidebar-link @(isAttendance ? "active" : "")">

                            <i class="bi bi-clipboard-check"></i>

                            <span>
                                Attendance
                            </span>

                        </a>


                        <a asp-controller="Reports"
                           asp-action="Index"
                           class="sidebar-link @(isReports ? "active" : "")">

                            <i class="bi bi-bar-chart-line"></i>

                            <span>
                                Reports
                            </span>

                        </a>


                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="sidebar-link @(isProfile ? "active" : "")">

                            <i class="bi bi-person-circle"></i>

                            <span>
                                Profile
                            </span>

                        </a>


                    </div>

                }



                <!-- =================================================
                 USER / YOUTH
            ================================================== -->
                @if (isUser)
                {

                    <div class="sidebar-section-title">
                        Youth Portal
                    </div>


                    <div class="sidebar-menu">


                        <a asp-controller="Youth"
                           asp-action="Dashboard"
                           class="sidebar-link @(isDashboard && controller == "Youth" ? "active" : "")">

                            <i class="bi bi-speedometer2"></i>

                            <span>
                                Dashboard
                            </span>

                        </a>


                        <a asp-controller="Programs"
                           asp-action="Index"
                           class="sidebar-link @(isPrograms ? "active" : "")">

                            <i class="bi bi-calendar-event"></i>

                            <span>
                                Programs
                            </span>

                        </a>


                        <a asp-controller="Registration"
                           asp-action="MyRegistrations"
                           class="sidebar-link @(isRegistration ? "active" : "")">

                            <i class="bi bi-person-check"></i>

                            <span>
                                My Registrations
                            </span>

                        </a>


                        <a asp-controller="Attendance"
                           asp-action="MyAttendance"
                           class="sidebar-link @(isAttendance ? "active" : "")">

                            <i class="bi bi-clipboard-check"></i>

                            <span>
                                My Attendance
                            </span>

                        </a>


                        <a asp-controller="Notifications"
                           asp-action="Index"
                           class="sidebar-link @(isNotifications ? "active" : "")">

                            <i class="bi bi-bell"></i>

                            <span>
                                Notifications

                                @if (unreadNotificationCount > 0)
                                {
                                    <span class="badge rounded-pill bg-danger ms-1">
                                        @unreadNotificationCount
                                    </span>
                                }

                            </span>

                        </a>


                        <a asp-controller="Certificates"
                           asp-action="MyCertificates"
                           class="sidebar-link @(isCertificates && action == "MyCertificates" ? "active" : "")">

                            <i class="bi bi-award"></i>

                            <span>
                                My Certificates
                            </span>

                        </a>


                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="sidebar-link @(isProfile ? "active" : "")">

                            <i class="bi bi-person-circle"></i>

                            <span>
                                Profile
                            </span>

                        </a>


                    </div>

                }



                <!-- =================================================
                 GUEST
            ================================================== -->
                @if (!isAuthenticated)
                {

                    <div class="sidebar-section-title">
                        Main Menu
                    </div>


                    <div class="sidebar-menu">


                        <a asp-controller="Home"
                           asp-action="Index"
                           class="sidebar-link @(controller == "Home" && action == "Index" ? "active" : "")">

                            <i class="bi bi-house"></i>

                            <span>
                                Home
                            </span>

                        </a>


                        <a asp-controller="Home"
                           asp-action="Privacy"
                           class="sidebar-link @(controller == "Home" && action == "Privacy" ? "active" : "")">

                            <i class="bi bi-shield-check"></i>

                            <span>
                                Privacy
                            </span>

                        </a>


                        <a asp-controller="Account"
                           asp-action="Login"
                           class="sidebar-link @(controller == "Account" && action == "Login" ? "active" : "")">

                            <i class="bi bi-box-arrow-in-right"></i>

                            <span>
                                Login
                            </span>

                        </a>


                        <a asp-controller="Account"
                           asp-action="Register"
                           class="sidebar-link @(controller == "Account" && action == "Register" ? "active" : "")">

                            <i class="bi bi-person-plus"></i>

                            <span>
                                Register
                            </span>

                        </a>


                    </div>

                }


            </nav>



            <!-- =====================================================
             LOGOUT
        ====================================================== -->
            @if (isAuthenticated)
            {

                <div class="sidebar-footer">

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-button">

                            <i class="bi bi-box-arrow-right"></i>

                            <span>
                                Logout
                            </span>

                        </button>

                    </form>

                </div>

            }


        </aside>



        <!-- =====================================================
         MAIN APPLICATION
    ====================================================== -->

        <div class="app-main">


            <!-- =====================================================
             TOPBAR
        ====================================================== -->

            <header class="app-topbar">

                @if (isAuthenticated)
                {

                    <div class="topbar-user">

                        <button type="button"
                                id="themeToggle"
                                class="theme-toggle"
                                title="Switch appearance">

                            <i id="themeToggleIcon"
                               class="bi bi-moon-stars-fill"></i>

                            <span id="themeToggleLabel">
                                Dark
                            </span>

                        </button>


                        <div class="topbar-user-info">

                            <div class="topbar-user-name">
                                @displayName
                            </div>


                            <div class="topbar-user-role">

                                <i class="bi bi-shield-check"></i>

                                <span>
                                    @roleName
                                </span>

                            </div>

                        </div>


                        @* Top-right account avatar: shows the authenticated
                           user's saved picture (small circular crop), or the
                           generic icon when no picture exists. *@

                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="topbar-avatar"
                           title="My Profile">

                            @if (!string.IsNullOrWhiteSpace(profileImagePath))
                            {
                                <img src="@profileImagePath"
                                     alt="Profile picture"
                                     class="topbar-avatar-image" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle"></i>
                            }

                        </a>


                    </div>

                }

            </header>



            <!-- =====================================================
             PAGE CONTENT
        ====================================================== -->

            <main class="app-content @(isUser && !isAdmin && !isStaff ? "user-portal-content" : "")">

                @RenderBody()

            </main>



        </div>


    </div>



    <!-- =========================================================
     JAVASCRIPT
========================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    @await RenderSectionAsync(
        "Scripts",
        required: false)


    <script>
        (function () {
            var toggle = document.getElementById('themeToggle');
            var label = document.getElementById('themeToggleLabel');
            var icon = document.getElementById('themeToggleIcon');

            function refresh(value) {
                if (!toggle) return;
                if (value === 'light') {
                    toggle.dataset.mode = 'light';
                    if (label) label.textContent = 'Light';
                    if (icon) icon.className = 'bi bi-sun-fill';
                } else {
                    toggle.dataset.mode = 'dark';
                    if (label) label.textContent = 'Dark';
                    if (icon) icon.className = 'bi bi-moon-stars-fill';
                }
            }

            refresh(localStorage.getItem('byp-theme') || 'dark');

            if (toggle) {
                toggle.addEventListener('click', function () {
                    var current = document.documentElement.getAttribute('data-theme') || 'dark';
                    var next = current === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', next);
                    localStorage.setItem('byp-theme', next);
                    refresh(next);
                });
            }
        })();
    </script>


</body>

</html>
