    .guest-button.login:hover {

        background:
            #0b5ed7;

        color:
            #ffffff;

    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @@media (max-width: 700px) {

        .user-details {

            display:
                none;

        }


        .user-account {

            padding:
                3px;

        }


        .logout-button span,
        .guest-button span {

            display:
                none;

        }


        .logout-button,
        .guest-button {

            width:
