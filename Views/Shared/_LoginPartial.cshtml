        justify-content:
            center;

        border-radius:
            8px;

        background:
            #eff6ff;

        color:
            #2563eb;

        font-size:
            .55rem;

        font-weight:
            850;

    }


    /* =========================================================
       USER DETAILS
    ========================================================== */

    .user-details {

        min-width:
            0;

        max-width:
            145px;

        display:
            flex;

