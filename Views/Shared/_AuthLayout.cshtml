<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - BYP Management System
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <script>
        /* Authentication pages always render the branded dark treatment so the
           sign-in experience stays consistent; the saved theme preference
           still applies across the rest of the application. */
        document.documentElement.setAttribute('data-theme', 'dark');
    </script>

    <link rel="stylesheet"
          href="~/css/theme.css"
          asp-append-version="true" />

    <!-- Global typography & control readability layer (loads after
         theme.css so it can standardize text sizes system-wide). -->
    <link rel="stylesheet"
          href="~/css/typography.css"
          asp-append-version="true" />


    <!-- Authentication design layer (branded glass treatment for the
         login / register / access-denied shell). -->
    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

</head>


<body>

    <!-- =====================================================
         AUTH PAGE
    ====================================================== -->

    <div class="auth-page">


        <div class="auth-container">


            <div class="auth-card">


                <!-- =============================================
                     LEFT BRAND
                ============================================== -->

                <section class="auth-brand">


                    <div class="brand-content">


                        <!-- LOGO + TITLE -->

                        <div class="brand-top">


                            <div class="brand-logo">

                                <img src="~/images/Login_image.png"
                                     alt="Barangay Youth Program Management System Logo"
                                     class="brand-logo-image" />

                            </div>


                            <h2 class="brand-title">

                                Barangay Youth Program Management System

                            </h2>


                        </div>


                        <!-- DESCRIPTION -->

                        <p class="brand-description">

                            A centralized system for managing youth
                            participants, programs, registrations,
                            and attendance in the barangay.

                        </p>


                        <!-- FEATURES -->

                        <div class="brand-feature-list">


                            <div class="brand-feature">

                                <i class="bi bi-person-check"></i>

                                <span>
                                    Youth participant management
                                </span>

                            </div>


                            <div class="brand-feature">

                                <i class="bi bi-calendar-event"></i>

                                <span>
                                    Youth program management
                                </span>

                            </div>


                            <div class="brand-feature">

                                <i class="bi bi-clipboard-check"></i>

                                <span>
                                    Registration tracking
                                </span>

                            </div>


                            <div class="brand-feature">

                                <i class="bi bi-check2-square"></i>

                                <span>
                                    Attendance monitoring
                                </span>

                            </div>


                        </div>


                    </div>


                </section>


                <!-- =============================================
                     RIGHT LOGIN
                ============================================== -->

                <section class="auth-form-side">

                    @RenderBody()

                </section>


            </div>


        </div>


    </div>


    <!-- =====================================================
         SCRIPTS
    ====================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>