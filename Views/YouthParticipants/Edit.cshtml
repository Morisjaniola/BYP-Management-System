@model BYPManagementSystem.Models.YouthParticipant

@{
    ViewData["Title"] = "Edit Youth Participant";

    var initials =
        !string.IsNullOrWhiteSpace(Model.FirstName)
            ? Model.FirstName.Substring(0, 1).ToUpper()
            : "Y";
}

<div class="participant-form-page">

    <!-- ==========================================================
         HEADER
         ========================================================== -->

    <section class="form-header">

        <div class="form-header-icon">
            <i class="bi bi-person-gear"></i>
        </div>

        <div class="form-header-content">

            <span class="form-header-kicker">
                YOUTH PARTICIPANTS
            </span>

            <h1>
                Edit Participant
            </h1>

            <p>
                Update the personal information and Barangay details
                of this youth participant.
            </p>

        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="form-back-button">

            <i class="bi bi-arrow-left"></i>

            Back to Details

        </a>

    </section>


    <!-- ==========================================================
         PARTICIPANT SUMMARY
         ========================================================== -->

    <div class="profile-summary">

        <div class="profile-avatar">
            @initials
        </div>

        <div class="profile-info">

            <span>
                EDITING PARTICIPANT
            </span>

            <h2>
                @Model.FullName
            </h2>

            <div class="profile-meta">

                <span>
                    <i class="bi bi-geo-alt-fill"></i>
                    @(string.IsNullOrWhiteSpace(Model.Barangay)
                        ? "Barangay not set"
                        : Model.Barangay)
                </span>

                <span>
                    <i class="bi bi-hash"></i>
                    Participant ID: @Model.Id
                </span>

            </div>

        </div>


        <div class="profile-status">

            @if (Model.IsActive)
            {
                <span class="status-badge active">
                    <i class="bi bi-check-circle-fill"></i>
                    Active
                </span>
            }
            else
            {
                <span class="status-badge inactive">
                    <i class="bi bi-x-circle-fill"></i>
                    Inactive
                </span>
            }

        </div>

    </div>


    <!-- ==========================================================
         VALIDATION
         ========================================================== -->

    <div asp-validation-summary="ModelOnly"
         class="validation-summary">
    </div>


    <!-- ==========================================================
         EDIT FORM
         ========================================================== -->

    <div class="form-card">

        <div class="form-card-header">

            <div class="form-section-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>

                <h2>
                    Participant Information
                </h2>

                <p>
                    Modify the participant's information below.
                </p>

            </div>

        </div>


        <form asp-action="Edit"
              method="post"
              class="participant-form">

            @Html.AntiForgeryToken()

            <!-- ID -->
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="IsActive" />


            <!-- ==================================================
                 NAME
                 ================================================== -->

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="FirstName">
                        First Name
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">
                        <i class="bi bi-person"></i>
                        <input asp-for="FirstName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter first name" />
                    </div>

                    <span asp-validation-for="FirstName"
                          class="field-error">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="LastName">
                        Last Name
                        <span>*</span>
                    </label>

                    <div class="field-wrapper">
                        <i class="bi bi-person"></i>
                        <input asp-for="LastName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter last name" />
                    </div>

                    <span asp-validation-for="LastName"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 BIRTHDATE / CONTACT
                 ================================================== -->

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="BirthDate">
                        Birth Date
                    </label>

                    <div class="field-wrapper">
                        <i class="bi bi-calendar3"></i>
                        <input asp-for="BirthDate"
                               type="date"
                               class="form-control" />
                    </div>

                    <span asp-validation-for="BirthDate"
                          class="field-error">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="ContactNumber">
                        Contact Number
                    </label>

                    <div class="field-wrapper">
                        <i class="bi bi-telephone"></i>
                        <input asp-for="ContactNumber"
                               class="form-control"
                               maxlength="30"
                               placeholder="Enter contact number" />
                    </div>

                    <span asp-validation-for="ContactNumber"
                          class="field-error">
                    </span>

                </div>

            </div>


            <!-- ==================================================
                 BARANGAY
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Barangay">
                    Barangay
                    <span>*</span>
                </label>

                <div class="field-wrapper">
                    <i class="bi bi-geo-alt-fill"></i>
                    <input asp-for="Barangay"
                           class="form-control"
                           maxlength="100"
                           placeholder="Enter Barangay" />
                </div>

                <span class="field-help">
                    <i class="bi bi-info-circle"></i>
                    The Barangay is used for automatic program assignment when it matches a program's Barangay.
                </span>

                <span asp-validation-for="Barangay"
                      class="field-error">
                </span>

            </div>


            <!-- ==================================================
                 ADDRESS
                 ================================================== -->

            <div class="form-group">

                <label asp-for="Address">
                    Address
                </label>

                <div class="field-wrapper textarea-wrapper">
                    <i class="bi bi-house-fill"></i>
                    <textarea asp-for="Address"
                              class="form-control address-control"
                              rows="3"
                              maxlength="250"
                              placeholder="Enter complete address"></textarea>
                </div>

                <div class="field-bottom">
                    <span asp-validation-for="Address"
                          class="field-error">
                    </span>
                    <span class="character-limit">
                        Maximum 250 characters
                    </span>
                </div>

            </div>


            <!-- ==================================================
                 CURRENT STATUS
                 ================================================== -->

            <div class="status-section">

                <div class="status-section-heading">
                    <div class="status-heading-icon">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div>
                        <strong>
                            Participant Status
                        </strong>
                        <span>
                            Current activation status of this record.
                        </span>
                    </div>
                </div>

                <div class="current-status">
                    @if (Model.IsActive)
                    {
                        <span class="large-status active">
                            <i class="bi bi-check-circle-fill"></i>
                            Active Participant
                        </span>
                    }
                    else
                    {
                        <span class="large-status inactive">
                            <i class="bi bi-x-circle-fill"></i>
                            Inactive Participant
                        </span>
                    }
                </div>

            </div>


            <!-- ==================================================
                 AUTO ASSIGNMENT
                 ================================================== -->

            <div class="assignment-info">

                <div class="assignment-icon">
                    <i class="bi bi-magic"></i>
                </div>

                <div>

                    <strong>
                        Automatic Program Assignment
                    </strong>

                    <p>
                        Updating the Barangay may affect which youth
                        programs this participant matches. Matching
                        active programs can create the related
                        Program Registration automatically.
                    </p>

                </div>

            </div>


            <!-- ==================================================
                 ACTIONS
                 ================================================== -->

            <div class="form-actions">

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="cancel-button">

                    <i class="bi bi-x-lg"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="save-button">

                    <i class="bi bi-check-lg"></i>
                    Save Changes

                </button>

            </div>

        </form>

    </div>


    <!-- ==========================================================
         WORKFLOW
         ========================================================== -->

    <div class="workflow-card">

        <div class="workflow-step completed">
            <div class="step-number">
                <i class="bi bi-check-lg"></i>
            </div>
            <span>Participant</span>
        </div>

        <div class="step-line completed-line"></div>

        <div class="workflow-step active">
            <div class="step-number">2</div>
            <span>Update</span>
        </div>

        <div class="step-line"></div>

        <div class="workflow-step">
            <div class="step-number">3</div>
            <span>Programs</span>
        </div>

    </div>

</div>


<style>

/* ==========================================================
   COMPACT FORM PAGE - Matches Admin Dashboard density
   ========================================================== */

.participant-form-page {
    width: 100%;
    padding: 12px 18px 18px;
    box-sizing: border-box;
}


/* ==========================================================
   HEADER
   ========================================================== */

.form-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    margin-bottom: 8px;
    border-radius: 13px;
    background:
        linear-gradient(
            110deg,
            rgba(12,144,150,.25),
            rgba(5,45,46,.82)
        );
    border: 1px solid rgba(183,215,229,.16);
    box-shadow: 0 8px 20px rgba(0,0,0,.14);
    color: #FFFFFF;
}

.form-header-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(255,255,255,.09);
    border: 1px solid rgba(255,255,255,.13);
    color: #69DDF2;
    font-size: 16px;
}

.form-header-content {
    flex: 1;
    min-width: 0;
}

.form-header-kicker {
    display: block;
    margin-bottom: 4px;
    color: #A9D5DE;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

.form-header h1 {
    margin: 0;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
}

.form-header p {
    margin: 3px 0 0;
    color: #C5DDE2;
    font-size: 13px;
    line-height: 1.4;
}

.form-back-button {
    min-height: 30px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 7px;
    border: 1px solid rgba(183,215,229,.16);
    background: rgba(255,255,255,.06);
    color: #C5DDE2;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    transition: .16s ease;
}

.form-back-button:hover {
    color: #FFFFFF;
    background: rgba(255,255,255,.10);
    text-decoration: none;
    transform: translateY(-1px);
}


/* ==========================================================
   PROFILE SUMMARY
   ========================================================== */

.profile-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    margin-bottom: 8px;
    border-radius: 11px;
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        );
    border: 1px solid rgba(183,215,229,.14);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
}

.profile-avatar {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    background: rgba(105,199,232,.15);
    color: #69DDF2;
    font-size: 16px;
    font-weight: 800;
}

.profile-info {
    flex: 1;
    min-width: 0;
}

.profile-info > span {
    display: block;
    margin-bottom: 2px;
    color: #69DDF2;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .8px;
}

.profile-info h2 {
    margin: 0 0 4px;
    overflow: hidden;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.profile-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.profile-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #72969E;
    font-size: 12px;
}

.profile-meta i { color: #69DDF2; }

.profile-status { align-self: flex-start; }


/* ==========================================================
   STATUS BADGES
   ========================================================== */

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.status-badge.active {
    color: #69F0AE;
    background: rgba(43,166,126,.12);
    border: 1px solid rgba(105,240,174,.17);
}

.status-badge.inactive {
    color: #FF7B8A;
    background: rgba(255,123,138,.10);
    border: 1px solid rgba(255,123,138,.15);
}


/* ==========================================================
   VALIDATION
   ========================================================== */

.validation-summary {
    margin-bottom: 8px;
    color: #FF7B8A;
    font-size: 12px;
}
.validation-summary:empty { display: none; }


/* ==========================================================
   FORM CARD
   ========================================================== */

.form-card {
    margin-top: 8px;
    margin-bottom: 8px;
    border-radius: 11px;
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        );
    border: 1px solid rgba(183,215,229,.14);
    box-shadow: 0 6px 16px rgba(0,0,0,.08);
}

.form-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(183,215,229,.12);
}

.form-section-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(105,199,232,.10);
    border: 1px solid rgba(105,199,232,.12);
    color: #69DDF2;
    font-size: 15px;
}

.form-card-header h2 {
    margin: 0 0 1px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.1;
}

.form-card-header p {
    margin: 0;
    color: #769BA3;
    font-size: 12px;
}

.form-card-body { padding: 10px 12px; }


/* ==========================================================
   FORM
   ========================================================== */

.participant-form { padding: 10px 12px; }

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

.form-group { margin-bottom: 10px; }

.form-group label {
    display: block;
    margin-bottom: 4px;
    color: #A9D5DE;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .5px;
}

.form-group label span { color: #FF7B8A; }

.field-wrapper { position: relative; }

.field-wrapper > i {
    position: absolute;
    left: 9px;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    color: #69B8CB;
    pointer-events: none;
    font-size: 14px;
}

.textarea-wrapper > i {
    top: 8px;
    transform: none;
}

.form-control {
    width: 100%;
    min-height: 33px;
    box-sizing: border-box;
    padding: 0 8px 0 28px;
    border: 1px solid rgba(183,215,229,.16);
    border-radius: 7px;
    background: rgba(255,255,255,.055);
    color: #D8EEF2;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 15px;
    outline: none;
    transition: border-color .15s ease, box-shadow .15s ease;
}

.field-wrapper .form-control { padding-left: 28px; }

.form-control:focus {
    border-color: #69C7E8;
    box-shadow: 0 0 0 3px rgba(105,199,232,.15);
}

.address-control {
    min-height: 70px;
    resize: vertical;
    line-height: 1.5;
}

.field-error {
    display: block;
    margin-top: 3px;
    color: #FF7B8A;
    font-size: 12px;
}

.field-help {
    display: block;
    margin-top: 4px;
    color: #72969E;
    font-size: 12px;
    line-height: 1.4;
}
.field-help i { color: #69DDF2; margin-right: 3px; }

.field-bottom {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.character-limit {
    margin-top: 3px;
    color: #72969E;
    font-size: 12px;
    white-space: nowrap;
}


/* ==========================================================
   STATUS SECTION
   ========================================================== */

.status-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px;
    margin-bottom: 10px;
    border: 1px solid rgba(183,215,229,.12);
    border-radius: 8px;
    background: rgba(105,199,232,.05);
}

.status-section-heading {
    display: flex;
    align-items: center;
    gap: 8px;
}

.status-heading-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: rgba(105,199,232,.10);
    color: #69DDF2;
    font-size: 14px;
}

.status-section-heading strong {
    display: block;
    margin-bottom: 1px;
    color: #FFFFFF;
    font-size: 13px;
}

.status-section-heading span {
    display: block;
    color: #769BA3;
    font-size: 12px;
}

.large-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 8px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
}

.large-status.active {
    color: #69F0AE;
    background: rgba(43,166,126,.12);
    border: 1px solid rgba(105,240,174,.17);
}

.large-status.inactive {
    color: #FF7B8A;
    background: rgba(255,123,138,.10);
    border: 1px solid rgba(255,123,138,.15);
}


/* ==========================================================
   ASSIGNMENT INFO
   ========================================================== */

.assignment-info {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 9px 10px;
    margin-bottom: 10px;
    border: 1px solid rgba(105,199,232,.14);
    border-radius: 8px;
    background: rgba(105,199,232,.08);
}

.assignment-icon {
    color: #69DDF2;
    font-size: 14px;
    flex-shrink: 0;
}

.assignment-info strong {
    display: block;
    margin-bottom: 2px;
    color: #FFFFFF;
    font-size: 13px;
}

.assignment-info p {
    margin: 0;
    color: #769BA3;
    font-size: 12px;
    line-height: 1.4;
}


/* ==========================================================
   FORM ACTIONS
   ========================================================== */

.form-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    padding-top: 8px;
    border-top: 1px solid rgba(183,215,229,.12);
}

.cancel-button,
.save-button {
    min-height: 30px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: .16s ease;
    box-sizing: border-box;
}

.cancel-button {
    border: 1px solid rgba(183,215,229,.16);
    background: rgba(255,255,255,.06);
    color: #C5DDE2;
}

.cancel-button:hover {
    border-color: #69DDF2;
    color: #FFFFFF;
    background: rgba(255,255,255,.10);
    text-decoration: none;
    transform: translateY(-1px);
}

.save-button {
    border: 1px solid #0C9096;
    background: #0C9096;
    color: #FFFFFF;
}

.save-button:hover {
    border-color: #0A7D82;
    background: #0A7D82;
    transform: translateY(-1px);
}


/* ==========================================================
   WORKFLOW
   ========================================================== */

.workflow-card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 11px;
    margin-top: 8px;
    border-radius: 9px;
    background:
        linear-gradient(
            90deg,
            rgba(12,144,150,.14),
            rgba(104,157,184,.07)
        );
    border: 1px solid rgba(183,215,229,.12);
}

.workflow-step {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #72969E;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.workflow-step.active { color: #5EF2E6; }

.step-number {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255,255,255,.07);
    color: #69DDF2;
    font-size: 12px;
    font-weight: 800;
}

.workflow-step.completed .step-number {
    color: #69F0AE;
    background: rgba(43,166,126,.12);
}

.workflow-step.active .step-number {
    color: #FFFFFF;
    background: #0C9096;
}

.step-line {
    width: 40px;
    height: 2px;
    margin: 0 6px;
    background: rgba(183,215,229,.12);
}

.completed-line { background: rgba(43,166,126,.20); }


/* ==========================================================
   RESPONSIVE
   ========================================================== */

@@media (max-width: 750px) {
    .participant-form-page { padding: 8px; }
    .form-header { padding: 12px 15px; }
    .form-header h1 { font-size: 19px; }
    .form-header p { font-size: 12px; }
    .form-back-button { display: none; }
    .form-row { grid-template-columns: 1fr; }
    .profile-summary { align-items: flex-start; flex-wrap: wrap; }
    .profile-status { width: 100%; margin-left: 54px; }
    .status-section { align-items: flex-start; flex-direction: column; }
    .current-status { width: 100%; justify-content: center; }
    .form-actions { flex-direction: column-reverse; }
    .cancel-button, .save-button { width: 100%; }
    .workflow-card { justify-content: flex-start; overflow-x: auto; }
}

@@media (max-width: 480px) {
    .form-header { padding: 10px 12px; }
    .form-card-header { padding: 9px 10px; }
    .form-card-body { padding: 9px 10px; }
    .profile-summary { padding: 9px 10px; }
    .profile-info h2 { font-size: 14px; }
}

</style>