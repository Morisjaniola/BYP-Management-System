@model IEnumerable<BYPManagementSystem.Models.YouthNotification>

@{
    ViewData["Title"] = "Notifications";

    var notifications = Model?.ToList()
        ?? new List<BYPManagementSystem.Models.YouthNotification>();

    var unreadCount = notifications.Count(n => !n.IsRead);
}


<div class="notifications-page">

    <!-- ==========================================================
         HEADER
    =========================================================== -->

    <div class="page-header">

        <div class="header-icon">
            <i class="bi bi-bell-fill"></i>
        </div>

        <div class="header-content">

            <span class="header-kicker">
                YOUTH PORTAL
            </span>

            <h1>
                My Notifications
            </h1>

            <p>
                Updates about your program registrations and
                attendance records.
            </p>

        </div>

        @if (unreadCount > 0)
        {
            <form asp-controller="Notifications"
                  asp-action="MarkAllRead"
                  method="post"
                  class="mark-all-form">

                @Html.AntiForgeryToken()

                <button type="submit" class="mark-all-button">
                    <i class="bi bi-check2-all"></i>

                    Mark All as Read
                </button>

            </form>
        }

    </div>


    <!-- ==========================================================
         NOTIFICATIONS
    =========================================================== -->

    <div class="section-card">

        <div class="section-header">

            <div class="section-heading">

                <div class="section-icon">
                    <i class="bi bi-bell"></i>
                </div>

                <div>
                    <h2>
                        Recent Notifications
                    </h2>

                    <p>
                        Newest first.
                    </p>
                </div>

            </div>

            <span class="record-count">

                @unreadCount
                unread

            </span>

        </div>


        @if (notifications.Any())
        {

            <div class="notification-list">

                @foreach (var notification in notifications)
                {

                    <div class="notification-item @(notification.IsRead ? "" : "unread")">

                        <!-- ICON -->

                        <div class="notification-icon @(
                            notification.Type == "Approval" ? "approval" :
                            notification.Type == "Rejection" ? "rejection" :
                            notification.Type == "Attendance" ? "attendance" :
                            notification.Type == "Registration" ? "registration" :
                            "general")">

                            @if (notification.Type == "Approval")
                            {
                                <i class="bi bi-check-circle-fill"></i>
                            }
                            else if (notification.Type == "Rejection")
                            {
                                <i class="bi bi-x-circle-fill"></i>
                            }
                            else if (notification.Type == "Attendance")
                            {
                                <i class="bi bi-clipboard-check-fill"></i>
                            }
                            else if (notification.Type == "Registration")
                            {
                                <i class="bi bi-journal-check"></i>
                            }
                            else
                            {
                                <i class="bi bi-bell-fill"></i>
                            }

                        </div>


                        <!-- CONTENT -->

                        <div class="notification-info">

                            <div class="notification-title-row">

                                <h3>
                                    @notification.Title
                                </h3>

                                <span class="type-badge @(
                                    notification.Type == "Approval" ? "approval" :
                                    notification.Type == "Rejection" ? "rejection" :
                                    notification.Type == "Attendance" ? "attendance" :
                                    notification.Type == "Registration" ? "registration" :
                                    "general")">

                                    @notification.Type

                                </span>

                                @if (!notification.IsRead)
                                {
                                    <span class="unread-dot"
                                          title="Unread"></span>
                                }

                            </div>

                            <p class="notification-message">
                                @notification.Message
                            </p>

                            <span class="notification-time">
                                <i class="bi bi-clock-fill"></i>

                                @notification.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy - hh:mm tt")
                            </span>

                        </div>


                        <!-- ACTION -->

                        <div class="notification-action">

                            @if (!notification.IsRead)
                            {
                                <form asp-controller="Notifications"
                                      asp-action="MarkRead"
                                      asp-route-id="@notification.Id"
                                      method="post"
                                      class="mark-read-form">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="mark-read-button">
                                        <i class="bi bi-check2"></i>

                                        Mark as Read
                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <!-- ==================================================
                 EMPTY STATE
            =================================================== -->

            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-bell-slash"></i>
                </div>

                <h3>
                    No Notifications Yet
                </h3>

                <p>
                    You do not have any notifications yet. Notifications
                    appear here when your registrations are submitted,
                    approved, or updated, and when your attendance is
                    recorded.
                </p>

                <a asp-controller="Programs"
                   asp-action="Index"
                   class="empty-button">

                    <i class="bi bi-calendar-event-fill"></i>

                    Browse Available Programs

                </a>

            </div>

        }

    </div>

</div>


<style>

    /* ==========================================================
       PAGE
    =========================================================== */

    .notifications-page {
        width: 100%;
        padding: 12px 18px 18px;
    }


    /* ==========================================================
       HEADER
       Compact override: theme.css forces 112px / 20px 24px /
       17px radius on .page-header in both themes.
    =========================================================== */

    .page-header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
    }

    /* Header geometry (min-height/padding/gap/radius) is owned
       by the shared .page-header rules in theme.css for both
       themes - this page previously overrode them to 84px. */

    .header-icon {
        position: relative;
        z-index: 2;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 7px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.2);
        font-size: 1rem;
    }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .header-kicker {
        display: block;
        margin-bottom: 1px;
        font-size: .6rem;
        font-weight: 700;
        letter-spacing: .8px;
        opacity: .88;
    }

    .page-header h1 {
        margin: 3px 0 2px;
        font-size: 20px;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        font-size: .6rem;
    }

    .mark-all-form {
        position: relative;
        z-index: 2;
        margin-left: auto;
    }

    .mark-all-button {
        min-height: 28px;
        padding: 0 9px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 1px solid #009FA3;
        border-radius: 7px;
        background: #009FA3;
        color: #fff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: .6rem;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
    }

    .mark-all-button:hover {
        background: #0A7D82;
        border-color: #0A7D82;
        color: #fff;
    }


    /* ==========================================================
       SECTION
    =========================================================== */

    .section-card {
        overflow: hidden;
        margin-bottom: 12px;
        background: white;
        border: 1px solid #e4ebf2;
        border-radius: 8px;
        box-shadow: 0 6px 22px rgba(20,50,90,.04);
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 14px;
        border-bottom: 1px solid #edf1f5;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 7px;
        background: #eef2f7;
        color: #1f2b46;
        font-size: 1.05rem;
    }

    .section-header h2 {
        margin: 0 0 2px;
        color: #202b3c;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .section-header p {
        margin: 0;
        color: #717b8c;
        font-size: .6rem;
    }

    .record-count {
        display: inline-flex;
        align-items: center;
        min-height: 26px;
        padding: 0 8px;
        border-radius: 7px;
        background: #eef2f7;
        color: #1f2b46;
        font-size: .6rem;
        font-weight: 700;
        white-space: nowrap;
    }


    /* ==========================================================
       NOTIFICATION LIST
    =========================================================== */

    .notification-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 10px 12px 12px;
    }

    .notification-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 11px;
        border: 1px solid #e5ebf2;
        border-radius: 8px;
        background: white;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .notification-item.unread {
        border-color: #b9e3e5;
        background: #f4fbfc;
        box-shadow: 0 4px 14px rgba(12,144,150,.06);
    }

    .notification-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 7px;
        background: #eef2f7;
        color: #1f2b46;
        font-size: .98rem;
    }

    .notification-icon.approval { background: #eafaf2; color: #108557; }
    .notification-icon.rejection { background: #fff0f2; color: #d63b50; }
    .notification-icon.attendance { background: #eef2f7; color: #1475f5; }
    .notification-icon.registration { background: #fff4dc; color: #b97700; }
    .notification-icon.general { background: #e6f7f8; color: #0c9096; }

    .notification-info {
        flex: 1;
        min-width: 0;
    }

    .notification-title-row {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 4px;
        flex-wrap: wrap;
    }

    .notification-title-row h3 {
        margin: 0;
        color: #1a2d45;
        font-size: .78rem;
        font-weight: 700;
    }

    .notification-item.unread .notification-title-row h3 {
        color: #0c2f33;
    }

    .type-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 7px;
        border-radius: 7px;
        flex-shrink: 0;
        font-size: .58rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .type-badge.approval { color: #087747; background: #dcf8e9; }
    .type-badge.rejection { color: #c82e46; background: #ffe2e7; }
    .type-badge.attendance { color: #115bc9; background: #e3edff; }
    .type-badge.registration { color: #976600; background: #fff2d1; }
    .type-badge.general { color: #0a7c81; background: #e0f5f6; }

    .unread-dot {
        width: 8px;
        height: 8px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #0c9096;
        box-shadow: 0 0 0 3px rgba(12,144,150,.15);
    }

    .notification-message {
        margin: 0 0 5px;
        color: #5d6b7d;
        font-size: .68rem;
        line-height: 1.4;
    }

    .notification-time {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #93a0b0;
        font-size: .6rem;
    }

    .notification-action {
        min-width: 110px;
        display: flex;
        justify-content: flex-end;
        flex-shrink: 0;
    }

    .mark-read-form {
        margin: 0;
    }

    .mark-read-button {
        min-height: 28px;
        padding: 0 9px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: 1px solid #cfd9e4;
        border-radius: 7px;
        background: #fff;
        color: #3c4c61;
        font-family: Arial, Helvetica, sans-serif;
        font-size: .6rem;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
    }

    .mark-read-button:hover {
        background: #eef7f8;
        border-color: #9fd7da;
        color: #0a7c81;
    }


    /* ==========================================================
       EMPTY STATE
    =========================================================== */

    .empty-state {
        padding: 40px 16px;
        text-align: center;
    }

    .empty-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 8px;
        border-radius: 8px;
        background: #f0f4f8;
        color: #98a6b5;
        font-size: 1.15rem;
    }

    .empty-state h3 {
        margin: 3px 0 2px;
        color: #35485e;
        font-size: 1.05rem;
        font-weight: 700;
    }

    .empty-state p {
        max-width: 340px;
        margin: 5px auto 10px;
        color: #7d8b9c;
        font-size: .65rem;
        line-height: 1.5;
    }

    .empty-button {
        min-height: 32px;
        padding: 0 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 7px;
        background: #1f2b46;
        color: white;
        text-decoration: none;
        font-size: .6rem;
        font-weight: 700;
    }

    .empty-button:hover {
        background: #344054;
        color: white;
        text-decoration: none;
    }


    /* ==========================================================
       LIGHT MODE
       theme.css renders .page-header as a white card; keep the
       kicker an accent and the icons readable.
    =========================================================== */

    html[data-theme="light"] .notifications-page .header-kicker {
        color: #009FA3;
        opacity: 1;
    }


    /* ==========================================================
       DARK MODE
    =========================================================== */

    html[data-theme="dark"] .notifications-page {
        background: transparent;
    }

    html[data-theme="dark"] .notifications-page .header-kicker {
        color: #6CB6B8;
        opacity: 1;
    }

    html[data-theme="dark"] .section-card {
        background: #073F3F;
        border-color: rgba(80,220,220,.18);
        box-shadow: 0 6px 22px rgba(0,0,0,.16);
    }

    html[data-theme="dark"] .section-header {
        border-bottom-color: rgba(80,220,220,.12);
    }

    html[data-theme="dark"] .section-icon {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .section-header h2 {
        color: white;
    }

    html[data-theme="dark"] .section-header p {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .record-count {
        background: #0A4848;
        border-color: rgba(80,220,220,.18);
        color: #A7D2D2;
    }

    html[data-theme="dark"] .notification-list {
        padding: 10px 12px 12px;
    }

    html[data-theme="dark"] .notification-item {
        background: #073F3F;
        border-color: rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .notification-item.unread {
        background: #0A4A4A;
        border-color: rgba(80,220,220,.34);
        box-shadow: 0 4px 14px rgba(0,0,0,.18);
    }

    html[data-theme="dark"] .notification-icon {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .notification-icon.approval {
        background: rgba(45,199,165,.10);
        color: #2DC7A5;
        border-color: rgba(45,199,165,.18);
    }

    html[data-theme="dark"] .notification-icon.rejection {
        background: rgba(241,91,103,.10);
        color: #F56D78;
        border-color: rgba(241,91,103,.18);
    }

    html[data-theme="dark"] .notification-icon.attendance {
        background: rgba(105,199,232,.10);
        color: #8DDCF2;
        border-color: rgba(105,199,232,.18);
    }

    html[data-theme="dark"] .notification-icon.registration {
        background: rgba(241,147,22,.10);
        color: #F1A33C;
        border-color: rgba(241,147,22,.18);
    }

    html[data-theme="dark"] .notification-title-row h3 {
        color: white;
    }

    html[data-theme="dark"] .notification-item.unread .notification-title-row h3 {
        color: #6CECEC;
    }

    html[data-theme="dark"] .type-badge.approval {
        color: #2DC7A5;
        background: rgba(45,199,165,.10);
        border: 1px solid rgba(45,199,165,.18);
    }

    html[data-theme="dark"] .type-badge.rejection {
        color: #F56D78;
        background: rgba(241,91,103,.10);
        border: 1px solid rgba(241,91,103,.18);
    }

    html[data-theme="dark"] .type-badge.attendance {
        color: #8DDCF2;
        background: rgba(105,199,232,.10);
        border: 1px solid rgba(105,199,232,.18);
    }

    html[data-theme="dark"] .type-badge.registration {
        color: #F1A33C;
        background: rgba(241,147,22,.10);
        border: 1px solid rgba(241,147,22,.18);
    }

    html[data-theme="dark"] .type-badge.general {
        color: #6CECEC;
        background: rgba(32,216,216,.10);
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .unread-dot {
        background: #20D8D8;
        box-shadow: 0 0 0 3px rgba(32,216,216,.18);
    }

    html[data-theme="dark"] .notification-message {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .notification-time {
        color: #78A5A5;
    }

    html[data-theme="dark"] .notification-time i {
        color: #6CECEC;
    }

    html[data-theme="dark"] .mark-read-button {
        background: rgba(255,255,255,.06);
        border-color: rgba(80,220,220,.18);
        color: #A7D2D2;
    }

    html[data-theme="dark"] .mark-read-button:hover {
        background: rgba(32,216,216,.12);
        border-color: rgba(80,220,220,.34);
        color: #6CECEC;
    }

    html[data-theme="dark"] .empty-state {
        background: #073F3F;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .empty-icon {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .empty-state h3 {
        color: white;
    }

    html[data-theme="dark"] .empty-state p {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .empty-button {
        background: #20D8D8;
        color: #001F1F;
    }

    html[data-theme="dark"] .empty-button:hover {
        background: #6CECEC;
    }


    /* ==========================================================
       RESPONSIVE
    =========================================================== */

    @@media (max-width: 700px) {
        .notifications-page {
            padding: 8px 8px 18px 8px;
        }

        .page-header {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .mark-all-form {
            width: 100%;
            margin-left: 0;
        }

        .mark-all-button {
            width: 100%;
            justify-content: center;
        }

        .section-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .notification-item {
            flex-wrap: wrap;
        }

        .notification-info {
            width: calc(100% - 42px);
            flex: none;
        }

        .notification-action {
            width: 100%;
            min-width: 0;
            justify-content: flex-start;
            padding-left: 42px;
        }
    }

    @@media (max-width: 480px) {
        .notification-info {
            width: 100%;
        }

        .notification-action {
            padding-left: 0;
        }
    }

</style>
