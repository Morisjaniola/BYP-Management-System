@model BYPManagementSystem.Models.RoleManagementViewModel

@{
    ViewData["Title"] = "Role Management";
}

<div class="roles-page">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="page-header">

        <div class="header-title-content">

            <div class="header-title-row">

                <div class="header-icon">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>

                <div class="roles-title">

                    <span class="page-eyebrow">
                        ROLE MANAGEMENT
                    </span>

                    <h1>
                        Role Management
                    </h1>

                    <p>
                        Manage system roles and role assignments.
                    </p>

                </div>

            </div>

        </div>

        <div class="header-actions">

            <a asp-action="CreateRole"
               class="btn-save">
                <i class="bi bi-plus-lg"></i> Create Role
            </a>

        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =========================================================
         ROLES TABLE
    ========================================================== -->

    <div class="card shadow-sm">

        <div class="card-header py-3">

            <h4 class="fw-bold mb-0">
                Available Roles
            </h4>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>Role</th>

                            <th>Users</th>

                            <th>Type</th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Roles.Any())
                        {
                            <tr>

                                <td colspan="4">

                                    <div class="empty-state">

                                        <i class="bi bi-shield-x"></i>

                                        <h2>
                                            No roles found
                                        </h2>

                                        <p>
                                            System roles are created automatically.
                                            Create a custom role to get started.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var role in Model.Roles)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @role.Name
                                    </td>

                                    <td>
                                        @role.UserCount
                                    </td>

                                    <td>

                                        @if (role.IsSystemRole)
                                        {
                                            <span class="system-badge">
                                                System Role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="custom-badge">
                                                Custom Role
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        @if (!role.IsSystemRole &&
                                            role.UserCount == 0)
                                        {
                                            <form asp-action="DeleteRole"
                                                  asp-route-id="@role.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Delete this role?');">

                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Protected
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <div class="mt-3">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Users

        </a>

    </div>

</div>

<style>

    /* =========================================================
       PAGE CONTAINER (standardized: full width, shared padding)
       ========================================================= */

    .roles-page {
        width: 100%;
        padding: 12px 18px 18px;
        box-sizing: border-box;
    }

    .roles-page .page-eyebrow {
        display: block;
        margin-bottom: 4px;
        color: #B7D7E5;
        font-size: 7px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .roles-page .header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }


    /* =========================================================
       PANEL + TABLE (compact scale to match the module panels)
       ========================================================= */

    .roles-page .card {
        border-radius: 13px;
        overflow: hidden;
    }

    .roles-page .card-header h4 {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--byp-text-secondary);
    }

    .roles-page table {
        font-size: 11px;
        margin-bottom: 0;
    }

    .roles-page table th {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: .5px;
        white-space: nowrap;
    }

    .roles-page table td {
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .roles-page .empty-state {
        min-height: 180px;
        margin-bottom: 0;
        padding: 24px;
    }

    @@media (max-width: 600px) {
        .roles-page { padding: 8px; }
        .roles-page .header-actions { width: 100%; }
        .roles-page .header-actions .btn-save { width: 100%; }
    }

</style>
