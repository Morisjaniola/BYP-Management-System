@model BYPManagementSystem.Controllers.UserManagementController.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}


<div class="reset-password-page">

    <!-- ==========================================================
         HEADER
    =========================================================== -->

    <div class="page-header">

        <div>

            <a asp-controller="UserManagement"
               asp-action="Index"
               class="back-link">

                <i class="bi bi-arrow-left"></i>

                Back to User Management

            </a>

            <span class="page-eyebrow">
                ADMINISTRATION
            </span>

            <h1>
                Reset Password
            </h1>

            <p>
                Create a new password for the selected user account.
            </p>

        </div>

    </div>


    <!-- ==========================================================
         VALIDATION
    =========================================================== -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-box error">

            <div class="alert-icon">

                <i class="bi bi-exclamation-circle-fill"></i>

            </div>

            <div>

                <strong>
                    Password reset failed.
                </strong>

                <div class="validation-list">

                    @foreach (
                        var error in
                        ViewData.ModelState.Values
                            .SelectMany(v => v.Errors)
                    )
                    {
                        if (!string.IsNullOrWhiteSpace(
                            error.ErrorMessage))
                        {
                            <div>
                                @error.ErrorMessage
                            </div>
                        }
                    }

                </div>

            </div>

        </div>
    }


    <!-- ==========================================================
         MAIN CONTENT
    =========================================================== -->

    <div class="reset-layout">


        <!-- ======================================================
             RESET FORM
        ======================================================= -->

        <section class="reset-card">

            <div class="card-header">

                <div class="header-icon">

                    <i class="bi bi-key"></i>

                </div>

                <div>

                    <span>
                        ACCOUNT SECURITY
                    </span>

                    <h2>
                        Set New Password
                    </h2>

                </div>

            </div>


            <form asp-controller="UserManagement"
                  asp-action="ResetPassword"
                  method="post"
                  class="reset-form">

                @Html.AntiForgeryToken()


                <input asp-for="UserId"
                       type="hidden" />


                <!-- ==================================================
                     USER ACCOUNT
                =================================================== -->

                <div class="account-preview">

                    <div class="account-icon">

                        <i class="bi bi-person-circle"></i>

                    </div>


                    <div class="account-info">

                        <span>
                            USER ACCOUNT
                        </span>

                        <strong>
                            @Model.Email
                        </strong>

                        <small>
                            Password will be reset for this account.
                        </small>

                    </div>

                </div>


                <!-- ==================================================
                     NEW PASSWORD
                =================================================== -->

                <div class="form-section">

                    <div class="section-heading">

                        <i class="bi bi-lock"></i>

                        <div>

                            <strong>
                                New Password
                            </strong>

                            <span>
                                Enter and confirm the new account password.
                            </span>

                        </div>

                    </div>


                    <!-- NEW PASSWORD -->

                    <div class="form-group">

                        <label asp-for="NewPassword">
                            New Password
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="NewPassword"
                                   type="password"
                                   id="newPassword"
                                   class="form-control password-input"
                                   placeholder="Enter new password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('newPassword', this)"
                                    aria-label="Show password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="NewPassword"
                              class="field-error">
                        </span>

                        <small>
                            Use at least 6 characters and follow the
                            configured Identity password requirements.
                        </small>

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="form-group">

                        <label asp-for="ConfirmPassword">
                            Confirm New Password
                        </label>

                        <div class="password-wrapper">

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   id="confirmPassword"
                                   class="form-control password-input"
                                   placeholder="Repeat new password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('confirmPassword', this)"
                                    aria-label="Show password">

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="field-error">
                        </span>

                    </div>


                    <!-- PASSWORD MATCH STATUS -->

                    <div id="passwordMatch"
                         class="password-match">

                        <i class="bi bi-info-circle"></i>

                        <span>
                            Enter the password twice to confirm it.
                        </span>

                    </div>

                </div>


                <!-- ==================================================
                     ACTIONS
                =================================================== -->

                <div class="form-actions">

                    <a asp-controller="UserManagement"
                       asp-action="Index"
                       class="cancel-button">

                        <i class="bi bi-x-circle"></i>

                        Cancel

                    </a>


                    <button type="submit"
                            class="save-button">

                        <i class="bi bi-key-fill"></i>

                        Reset Password

                    </button>

                </div>

            </form>

        </section>


        <!-- ======================================================
             SIDE PANEL
        ======================================================= -->

        <aside class="side-panel">


            <!-- SECURITY -->

            <div class="side-card">

                <div class="side-header">

                    <div class="side-icon">

                        <i class="bi bi-shield-lock"></i>

                    </div>

                    <div>

                        <span>
                            SECURITY
                        </span>

                        <h3>
                            Protected Reset
                        </h3>

                    </div>

                </div>


                <p>
                    The password is reset through ASP.NET Core
                    Identity rather than directly modifying the
                    database password fields.
                </p>


                <div class="security-list">

                    <div>

                        <i class="bi bi-check-circle"></i>

                        <span>
                            Only authorized Admin users can access this page.
                        </span>

                    </div>


                    <div>

                        <i class="bi bi-check-circle"></i>

                        <span>
                            Identity validates the new password.
                        </span>

                    </div>


                    <div>

                        <i class="bi bi-check-circle"></i>

                        <span>
                            Password is not stored as readable text.
                        </span>

                    </div>


                    <div>

                        <i class="bi bi-check-circle"></i>

                        <span>
                            Form uses anti-forgery protection.
                        </span>

                    </div>

                </div>

            </div>


            <!-- IMPORTANT -->

            <div class="side-card warning-card">

                <div class="warning-header">

                    <i class="bi bi-exclamation-triangle"></i>

                    <strong>
                        Important
                    </strong>

                </div>

                <p>
                    The new password should be given only to the
                    account owner through a secure method.
                </p>

            </div>


            <!-- ACCOUNT -->

            <div class="side-card">

                <div class="side-header">

                    <div class="side-icon">

                        <i class="bi bi-person"></i>

                    </div>

                    <div>

                        <span>
                            ACCOUNT
                        </span>

                        <h3>
                            Selected User
                        </h3>

                    </div>

                </div>


                <div class="account-row">

                    <span>
                        Email
                    </span>

                    <strong>
                        @Model.Email
                    </strong>

                </div>


                <div class="account-row">

                    <span>
                        User ID
                    </span>

                    <strong class="break-text">
                        @Model.UserId
                    </strong>

                </div>

            </div>


            <!-- WORKFLOW -->

            <div class="side-card workflow-card">

                <div class="side-header">

                    <div class="side-icon">

                        <i class="bi bi-list-check"></i>

                    </div>

                    <div>

                        <span>
                            RESET WORKFLOW
                        </span>

                        <h3>
                            Password Update
                        </h3>

                    </div>

                </div>


                <div class="workflow">

                    <div class="workflow-step">

                        <span>
                            1
                        </span>

                        <strong>
                            Enter new password
                        </strong>

                    </div>


                    <div class="workflow-line"></div>


                    <div class="workflow-step">

                        <span>
                            2
                        </span>

                        <strong>
                            Confirm password
                        </strong>

                    </div>


                    <div class="workflow-line"></div>


                    <div class="workflow-step">

                        <span>
                            3
                        </span>

                        <strong>
                            Submit reset
                        </strong>

                    </div>


                    <div class="workflow-line"></div>


                    <div class="workflow-step">

                        <span>
                            4
                        </span>

                        <strong>
                            Identity updates password
                        </strong>

                    </div>

                </div>

            </div>

        </aside>

    </div>

</div>


<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .reset-password-page {

        width: 100%;

        padding: 12px 18px 18px;

    }


    /* ============================================================
       HEADER
    ============================================================ */

    .page-header {

        margin-bottom: 21px;

    }


    .back-link {

        display: inline-flex;

        align-items: center;

        gap: 6px;

        margin-bottom: 10px;

        color: #6f7a8b;

        text-decoration: none;

        font-size: .68rem;

        font-weight: 700;

    }


    .back-link:hover {

        color: #1f2b46;

        text-decoration: none;

    }


    .page-eyebrow {

        display: block;

        color: #7e8999;

        font-size: .67rem;

        font-weight: 700;

        letter-spacing: .14em;

    }


    .page-header h1 {

        margin: 5px 0 5px;

        color: #202b3c;

        font-size: 2rem;

        font-weight: 800;

    }


    .page-header p {

        margin: 0;

        color: #7b8595;

        font-size: .84rem;

    }


    /* ============================================================
       ALERT
    ============================================================ */

    .alert-box {

        display: flex;

        align-items: flex-start;

        gap: 10px;

        padding: 13px 15px;

        margin-bottom: 17px;

        border-radius: 12px;

    }


    .alert-box.error {

        background: #f8eeee;

        border: 1px solid #efdede;

        color: #945b5b;

    }


    .alert-icon {

        flex-shrink: 0;

    }


    .alert-box strong {

        display: block;

        font-size: .72rem;

    }


    .validation-list {

        margin-top: 5px;

        font-size: .65rem;

        line-height: 1.6;

    }


    /* ============================================================
       LAYOUT
    ============================================================ */

    .reset-layout {

        display: grid;

        grid-template-columns:
            minmax(0, 1.55fr)
            minmax(270px, .8fr);

        gap: 18px;

        align-items: start;

    }


    .reset-card,

    .side-card {

        background: white;

        border: 1px solid #e5e9ef;

        border-radius: 16px;

        box-shadow:
            0 6px 24px
            rgba(31, 43, 70, .035);

    }


    .reset-card {

        overflow: hidden;

    }


    /* ============================================================
       CARD HEADER
    ============================================================ */

    .card-header {

        display: flex;

        align-items: center;

        gap: 12px;

        padding: 18px;

        border-bottom: 1px solid #edf0f4;

    }


    .header-icon {

        width: 42px;

        height: 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 11px;

        background: #eef2f7;

        color: #1f2b46;

    }


    .card-header > div:last-child span {

        display: block;

        color: #8d96a4;

        font-size: .6rem;

        font-weight: 700;

        letter-spacing: .11em;

    }


    .card-header h2 {

        margin: 3px 0 0;

        color: #293446;

        font-size: .98rem;

        font-weight: 800;

    }


    /* ============================================================
       FORM
    ============================================================ */

    .reset-form {

        padding: 20px;

    }


    .account-preview {

        display: flex;

        align-items: center;

        gap: 11px;

        padding: 13px;

        margin-bottom: 20px;

        border-radius: 11px;

        background: #f5f6f8;

        border: 1px solid #edf0f4;

    }


    .account-icon {

        width: 42px;

        height: 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        background: white;

        color: #1f2b46;

        font-size: 1rem;

    }


    .account-info {

        display: flex;

        flex-direction: column;

        min-width: 0;

    }


    .account-info span {

        color: #9099a6;

        font-size: .58rem;

        font-weight: 700;

        letter-spacing: .1em;

    }


    .account-info strong {

        margin-top: 2px;

        color: #374153;

        font-size: .75rem;

        word-break: break-word;

    }


    .account-info small {

        margin-top: 3px;

        color: #929aa7;

        font-size: .59rem;

    }


    /* ============================================================
       FORM SECTION
    ============================================================ */

    .form-section {

        padding-bottom: 20px;

        margin-bottom: 20px;

        border-bottom: 1px solid #edf0f4;

    }


    .section-heading {

        display: flex;

        align-items: flex-start;

        gap: 9px;

        margin-bottom: 15px;

    }


    .section-heading > i {

        margin-top: 2px;

        color: #667386;

        font-size: .8rem;

    }


    .section-heading > div {

        display: flex;

        flex-direction: column;

    }


    .section-heading strong {

        color: #354153;

        font-size: .75rem;

    }


    .section-heading span {

        margin-top: 2px;

        color: #919aa8;

        font-size: .61rem;

    }


    .form-group {

        display: flex;

        flex-direction: column;

        margin-bottom: 15px;

    }


    .form-group:last-child {

        margin-bottom: 0;

    }


    .form-group label {

        margin-bottom: 6px;

        color: #4c5768;

        font-size: .67rem;

        font-weight: 700;

    }


    .form-control {

        width: 100%;

        min-height: 42px;

        padding: 8px 10px;

        border: 1px solid #dfe4ec;

        border-radius: 9px;

        background: white;

        color: #293446;

        font-size: .72rem;

        outline: none;

        box-shadow: none;

    }


    .form-control:focus {

        border-color: #b9c2ce;

        box-shadow:
            0 0 0 3px
            rgba(31, 43, 70, .05);

    }


    .form-group small {

        margin-top: 5px;

        color: #9aa2ae;

        font-size: .59rem;

        line-height: 1.45;

    }


    .field-error {

        margin-top: 4px;

        color: #a05f5f;

        font-size: .6rem;

    }


    /* ============================================================
       PASSWORD
    ============================================================ */

    .password-wrapper {

        position: relative;

    }


    .password-input {

        padding-right: 39px;

    }


    .password-toggle {

        position: absolute;

        top: 50%;

        right: 8px;

        transform: translateY(-50%);

        width: 29px;

        height: 29px;

        display: flex;

        align-items: center;

        justify-content: center;

        border: 0;

        border-radius: 7px;

        background: transparent;

        color: #939ba8;

        cursor: pointer;

    }


    .password-toggle:hover {

        background: #f2f4f7;

        color: #596579;

    }


    /* ============================================================
       PASSWORD MATCH
    ============================================================ */

    .password-match {

        display: flex;

        align-items: center;

        gap: 7px;

        padding: 9px 10px;

        border-radius: 9px;

        background: #f2f4f7;

        color: #7c8796;

        font-size: .61rem;

    }


    .password-match.match {

        background: #edf5ef;

        color: #52735b;

    }


    .password-match.no-match {

        background: #f8eeee;

        color: #985f5f;

    }


    /* ============================================================
       ACTIONS
    ============================================================ */

    .form-actions {

        display: flex;

        align-items: center;

        justify-content: flex-end;

        gap: 9px;

    }


    .cancel-button,

    .save-button {

        min-height: 40px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        gap: 7px;

        padding: 0 14px;

        border-radius: 10px;

        font-size: .7rem;

        font-weight: 700;

        text-decoration: none;

    }


    .cancel-button {

        background: #f2f4f7;

        color: #697386;

    }


    .save-button {

        border: 0;

        background: #1f2b46;

        color: white;

        cursor: pointer;

    }


    .cancel-button:hover {

        color: #344054;

        text-decoration: none;

    }


    .save-button:hover {

        background: #172137;

    }


    /* ============================================================
       SIDE
    ============================================================ */

    .side-panel {

        display: flex;

        flex-direction: column;

        gap: 15px;

    }


    .side-card {

        padding: 17px;

    }


    .side-header {

        display: flex;

        align-items: center;

        gap: 10px;

        margin-bottom: 14px;

    }


    .side-icon {

        width: 38px;

        height: 38px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        background: #eef2f7;

        color: #1f2b46;

    }


    .side-header span {

        display: block;

        color: #9098a5;

        font-size: .58rem;

        font-weight: 700;

        letter-spacing: .1em;

    }


    .side-header h3 {

        margin: 3px 0 0;

        color: #2c3748;

        font-size: .81rem;

        font-weight: 800;

    }


    .side-card > p {

        margin: 0 0 12px;

        color: #818a99;

        font-size: .62rem;

        line-height: 1.55;

    }


    /* ============================================================
       SECURITY
    ============================================================ */

    .security-list {

        display: flex;

        flex-direction: column;

        gap: 9px;

    }


    .security-list > div {

        display: flex;

        align-items: flex-start;

        gap: 7px;

        color: #748091;

        font-size: .6rem;

        line-height: 1.45;

    }


    .security-list i {

        color: #63806c;

        margin-top: 1px;

        flex-shrink: 0;

    }


    /* ============================================================
       ACCOUNT ROW
    ============================================================ */

    .account-row {

        display: flex;

        align-items: flex-start;

        justify-content: space-between;

        gap: 12px;

        padding: 10px 0;

        border-top: 1px solid #f0f2f5;

    }


    .account-row span {

        color: #818b99;

        font-size: .62rem;

    }


    .account-row strong {

        max-width: 155px;

        color: #3f4a5c;

        font-size: .62rem;

        text-align: right;

        word-break: break-word;

    }


    .break-text {

        word-break: break-all;

    }


    /* ============================================================
       WARNING
    ============================================================ */

    .warning-card {

        background: #fbfaf7;

        border-color: #eee8dc;

    }


    .warning-header {

        display: flex;

        align-items: center;

        gap: 7px;

        color: #7d6c4e;

        font-size: .67rem;

    }


    .warning-card p {

        margin: 6px 0 0;

        color: #8b7b60;

        font-size: .6rem;

        line-height: 1.5;

    }


    /* ============================================================
       WORKFLOW
    ============================================================ */

    .workflow {

        display: flex;

        flex-direction: column;

    }


    .workflow-step {

        display: flex;

        align-items: center;

        gap: 9px;

    }


    .workflow-step span {

        width: 25px;

        height: 25px;

        display: flex;

        align-items: center;

        justify-content: center;

        flex-shrink: 0;

        border-radius: 8px;

        background: #eef2f7;

        color: #566377;

        font-size: .61rem;

        font-weight: 800;

    }


    .workflow-step strong {

        color: #566172;

        font-size: .62rem;

    }


    .workflow-line {

        width: 1px;

        height: 12px;

        margin-left: 12px;

        background: #dfe4ec;

    }


    /* ============================================================
       RESPONSIVE
    ============================================================ */

    @@media (max-width: 900px) {

        .reset-layout {

            grid-template-columns: 1fr;

        }

        .side-panel {

            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            align-items: start;

        }

        .workflow-card {

            grid-column: 1 / -1;

        }

    }


    @@media (max-width: 650px) {

        .reset-password-page {

            padding-left: 8px;

            padding-right: 8px;

        }

        .side-panel {

            grid-template-columns: 1fr;

        }

        .workflow-card {

            grid-column: auto;

        }

        .page-header h1 {

            font-size: 1.65rem;

        }

    }

</style>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }


    <script>

        function togglePassword(
            inputId,
            button
        )
        {
            const input =
                document.getElementById(inputId);

            if (!input)
                return;

            const icon =
                button.querySelector("i");

            if (input.type === "password")
            {
                input.type = "text";

                icon.classList.remove(
                    "bi-eye"
                );

                icon.classList.add(
                    "bi-eye-slash"
                );

                button.setAttribute(
                    "aria-label",
                    "Hide password"
                );
            }
            else
            {
                input.type = "password";

                icon.classList.remove(
                    "bi-eye-slash"
                );

                icon.classList.add(
                    "bi-eye"
                );

                button.setAttribute(
                    "aria-label",
                    "Show password"
                );
            }
        }


        const newPassword =
            document.getElementById(
                "newPassword"
            );

        const confirmPassword =
            document.getElementById(
                "confirmPassword"
            );

        const passwordMatch =
            document.getElementById(
                "passwordMatch"
            );


        function checkPasswordMatch()
        {
            if (!newPassword ||
                !confirmPassword ||
                !passwordMatch)
            {
                return;
            }


            const first =
                newPassword.value;

            const second =
                confirmPassword.value;


            if (second.length === 0)
            {
                passwordMatch.className =
                    "password-match";

                passwordMatch.innerHTML =
                    '<i class="bi bi-info-circle"></i>' +
                    '<span>Enter the password twice to confirm it.</span>';

                return;
            }


            if (first === second)
            {
                passwordMatch.className =
                    "password-match match";

                passwordMatch.innerHTML =
                    '<i class="bi bi-check-circle-fill"></i>' +
                    '<span>Passwords match.</span>';
            }
            else
            {
                passwordMatch.className =
                    "password-match no-match";

                passwordMatch.innerHTML =
                    '<i class="bi bi-x-circle-fill"></i>' +
                    '<span>Passwords do not match.</span>';
            }
        }


        if (newPassword)
        {
            newPassword.addEventListener(
                "input",
                checkPasswordMatch
            );
        }


        if (confirmPassword)
        {
            confirmPassword.addEventListener(
                "input",
                checkPasswordMatch
            );
        }

    </script>

}