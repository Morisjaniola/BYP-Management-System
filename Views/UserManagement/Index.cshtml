<script>

    // ============================================================
    // DELETE USER CONFIRMATION
    // Opens the shared confirmation modal and submits the
    // selected row's delete form only after confirmation.
    // ============================================================

    (function () {

        var pendingDeleteForm = null;

        var modalElement =
            document.getElementById('deleteUserModal');

        var nameElement =
            document.getElementById('deleteUserName');

        var confirmButton =
            document.getElementById('confirmDeleteButton');


        document
            .querySelectorAll('.delete-trigger')
            .forEach(function (trigger) {

                trigger.addEventListener('click', function () {

                    pendingDeleteForm =
                        trigger.closest('form');

                    if (nameElement) {

                        nameElement.textContent =
                            trigger.getAttribute('data-email')
                            || 'this user account';

                    }

                });

            });


        if (confirmButton) {

            confirmButton.addEventListener('click', function () {

                if (pendingDeleteForm) {

                    pendingDeleteForm.submit();

                }

            });

        }


        if (modalElement) {

            modalElement.addEventListener(
                'hidden.bs.modal',
                function () {

                    pendingDeleteForm = null;

                }
            );

        }

    })();

</script>



