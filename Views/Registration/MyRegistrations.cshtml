@model IEnumerable<BYPManagementSystem.Models.ProgramRegistration>

@{
    ViewData["Title"] = "My Registrations";

    var registrations = Model?.ToList()
        ?? new List<BYPManagementSystem.Models.ProgramRegistration>();

    var totalRegistrations = registrations.Count;

    var pendingCount = registrations.Count(x =>
        x.Status == "Pending");

    var approvedCount = registrations.Count(x =>
        x.Status == "Approved");

    var rejectedCount = registrations.Count(x =>
        x.Status == "Rejected");

    var participant = registrations
        .Select(x => x.YouthParticipant)
        .FirstOrDefault(x => x != null);

    var participantName =
        participant?.FullName ?? "Youth Participant";

    var barangay =
        participant?.Barangay ?? "Barangay not set";
}

<div class="my-registrations-page">

    <!-- ==========================================================
         HEADER
         ========================================================== -->

    <div class="page-header">

        <div class="header-icon">
            <i class="bi bi-person-check-fill"></i>
        </div>

        <div class="header-content">

            <span class="header-kicker">
                YOUTH PORTAL
            </span>

            <h1>
                My Registrations
            </h1>

            <p>
                View your registered youth programs and registration
                status.
            </p>

        </div>

        <a asp-controller="Programs"
           asp-action="Index"
           class="browse-button">

            <i class="bi bi-calendar-event-fill"></i>

            Browse Programs

        </a>

    </div>


    <!-- ==========================================================
         PARTICIPANT PROFILE
         ========================================================== -->

    <div class="profile-card">

        <div class="profile-avatar">

            @(participant?.FirstName?.Length > 0
                ? participant.FirstName
                    .Substring(0, 1)
                    .ToUpper()
                : "Y")

        </div>

        <div class="profile-info">

            <span>
                REGISTERED YOUTH PARTICIPANT
            </span>

            <h2>
                @participantName
            </h2>

            <div class="profile-meta">

                <span>

                    <i class="bi bi-geo-alt-fill"></i>

                    @barangay

                </span>

                <span>

                    <i class="bi bi-person-check-fill"></i>

                    @totalRegistrations
                    registered program(s)

                </span>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         SUMMARY
         ========================================================== -->

    <div class="summary-grid">

        <!-- TOTAL -->

        <div class="summary-card">

            <div class="summary-info">

                <span>
                    Total Registrations
                </span>

                <strong>
                    @totalRegistrations
                </strong>

            </div>

            <div class="summary-icon blue">

                <i class="bi bi-clipboard-data-fill"></i>

            </div>

        </div>


        <!-- PENDING -->

        <div class="summary-card">

            <div class="summary-info">

                <span>
                    Pending
                </span>

                <strong>
                    @pendingCount
                </strong>

            </div>

            <div class="summary-icon orange">

                <i class="bi bi-hourglass-split"></i>

            </div>

        </div>


        <!-- APPROVED -->

        <div class="summary-card">

            <div class="summary-info">

                <span>
                    Approved
                </span>

                <strong>
                    @approvedCount
                </strong>

            </div>

            <div class="summary-icon green">

                <i class="bi bi-check-circle-fill"></i>

            </div>

        </div>


        <!-- REJECTED -->

        <div class="summary-card">

            <div class="summary-info">

                <span>
                    Rejected
                </span>

                <strong>
                    @rejectedCount
                </strong>

            </div>

            <div class="summary-icon red">

                <i class="bi bi-x-circle-fill"></i>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         SUCCESS / ERROR
         ========================================================== -->

    @if (TempData["Success"] != null)
    {
        <div class="alert-message success">

            <div class="alert-icon">

                <i class="bi bi-check-circle-fill"></i>

            </div>

            <div>

                <strong>
                    Success
                </strong>

                <p>
                    @TempData["Success"]
                </p>

            </div>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-message error">

            <div class="alert-icon">

                <i class="bi bi-exclamation-triangle-fill"></i>

            </div>

            <div>

                <strong>
                    Notice
                </strong>

                <p>
                    @TempData["Error"]
                </p>

            </div>

        </div>
    }


    <!-- ==========================================================
         REGISTRATIONS
         ========================================================== -->

    <div class="section-card">

        <div class="section-header">

            <div class="section-heading">

                <div class="section-icon">

                    <i class="bi bi-journal-check"></i>

                </div>

                <div>

                    <h2>
                        My Program Registrations
                    </h2>

                    <p>
                        Your registration and approval status for each
                        program.
                    </p>

                </div>

            </div>

            <span class="record-count">

                @totalRegistrations
                program(s)

            </span>

        </div>


        @if (registrations.Any())
        {

            <div class="registration-list">

                @foreach (var registration in registrations
                    .OrderByDescending(x => x.RegisteredAt))
                {

                    <div class="registration-card">

                        <!-- ======================================
                             PROGRAM ICON
                             ====================================== -->

                        <div class="program-icon">

                            <i class="bi bi-calendar-event-fill"></i>

                        </div>


                        <!-- ======================================
                             PROGRAM DETAILS
                             ====================================== -->

                        <div class="registration-info">

                            <div class="program-title-row">

                                <h3>

                                    @(registration.Program?.Name
                                        ?? "Unknown Program")

                                </h3>


                                @if (registration.Status == "Pending")
                                {

                                    <span class="status-badge pending">

                                        <i class="bi bi-hourglass-split"></i>

                                        Pending

                                    </span>

                                }
                                else if (registration.Status == "Approved")
                                {

                                    <span class="status-badge approved">

                                        <i class="bi bi-check-circle-fill"></i>

                                        Approved

                                    </span>

                                }
                                else if (registration.Status == "Rejected")
                                {

                                    <span class="status-badge rejected">

                                        <i class="bi bi-x-circle-fill"></i>

                                        Rejected

                                    </span>

                                }
                                else
                                {

                                    <span class="status-badge neutral">

                                        @registration.Status

                                    </span>

                                }

                            </div>


                            <!-- ==================================
                                 PROGRAM META
                                 ================================== -->

                            <div class="program-meta">

                                <span>

                                    <i class="bi bi-clock-fill"></i>

                                    @(registration.Program?.Schedule
                                        ?? "Schedule not set")

                                </span>


                                <span>

                                    <i class="bi bi-geo-alt-fill"></i>

                                    @(registration.Program?.Barangay
                                        ?? registration.YouthParticipant?.Barangay
                                        ?? "Barangay not set")

                                </span>


                                <span>

                                    <i class="bi bi-calendar-plus-fill"></i>

                                    Registered
                                    @(registration.RegisteredAt.ToLocalTime().ToString("MMM dd, yyyy"))

                                </span>

                            </div>


                            <!-- ==================================
                                 REGISTRATION ID
                                 ================================== -->

                            <div class="registration-id">

                                Registration ID:
                                <strong>
                                    #@registration.Id
                                </strong>

                            </div>

                        </div>


                        <!-- ======================================
                             ACTION
                             ====================================== -->

                        <div class="registration-action">

                            @if (registration.Status == "Approved" &&
                                 registration.YouthParticipantId.HasValue)
                            {

                                <a asp-controller="Attendance"
                                   asp-action="MyAttendance"
                                   class="attendance-button">

                                    <i class="bi bi-clipboard-check-fill"></i>

                                    My Attendance

                                </a>

                            }
                            else if (registration.Status == "Pending")
                            {

                                <span class="action-note pending-note">

                                    <i class="bi bi-clock"></i>

                                    Waiting for approval

                                </span>

                            }
                            else if (registration.Status == "Rejected")
                            {

                                <span class="action-note rejected-note">

                                    <i class="bi bi-x-circle"></i>

                                    Registration rejected

                                </span>

                            }

                        </div>

                    </div>

                }

            </div>

        }
        else
        {

            <!-- ==================================================
                 EMPTY STATE
                 ================================================== -->

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-journal-x"></i>

                </div>

                <h3>
                    No Registrations Yet
                </h3>

                <p>
                    You do not have any program registrations yet.
                    Browse the available youth programs and register
                    for a program.
                </p>

                <a asp-controller="Programs"
                   asp-action="Index"
                   class="empty-button">

                    <i class="bi bi-calendar-event-fill"></i>

                    Browse Available Programs

                </a>

            </div>

        }

    </div>


    <!-- ==========================================================
         STATUS GUIDE
         ========================================================== -->

    <div class="guide-card">

        <div class="guide-title">

            <div class="guide-icon">

                <i class="bi bi-info-circle-fill"></i>

            </div>

            <div>

                <strong>
                    Registration Status
                </strong>

                <span>
                    What each status means
                </span>

            </div>

        </div>


        <div class="guide-items">

            <div class="guide-item">

                <span class="guide-status pending">
                    <i class="bi bi-hourglass-split"></i>
                    Pending
                </span>

                <p>
                    Your registration is waiting for processing.
                </p>

            </div>


            <div class="guide-item">

                <span class="guide-status approved">
                    <i class="bi bi-check-circle-fill"></i>
                    Approved
                </span>

                <p>
                    You are approved for the program.
                </p>

            </div>


            <div class="guide-item">

                <span class="guide-status rejected">
                    <i class="bi bi-x-circle-fill"></i>
                    Rejected
                </span>

                <p>
                    Your registration was not approved.
                </p>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         ATTENDANCE INFORMATION
         ========================================================== -->

    <div class="attendance-info">

        <div class="attendance-info-icon">

            <i class="bi bi-clipboard-check-fill"></i>

        </div>

        <div>

            <strong>
                Attendance
            </strong>

            <p>
                Once a registration is approved and attendance is
                recorded, you can view the attendance history through
                the My Attendance page.
            </p>

        </div>

        <a asp-controller="Attendance"
           asp-action="MyAttendance"
           class="view-attendance-link">

            View My Attendance

            <i class="bi bi-arrow-right"></i>

        </a>

    </div>

</div>


<style>

    /* ==========================================================
       PAGE
       ========================================================== */

    .my-registrations-page {
        width: 100%;
        

        

        padding: 12px 18px 18px;

        
    }


    /* ==========================================================
       HEADER
       ========================================================== */

    .page-header {
        position: relative;

        display: flex;
        align-items: center;

        gap: 8px;

        padding: 14px 18px;

        margin-bottom: 12px;

        border-radius: 8px;

        color: white;

        background:
            linear-gradient(
                135deg,
                #1475f5,
                #1555ae
            );

        overflow: hidden;
    }

    

    .header-icon {
        position: relative;

        z-index: 2;

        width: 32px;
        height: 32px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 7px;

        background:
            rgba(255,255,255,.14);

        border:
            1px solid
            rgba(255,255,255,.2);

        font-size: 1rem;
    }

