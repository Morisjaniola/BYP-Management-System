    }

    html[data-theme="dark"] .attendance-info strong {
        color: #6CECEC;
    }

    html[data-theme="dark"] .attendance-info p {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .view-attendance-link {
        color: #6CECEC;
    }

    html[data-theme="dark"] .view-attendance-link:hover {
        color: white;
    }

    html[data-theme="dark"] .alert-message.success {
        background: #0A4848;
        border-color: rgba(45,199,165,.18);
        color: #A7D2D2;
    }

