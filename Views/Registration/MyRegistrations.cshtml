    }

    html[data-theme="dark"] .guide-status.approved {
        color: #2DC7A5;
        background: rgba(45,199,165,.10);
        border: 1px solid rgba(45,199,165,.18);
    }

    html[data-theme="dark"] .guide-status.rejected {
        color: #F56D78;
        background: rgba(241,91,103,.10);
        border: 1px solid rgba(241,91,103,.18);
    }

    html[data-theme="dark"] .guide-item p {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .attendance-info {
        border-color: rgba(80,220,220,.18);
