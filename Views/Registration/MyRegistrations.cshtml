    }

    html[data-theme="dark"] .profile-meta i {
        color: #6CECEC;
    }

    html[data-theme="dark"] .summary-card {
        background: #073F3F;
        border-color: rgba(80,220,220,.18);
        box-shadow: 0 5px 20px rgba(0,0,0,.16);
    }

    html[data-theme="dark"] .summary-info span {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .summary-info strong {
        color: white;
    }

    html[data-theme="dark"] .summary-icon.blue {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .summary-icon.orange {
        background: rgba(241,147,22,.10);
        color: #F1A33C;
        border: 1px solid rgba(241,147,22,.18);
    }

    html[data-theme="dark"] .summary-icon.green {
        background: rgba(45,199,165,.10);
        color: #2DC7A5;
        border: 1px solid rgba(45,199,165,.18);
    }

    html[data-theme="dark"] .summary-icon.red {
        background: rgba(241,91,103,.10);
        color: #F56D78;
        border: 1px solid rgba(241,91,103,.18);
    }

    html[data-theme="dark"] .section-card {
        background: #073F3F;
        border-color: rgba(80,220,220,.18);
        box-shadow: 0 6px 22px rgba(0,0,0,.16);
    }

    html[data-theme="dark"] .section-header {
        border-bottom-color: rgba(80,220,220,.12);
    }

    html[data-theme="dark"] .section-icon {
        background: rgba(32,216,216,.12);
        color: #6CECEC;
        border: 1px solid rgba(80,220,220,.18);
    }

    html[data-theme="dark"] .section-header h2 {
        color: white;
    }

    html[data-theme="dark"] .section-header p {
        color: #A7D2D2;
    }

    html[data-theme="dark"] .record-count {
        background: #0A4848;
        border-color: rgba(80,220,220,.18);
        color: #A7D2D2;
    }

    html[data-theme="dark"] .registration-list {
        padding: 10px 12px 12px;
    }

    html[data-theme="dark"] .registration-card {
        background: #073F3F;
        border-color: rgba(80,220,220,.18);
