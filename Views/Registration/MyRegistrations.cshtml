    }

    /* ============================================================
       HEADER COMPACTION (theme.css forces 112px / 20px 24px / 17px
       radius on .page-header in both themes — restore dashboard
       density: 84px header, 14px 18px padding, 12px spacing)
    ============================================================ */

    /* Header geometry (min-height/padding/gap/radius) is owned
       by the shared .page-header rules in theme.css for both
       themes - this page previously overrode them to 84px. */

    /* Light mode: theme.css renders .page-header as a white card,
       leaving the translucent white browse button invisible */

    html[data-theme="light"] .my-registrations-page .browse-button {
        background: #009FA3;
        border-color: #009FA3;
        color: #fff;
    }

    html[data-theme="light"] .my-registrations-page .browse-button:hover {
        background: #0A7D82;
        border-color: #0A7D82;
        color: #fff;
    }

    /* Light mode: keep the kicker as a teal eyebrow like other pages */

    html[data-theme="light"] .my-registrations-page .header-kicker {
        color: #009FA3;
        opacity: 1;
    }

    .header-content {
        position: relative;

        z-index: 2;
    }

    .header-kicker {
        display: block;

        margin-bottom: 1px;

        font-size: .6rem;

        font-weight: 700;

        letter-spacing: .8px;

        opacity: .88;
    }

    .page-header h1 {
        margin: 3px 0 2px;

        font-size: 20px;

        font-weight: 700;
    }

    .page-header p {
        margin: 0;

        font-size: .6rem;

        
    }


    /* ==========================================================
       BROWSE BUTTON
       ========================================================== */

    .browse-button {
        position: relative;

        z-index: 2;

        margin-left: auto;

        min-height: 26px;

        padding: 0 8px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 7px;

        border:
            1px solid
            rgba(255,255,255,.25);

        border-radius: 7px;

        color: white;

        background:
            rgba(255,255,255,.08);

        text-decoration: none;

        font-size: .6rem;

        font-weight: 700;

        white-space: nowrap;
    }

    .browse-button:hover {
        color: white;

        background:
            rgba(255,255,255,.17);
    }


    /* ==========================================================
       PROFILE
       ========================================================== */

    .profile-card {
        display: flex;

        align-items: center;

        gap: 8px;

        padding: 12px 14px;

        margin-bottom: 12px;

        background: white;

        border:
            1px solid #e4ebf2;

        border-radius: 7px;

        box-shadow:
            0 6px 22px
            rgba(20,50,90,.04);
    }

    .profile-avatar {
        width: 40px;
        height: 40px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 7px;

        background: #eef2f7;

        color: #1f2b46;

        font-size: 1.25rem;

        font-weight: 700;
    }

    .profile-info {
        min-width: 0;
    }

    .profile-info > span {
        display: block;

        margin-bottom: 1px;

        color: #8a98a9;

        font-size: .6rem;

        font-weight: 700;

        letter-spacing: .1em;
    }

    .profile-info h2 {
        margin: 0 0 2px;

        color: #172a41;

        font-size: .98rem;

        font-weight: 700;
    }

    .profile-meta {
        display: flex;

        flex-wrap: wrap;

        gap: 8px;
    }

    .profile-meta span {
        display: inline-flex;

        align-items: center;

