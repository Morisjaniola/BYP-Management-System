@model BYPManagementSystem.ViewModels.RegistrationParticipantViewModel

@{
    ViewData["Title"] = "Youth Participant Details";

    var youth = Model.YouthParticipant;

    var registrations =
        Model.Registrations?
            .OrderByDescending(r => r.RegisteredAt)
            .ToList()
        ?? new List<BYPManagementSystem.Models.ProgramRegistration>();

    var approvedPrograms =
        registrations
            .Where(r => r.Status == "Approved")
            .ToList();

    var pendingPrograms =
        registrations
            .Where(r => r.Status == "Pending")
            .ToList();

    var rejectedPrograms =
        registrations
            .Where(r => r.Status == "Rejected")
            .ToList();

    var firstInitial =
        !string.IsNullOrWhiteSpace(youth.FirstName)
            ? youth.FirstName.Substring(0, 1).ToUpper()
            : "U";

    var lastInitial =
        !string.IsNullOrWhiteSpace(youth.LastName)
            ? youth.LastName.Substring(0, 1).ToUpper()
            : "";

    var isAdminOrStaff =
        User.IsInRole("Admin") || User.IsInRole("Staff");
}


<div class="participant-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <section class="form-header">

        <div class="form-header-icon">
            <i class="bi bi-person-vcard-fill"></i>
        </div>

        <div class="form-header-content">

            <span class="form-header-kicker">
                YOUTH PARTICIPANTS
            </span>

            <h1>
                @youth.FullName
            </h1>

            <p>
                View the youth participant account and assigned programs.
            </p>

        </div>

        @if (isAdminOrStaff)
        {
            <div class="form-header-actions">

                <a asp-controller="YouthParticipants"
                   asp-action="Details"
                   asp-route-id="@youth.Id"
                   class="header-button secondary">

                    <i class="bi bi-person-lines-fill"></i>
                    Full Profile

                </a>


                <a asp-controller="Registration"
                   asp-action="Index"
                   class="header-button primary">

                    <i class="bi bi-list-ul"></i>
                    Registration List

                </a>

            </div>
        }

    </section>


    <!-- =========================================================
         PROFILE / ACCOUNT CARD
         ========================================================= -->

    <div class="profile-summary">

        <div class="profile-avatar">
            @firstInitial@lastInitial
        </div>

        <div class="profile-info">

            <span>
                YOUTH PARTICIPANT
            </span>

            <h2>
                @youth.FullName
            </h2>

            <div class="profile-meta">

                <span>
                    <i class="bi bi-geo-alt-fill"></i>
                    @(string.IsNullOrWhiteSpace(youth.Barangay)
                        ? "Barangay not set"
                        : youth.Barangay)
                </span>

                <span>
                    <i class="bi bi-person-check-fill"></i>
                    @Model.TotalPrograms assigned program@(Model.TotalPrograms == 1 ? "" : "s")
                </span>

            </div>

        </div>


        <div class="profile-status">

            @if (youth.IsActive)
            {
                <span class="status-badge active">
                    <i class="bi bi-check-circle-fill"></i>
                    Active
                </span>
            }
            else
            {
                <span class="status-badge inactive">
                    <i class="bi bi-x-circle-fill"></i>
                    Inactive
                </span>
            }

        </div>

    </div>


    <!-- =========================================================
         ACCOUNT / PARTICIPANT INFORMATION
         ========================================================= -->

    <section class="dashboard-panel">

        <div class="panel-header">

            <div>

                <span class="panel-eyebrow">
                    ACCOUNT INFORMATION
                </span>

                <h2>
                    Personal Details
                </h2>

                <p>
                    Basic information of the youth participant.
                </p>

            </div>

        </div>


        <div class="information-grid">

            <div class="information-card">

                <div class="information-icon account">
                    <i class="bi bi-person-circle"></i>
                </div>

                <div class="information-content">

                    <span>
                        User / Account
                    </span>

                    @if (Model.HasUserAccount &&
                         !string.IsNullOrWhiteSpace(Model.UserEmail))
                    {
                        <strong>
                            @Model.UserEmail
                        </strong>

                        <small class="linked-text">
                            <i class="bi bi-check-circle"></i>
                            Linked account
                        </small>
                    }
                    else
                    {
                        <strong class="no-account">
                            No linked account
                        </strong>

                        <small>
                            Participant record only
                        </small>
                    }

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon phone">
                    <i class="bi bi-telephone"></i>
                </div>

                <div class="information-content">

                    <span>
                        Contact Number
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(youth.ContactNumber)
                            ? "Not provided"
                            : youth.ContactNumber)
                    </strong>

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon location">
                    <i class="bi bi-geo-alt"></i>
                </div>

                <div class="information-content">

                    <span>
                        Barangay
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(youth.Barangay)
                            ? "Not assigned"
                            : youth.Barangay)
                    </strong>

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon date">
                    <i class="bi bi-calendar3"></i>
                </div>

                <div class="information-content">

                    <span>
                        Birth Date
                    </span>

                    <strong>
                        @(youth.BirthDate.HasValue
                            ? youth.BirthDate.Value.ToString("MMM dd, yyyy")
                            : "Not provided")
                    </strong>

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon created">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div class="information-content">

                    <span>
                        Participant Created
                    </span>

                    <strong>
                        @youth.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                    </strong>

                </div>

            </div>


            <div class="information-card">

                <div class="information-icon programs">
                    <i class="bi bi-calendar-event"></i>
                </div>

                <div class="information-content">

                    <span>
                        Assigned Programs
                    </span>

                    <strong>
                        @Model.TotalPrograms
                    </strong>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <section class="summary-grid">

        <div class="summary-card">

            <div class="summary-icon total">
                <i class="bi bi-calendar-event"></i>
            </div>

            <div class="summary-content">

                <span>
                    Total Programs
                </span>

                <strong>
                    @Model.TotalPrograms
                </strong>

                <small>
                    Assigned to this youth
                </small>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon approved">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="summary-content">

                <span>
                    Approved
                </span>

                <strong>
                    @Model.ApprovedPrograms
                </strong>

                <small>
                    Attendance available
                </small>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon pending">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div class="summary-content">

                <span>
                    Pending
                </span>

                <strong>
                    @Model.PendingPrograms
                </strong>

                <small>
                    Awaiting processing
                </small>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon rejected">
                <i class="bi bi-x-circle"></i>
            </div>

            <div class="summary-content">

                <span>
                    Rejected
                </span>

                <strong>
                    @Model.RejectedPrograms
                </strong>

                <small>
                    Rejected registrations
                </small>

            </div>

        </div>

    </section>


    <!-- =========================================================
         ASSIGNED PROGRAMS
         ========================================================= -->

    <section class="dashboard-panel">

        <div class="panel-header">

            <div>

                <span class="panel-eyebrow">
                    PROGRAMS ASSIGNED TO THIS USER
                </span>

                <h2>
                    Programs Assigned to @youth.FullName
                </h2>

                <p>
                    List of programs where this youth participant is registered.
                </p>

            </div>


            <div class="program-count">
                <i class="bi bi-calendar-event"></i>
                @registrations.Count program@(registrations.Count == 1 ? "" : "s")
            </div>

        </div>


        @if (registrations.Any())
        {
            <div class="table-wrapper">

                <table class="program-table">

                    <thead>

                        <tr>

                            <th>
                                PROGRAM
                            </th>

                            <th>
                                REGISTERED
                            </th>

                            <th>
                                STATUS
                            </th>

                            <th>
                                ACTIONS
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var registration in registrations)
                        {
                            var statusClass =
                                registration.Status switch
                                {
                                    "Approved" => "approved",
                                    "Pending" => "pending",
                                    "Rejected" => "rejected",
                                    _ => "neutral"
                                };

                            <tr>

                                <!-- PROGRAM -->

                                <td>

                                    <div class="program-cell">

                                        <div class="program-icon">
                                            <i class="bi bi-calendar-event"></i>
                                        </div>

                                        <div class="program-data">

                                            <strong>
                                                @(registration.Program?.Name ?? "Unknown Program")
                                            </strong>

                                            @if (registration.Program != null)
                                            {
                                                <span>
                                                    <i class="bi bi-clock"></i>
                                                    @registration.Program.Schedule
                                                </span>

                                                <small>
                                                    <i class="bi bi-geo-alt"></i>
                                                    @registration.Program.Barangay
                                                </small>
                                            }

                                        </div>

                                    </div>

                                </td>


                                <!-- REGISTERED -->

                                <td>

                                    <div class="registered-data">
                                        <strong>
                                            @registration.RegisteredAt.ToLocalTime().ToString("MMM dd, yyyy")
                                        </strong>
                                        <span>
                                            @registration.RegisteredAt.ToLocalTime().ToString("hh:mm tt")
                                        </span>
                                    </div>

                                </td>


                                <!-- STATUS -->

                                <td>
                                    <span class="status-badge @statusClass">
                                        @if (registration.Status == "Approved")
                                        {
                                            <i class="bi bi-check-circle"></i>
                                        }
                                        else if (registration.Status == "Pending")
                                        {
                                            <i class="bi bi-hourglass-split"></i>
                                        }
                                        else if (registration.Status == "Rejected")
                                        {
                                            <i class="bi bi-x-circle"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-info-circle"></i>
                                        }
                                        @registration.Status
                                    </span>
                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="action-group">

                                        @if (registration.Status == "Approved" &&
                                             registration.YouthParticipantId.HasValue)
                                        {
                                            <a asp-controller="Registration"
                                               asp-action="Attendance"
                                               asp-route-id="@registration.Id"
                                               class="action-button attendance">

                                                <i class="bi bi-clipboard-check"></i>
                                                View Attendance

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="action-button disabled">
                                                <i class="bi bi-lock"></i>
                                                Attendance unavailable
                                            </span>
                                        }


                                        @if (isAdminOrStaff)
                                        {
                                            <a asp-controller="Programs"
                                               asp-action="Details"
                                               asp-route-id="@registration.ProgramId"
                                               class="action-button details">

                                                <i class="bi bi-eye"></i>
                                                Program

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <i class="bi bi-calendar-x"></i>

                <span>
                    No assigned programs.
                </span>

                <a asp-controller="Programs"
                   asp-action="Index"
                   class="empty-button">

                    <i class="bi bi-calendar-event"></i>
                    View Programs

                </a>

            </div>
        }

    </section>


    <!-- =========================================================
         APPROVAL INFORMATION
         ========================================================= -->

    @if (pendingPrograms.Any() || rejectedPrograms.Any())
    {
        <section class="dashboard-panel">

            <div class="notice-content">

                <div class="notice-icon">
                    <i class="bi bi-info-circle"></i>
                </div>

                <div>

                    <strong>
                        Registration Status
                    </strong>

                    @if (pendingPrograms.Any())
                    {
                        <p>
                            <strong>@pendingPrograms.Count pending registration@(pendingPrograms.Count == 1 ? "" : "s")</strong>
                            are still awaiting processing.
                        </p>
                    }

                    @if (rejectedPrograms.Any())
                    {
                        <p>
                            <strong>@rejectedPrograms.Count rejected registration@(rejectedPrograms.Count == 1 ? "" : "s")</strong>
                            cannot be used for attendance.
                        </p>
                    }

                </div>

            </div>

        </section>
    }


    <!-- =========================================================
         WORKFLOW
         ========================================================= -->

    <section class="workflow-panel">

        <div class="workflow-step">

            <div class="workflow-number">
                1
            </div>

            <div>

                <strong>
                    Youth Participant
                </strong>

                <span>
                    @youth.FullName
                </span>

            </div>

        </div>


        <div class="workflow-arrow">
            <i class="bi bi-arrow-right"></i>
        </div>


        <div class="workflow-step">

            <div class="workflow-number">
                2
            </div>

            <div>

                <strong>
                    Assigned Program
                </strong>

                <span>
                    Registration status
                </span>

            </div>

        </div>


        <div class="workflow-arrow">
            <i class="bi bi-arrow-right"></i>
        </div>


        <div class="workflow-step">

            <div class="workflow-number">
                3
            </div>

            <div>

                <strong>
                    Attendance
                </strong>

                <span>
                    Approved programs only
                </span>

            </div>

        </div>

    </section>


    <!-- =========================================================
         BOTTOM ACTIONS
         ========================================================= -->

    <div class="bottom-actions">

        <a asp-controller="Registration"
           asp-action="Index"
           class="bottom-button secondary">

            <i class="bi bi-arrow-left"></i>
            Back to Registration

        </a>


        <a asp-controller="YouthParticipants"
           asp-action="Details"
           asp-route-id="@youth.Id"
           class="bottom-button primary">

            <i class="bi bi-person"></i>
            Open Participant Profile

        </a>

    </div>

</div>


<style>

/* =========================================================
   COMPACT PARTICIPANT PAGE - Matches Admin Dashboard density
   ========================================================= */

.participant-page {
    width: 100%;
    padding: 12px 18px 18px;
    box-sizing: border-box;
}


/* =========================================================
   HEADER
   ========================================================= */

.form-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    margin-bottom: 8px;
    border-radius: 13px;
    background:
        linear-gradient(
            110deg,
            rgba(12,144,150,.25),
            rgba(5,45,46,.82)
        );
    border: 1px solid rgba(183,215,229,.16);
    box-shadow: 0 8px 20px rgba(0,0,0,.14);
    color: #FFFFFF;
}

.form-header-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: rgba(255,255,255,.09);
    border: 1px solid rgba(255,255,255,.13);
    color: #69DDF2;
    font-size: 16px;
}

.form-header-content {
    flex: 1;
    min-width: 0;
}

.form-header-kicker {
    display: block;
    margin-bottom: 4px;
    color: #A9D5DE;
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 1px.
}

.form-header h1 {
    margin: 0;
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
}

.form-header p {
    margin: 3px 0 0;
    color: #C5DDE2;
    font-size: 8px;
    line-height: 1.4.
}

.form-header-actions {
    display: flex;
    align-items: center;
    gap: 7px.
    flex-wrap: wrap.
}

.header-button {
    min-height: 30px.
    padding: 0 10px.
    display: inline-flex.
    align-items: center.
    justify-content: center.
    gap: 5px.
    border-radius: 7px.
    font-size: 7px.
    font-weight: 700.
    text-decoration: none.
    transition: .16s ease.
}

.header-button.secondary {
    border: 1px solid rgba(183,215,229,.16).
    background: rgba(255,255,255,.06).
    color: #C5DDE2.
}

.header-button.primary {
    border: 1px solid #0C9096.
    background: #0C9096.
    color: #FFFFFF.
}

.header-button:hover {
    filter: brightness(.98);
}


/* =========================================================
   PROFILE SUMMARY
   ========================================================= */

.profile-summary {
    display: flex.
    align-items: center.
    gap: 12px.
    padding: 10px 12px.
    margin-bottom: 8px.
    border-radius: 11px.
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        ).
    border: 1px solid rgba(183,215,229,.14).
    box-shadow: 0 6px 16px rgba(0,0,0,.08).
}

.profile-avatar {
    width: 42px.
    height: 42px.
    flex-shrink: 0.
    display: flex.
    align-items: center.
    justify-content: center.
    border-radius: 9px.
    background: rgba(105,199,232,.15).
    color: #69DDF2.
    font-size: 15px.
    font-weight: 800.
}

.profile-info {
    flex: 1.
    min-width: 0.
}

.profile-info > span {
    display: block.
    margin-bottom: 2px.
    color: #69DDF2.
    font-size: 6px.
    font-weight: 700.
    letter-spacing: .8px.
}

.profile-info h2 {
    margin: 0 0 4px.
    overflow: hidden.
    color: #FFFFFF.
    font-size: 14px.
    font-weight: 700.
    text-overflow: ellipsis.
    white-space: nowrap.
}

.profile-meta {
    display: flex.
    flex-wrap: wrap.
    gap: 8px.
}

.profile-meta span {
    display: inline-flex.
    align-items: center.
    gap: 4px.
    color: #72969E.
    font-size: 6px.
}

.profile-meta i { color: #69DDF2; }

.profile-status { align-self: flex-start; }


/* =========================================================
   STATUS BADGES
   ========================================================= */

.status-badge {
    display: inline-flex.
    align-items: center.
    gap: 4px.
    padding: 5px 8px.
    border-radius: 999px.
    font-size: 6px.
    font-weight: 700.
    white-space: nowrap.
}

.status-badge.active {
    color: #69F0AE.
    background: rgba(43,166,126,.12).
    border: 1px solid rgba(105,240,174,.17).
}

.status-badge.inactive {
    color: #FF7B8A.
    background: rgba(255,123,138,.10).
    border: 1px solid rgba(255,123,138,.15).
}

.status-badge.pending {
    color: #FFD166.
    background: rgba(255,209,102,.12).
    border: 1px solid rgba(255,209,102,.18).
}

.status-badge.rejected {
    color: #FF7B8A.
    background: rgba(255,123,138,.12).
    border: 1px solid rgba(255,123,138,.18).
}

.status-badge.neutral {
    color: #8DDCF2.
    background: rgba(105,199,232,.12).
    border: 1px solid rgba(105,199,232,.15).
}


/* =========================================================
   PANEL
   ========================================================= */

.dashboard-panel {
    padding: 10px.
    border-radius: 11px.
    background:
        linear-gradient(
            135deg,
            rgba(5,45,46,.82),
            rgba(3,23,22,.94)
        ).
    border: 1px solid rgba(183,215,229,.14).
    box-shadow: 0 6px 16px rgba(0,0,0,.08).
}

.dashboard-panel + .dashboard-panel { margin-top: 8px; }

.panel-header {
    min-height: 34px.
    display: flex.
    align-items: center.
    justify-content: space-between.
    gap: 8px.
    margin-bottom: 8px.
}

.panel-eyebrow {
    display: block.
    color: #69DDF2.
    font-size: 6px.
    font-weight: 700.
    letter-spacing: .8px.
}

.panel-header h2 {
    margin: 2px 0 1px.
    color: #FFFFFF.
    font-size: 12px.
    line-height: 1.1.
}

.panel-header p {
    margin: 0.
    color: #769BA3.
    font-size: 7px.
}

.panel-icon-box {
    width: 30px.
    height: 30px.
    display: flex.
    align-items: center.
    justify-content: center.
    border-radius: 7px.
    color: #69DDF2.
    background: rgba(105,199,232,.09).
    border: 1px solid rgba(105,199,232,.12).
}

.panel-link {
    display: inline-flex.
    align-items: center.
    gap: 4px.
    color: #8DDCF2.
    font-size: 7px.
    font-weight: 700.
    text-decoration: none.
}

.panel-link:hover { color: #FFFFFF; text-decoration: none; }


/* =========================================================
   INFORMATION GRID
   ========================================================= */

.information-grid {
    display: grid.
    grid-template-columns: repeat(3, 1fr).
    gap: 8px.
    margin-top: 8px.
}

.information-card {
    min-height: 64px.
    padding: 9px 10px.
    display: flex.
    align-items: center.
    gap: 8px.
    border-radius: 9px.
    background: rgba(255,255,255,.035).
    border: 1px solid rgba(183,215,229,.10).
}

.information-icon {
    width: 32px.
    height: 32px.
    flex-shrink: 0.
    display: flex.
    align-items: center.
    justify-content: center.
    border-radius: 7px.
    background: rgba(255,255,255,.06).
    font-size: 11px.
}

.information-icon.account { color: #69DDF2; }
.information-icon.phone { color: #69F0AE; }
.information-icon.location { color: #FFD166; }
.information-icon.date { color: #8DDCF2; }
.information-icon.created { color: #B9BFFF; }
.information-icon.programs { color: #69DDF2; }

.information-content span {
    display: block.
    color: #9FC6CC.
    font-size: 6px.
    font-weight: 600.
}

.information-content strong {
    display: block.
    margin-top: 1px.
    color: #FFFFFF.
    font-size: 14px.
    line-height: 1.2.
}

.information-content small {
    display: block.
    margin-top: 2px.
    color: #72969E.
    font-size: 6px.
}

.information-content small.linked-text {
    color: #69F0AE;
}

.information-content small.linked-text i { margin-right: 3px; }


/* =========================================================
   SUMMARY GRID
   ========================================================= */

.summary-grid {
    margin-top: 8px.
    display: grid.
    grid-template-columns: repeat(4, 1fr).
    gap: 8px.
}

.summary-card {
    min-height: 64px.
    padding: 10px 11px.
    display: flex.
    align-items: center.
    gap: 8px.
