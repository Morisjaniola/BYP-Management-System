@model BYPManagementSystem.Models.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}


<div class="error-page">

    <div class="error-card">

        <!-- =====================================================
             ERROR ICON
        ====================================================== -->

        <div class="error-icon">

            <i class="bi bi-exclamation-triangle-fill"></i>

        </div>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <span class="error-label">
            SYSTEM ERROR
        </span>


        <h1>
            Something went wrong.
        </h1>


        <p class="error-message">
            The system could not complete your request.
            Please try again later.
        </p>


        <!-- =====================================================
             REFERENCE ID
        ====================================================== -->

        @if (Model.ShowRequestId)
        {
            <div class="reference-box">

                <div class="reference-icon">

                    <i class="bi bi-hash"></i>

                </div>


                <div class="reference-content">

                    <span>
                        REFERENCE ID
                    </span>


                    <code>
                        @Model.RequestId
                    </code>

                </div>

            </div>


            <p class="reference-note">
                Use this reference ID when reporting the problem
                to the system administrator.
            </p>
        }


        <!-- =====================================================
             ACTIONS
        ====================================================== -->

        <div class="error-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="error-button primary">

                <i class="bi bi-house"></i>

                Return to Home

            </a>


            <button type="button"
                    class="error-button secondary"
                    onclick="window.location.reload();">

                <i class="bi bi-arrow-clockwise"></i>

                Try Again

            </button>

        </div>


        <!-- =====================================================
             SECURITY MESSAGE
        ====================================================== -->

        <div class="security-note">

            <i class="bi bi-shield-check"></i>

            <span>
                Technical error details are hidden for security.
            </span>

        </div>

    </div>

</div>


<style>

    /* =========================================================
       PAGE
    ========================================================== */

    .error-page {

        min-height:
            calc(100vh - 30px);

        padding:
            35px 18px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        background:
            #f7f9fc;

    }


    /* =========================================================
       CARD
    ========================================================== */

    .error-card {

        width:
            100%;

        max-width:
            470px;

        padding:
            32px;

        border:
            1px solid #e3e8ef;

        border-radius:
            16px;

        background:
            #ffffff;

        text-align:
            center;

        box-shadow:
            0 18px 45px
            rgba(15, 23, 42, .08);

    }


    /* =========================================================
       ICON
    ========================================================== */

    .error-icon {

        width:
            68px;

        height:
            68px;

        margin:
            0 auto 15px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        border-radius:
            18px;

        background:
            #fff7ed;

        color:
            #ea580c;

        font-size:
            1.35rem;

    }


    /* =========================================================
       HEADER
    ========================================================== */

    .error-label {

        display:
            block;

        color:
            #ea580c;

        font-size:
            .52rem;

        font-weight:
            850;

        letter-spacing:
            .11em;

    }


    .error-card h1 {

        margin:
            5px 0 8px;

        color:
            #1f2937;

        font-size:
            1.4rem;

        font-weight:
            850;

        letter-spacing:
            -.3px;

    }


    .error-message {

        max-width:
            370px;

        margin:
            0 auto;

        color:
            #64748b;

        font-size:
            .59rem;

        line-height:
            1.6;

    }


    /* =========================================================
       REFERENCE
    ========================================================== */

    .reference-box {

        margin:
            20px 0 8px;

        padding:
            11px;

        display:
            flex;

        align-items:
            center;

        gap:
            9px;

        border:
            1px solid #e2e8f0;

        border-radius:
            9px;

        background:
            #f8fafc;

        text-align:
            left;

    }


    .reference-icon {

        width:
            34px;

        height:
            34px;

        flex-shrink:
            0;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        border-radius:
            8px;

        background:
            #eff6ff;

        color:
            #2563eb;

        font-size:
            .65rem;

    }


    .reference-content {

        min-width:
            0;

        flex: 1;

    }


    .reference-content span {

        display:
            block;

        color:
            #94a3b8;

        font-size:
            .43rem;

        font-weight:
            800;

        letter-spacing:
            .06em;

    }


    .reference-content code {

        display:
            block;

        margin-top:
            3px;

        overflow:
            hidden;

        color:
            #475569;

        font-family:
            Consolas,
            Monaco,
            monospace;

        font-size:
            .5rem;

        font-weight:
            700;

        text-overflow:
            ellipsis;

        white-space:
            nowrap;

    }


    .reference-note {

        margin:
            0;

        color:
            #94a3b8;

        font-size:
            .46rem;

        line-height:
            1.45;

    }


    /* =========================================================
       ACTIONS
    ========================================================== */

    .error-actions {

        margin-top:
            20px;

        display:
            flex;

        gap:
            7px;

    }


    .error-button {

        flex:
            1;

        min-height:
            40px;

        padding:
            0 10px;

        display:
            inline-flex;

        align-items:
            center;

        justify-content:
            center;

        gap:
            5px;

        border-radius:
            8px;

        font-family:
            inherit;

        font-size:
            .54rem;

        font-weight:
            800;

        text-decoration:
            none;

        cursor:
            pointer;

    }


    .error-button.primary {

        border:
            1px solid #0d6efd;

        background:
            #0d6efd;

        color:
            #ffffff;

    }


    .error-button.primary:hover {

        background:
            #0b5ed7;

        color:
            #ffffff;

    }


    .error-button.secondary {

        border:
            1px solid #dfe6ee;

        background:
            #ffffff;

        color:
            #64748b;

    }


    .error-button.secondary:hover {

        background:
            #f8fafc;

        color:
            #0d6efd;

    }


    /* =========================================================
       SECURITY NOTE
    ========================================================== */

    .security-note {

        margin-top:
            18px;

        padding:
            9px 10px;

        display:
            flex;

        align-items:
            center;

        justify-content:
            center;

        gap:
            6px;

        border:
            1px solid #e2e8f0;

        border-radius:
            8px;

        background:
            #f8fafc;

        color:
            #94a3b8;

        font-size:
            .46rem;

        text-align:
            center;

    }


    .security-note i {

        color:
            #16a34a;

        font-size:
            .6rem;

    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @@media (max-width: 500px) {

        .error-page {

            padding:
                20px 12px;

        }


        .error-card {

            padding:
                25px 18px;

            border-radius:
                13px;

        }


        .error-actions {

            flex-direction:
                column;

        }


        .error-button {

            width:
                100%;

        }

    }

</style>